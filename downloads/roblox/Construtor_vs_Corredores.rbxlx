					<string name="Name">Config</string>
					<ProtectedString name="Source">--!strict
local function freeze(t: any): any
 for _,v in pairs(t) do if type(v)==&quot;table&quot; then freeze(v) end end
 return table.freeze(t)
end
return freeze({
 GAME_NAME=&quot;Construtor vs Corredores&quot;, MIN_PLAYERS=2, MAX_PLAYERS=16,
 TIMES={WAITING=0,INTERMISSION=15,PREPARING=8,RUNNING=150,ENDING=10,RESET=3},FINISH_GRACE=10,
 ENERGY={MAX=100,REGEN=6,HELPER_MAX=30,HELPER_REGEN=2,PLACE_COOLDOWN=.35,SURGE_INTERVAL=40,SURGE_DURATION=5,SURGE_MULTIPLIER=3,UNDO_WINDOW=2,UNDO_REFUND=.5},
 PIECES={MAX_ACTIVE=120,LIFETIME=25,GRID=4,WARNING_TIME=1.5,MAX_EPIC_ACTIVE=1,EPIC_COOLDOWN=6},
 RUNNER={LIVES=3,WALKSPEED=16,JUMPPOWER=50,DASH_COOLDOWN=8,DASH_FORCE=60,INVULN_TIME=2},
 ARENA={ORIGIN=Vector3.new(0,50,0),WIDTH=40,LENGTH=240,CHECKPOINTS_Z={60,120,180},KILL_Y=-10,FORBIDDEN_RADIUS=12,MAX_BLOCK_RATIO=.7},
 LOBBY={ORIGIN=Vector3.new(0,50,-250)},BUILDER_CABIN=Vector3.new(0,130,120),
 SCORE={PLACE={100,70,50},PLACE_DEFAULT=30,SURVIVE_PER_5S=1,BUILDER_PER_ELIM=10,BUILDER_ELIM_MAX=80,BUILDER_WIN=60,BUILDER_COMBO=20,HELPER_ELIM=5,COINS_FACTOR=.5},
 THEMES={&quot;NeonCidade&quot;,&quot;Deserto&quot;,&quot;Gelo&quot;,&quot;Lava&quot;,&quot;Espaco&quot;},
 THEME_DATA={
 NeonCidade={floor=Color3.fromRGB(179,188,197),neon=Color3.fromRGB(40,114,232),sky=Color3.fromRGB(155,187,220),fog=Color3.fromRGB(192,220,245),ClockTime=14,Brightness=2,special=&quot;Neon intenso&quot;},
 Deserto={floor=Color3.fromRGB(218,174,99),neon=Color3.fromRGB(255,200,61),sky=Color3.fromRGB(255,210,155),fog=Color3.fromRGB(222,178,133),ClockTime=15,Brightness=3,special=&quot;Tons quentes&quot;},
 Gelo={floor=Color3.fromRGB(184,225,255),neon=Color3.fromRGB(89,171,255),sky=Color3.fromRGB(199,226,255),fog=Color3.fromRGB(177,207,232),ClockTime=12,Brightness=2,special=&quot;Baixa friccao&quot;},
 Lava={floor=Color3.fromRGB(65,35,42),neon=Color3.fromRGB(255,113,45),sky=Color3.fromRGB(120,51,53),fog=Color3.fromRGB(98,42,43),ClockTime=19,Brightness=2,special=&quot;Brilho laranja&quot;},
 Espaco={floor=Color3.fromRGB(30,24,65),neon=Color3.fromRGB(180,105,255),sky=Color3.fromRGB(24,20,52),fog=Color3.fromRGB(37,26,65),ClockTime=0,Brightness=1,special=&quot;Estrelas e planetas&quot;}},
 ANIM_IDS={Win=&quot;rbxassetid://0&quot;,Lose=&quot;rbxassetid://0&quot;,Dash=&quot;rbxassetid://0&quot;,Scare=&quot;rbxassetid://0&quot;,BuilderCheer=&quot;rbxassetid://0&quot;,Emote1=&quot;rbxassetid://0&quot;,Emote2=&quot;rbxassetid://0&quot;,Emote3=&quot;rbxassetid://0&quot;,Emote4=&quot;rbxassetid://0&quot;}, -- COLOQUE AQUI
 EMOTES={{id=&quot;Emote1&quot;,nome=&quot;Acenar&quot;,icone=&quot;Oi!&quot;},{id=&quot;Emote2&quot;,nome=&quot;Dancar&quot;,icone=&quot;\u{266a}&quot;},{id=&quot;Emote3&quot;,nome=&quot;Comemorar&quot;,icone=&quot;!&quot;},{id=&quot;Emote4&quot;,nome=&quot;Rir&quot;,icone=&quot;:D&quot;}},
 -- Ajustes tecnicos centralizados.
 DATA={AUTOSAVE=60,RANK_INTERVAL=120,RETRIES=5,SESSION_TTL=180},
 BUILD={HEIGHT_STEP=4,HEIGHT_LEVELS=3,REQUESTS_PER_SECOND=8,SEND_INTERVAL=.2},
 COLORS={BACKGROUND=Color3.fromRGB(16,26,42),PURPLE=Color3.fromRGB(116,80,213),CYAN=Color3.fromRGB(39,224,255),GOLD=Color3.fromRGB(255,200,61),DANGER=Color3.fromRGB(255,77,109),SUCCESS=Color3.fromRGB(61,220,132),TEXT=Color3.fromRGB(242,244,255)}
})
</ProtectedString>
