local Art={}
function Art.spawn(id,cf,parent)
 local defs=assets[id] assert(defs,&quot;Modelo ausente: &quot;..id)
 local model=Instance.new(&quot;Model&quot;) model.Name=id
 local _,yaw=cf:ToOrientation()
 for i,d in ipairs(defs) do
  local p=Instance.new(&quot;Part&quot;) p.Name=d.name
  p.Anchored=true p.CanCollide=false p.CanTouch=false p.CanQuery=false
  p.Material=d.glow and Enum.Material.Neon or Enum.Material.Plastic
  p.Color=Color3.fromRGB(d.color[1],d.color[2],d.color[3])
  p.Size=Vector3.new(d.size[1],d.size[2],d.size[3])
  local world=cf*CFrame.new(d.pos[1],d.pos[2],d.pos[3])
  p.Position=world.Position
  p.Orientation=Vector3.new(d.rot[1],d.rot[2]+math.deg(yaw),d.rot[3])
  if d.shape==&quot;Cylinder&quot; then
   p.Shape=Enum.PartType.Cylinder p.Size=Vector3.new(d.size[2],d.size[1],d.size[3])
   p.Orientation=Vector3.new(d.rot[1],d.rot[2]+math.deg(yaw),d.rot[3]+90)
  elseif d.shape==&quot;Ball&quot; then p.Shape=Enum.PartType.Ball end
  p.TopSurface=d.stud and Enum.SurfaceType.Studs or Enum.SurfaceType.Smooth
  p.BottomSurface=d.stud and Enum.SurfaceType.Inlet or Enum.SurfaceType.Smooth
  p.Transparency=d.alpha or 0 p.Parent=model
  if i==1 then model.PrimaryPart=p end
 end
 model.Parent=parent return model
end
function Art.has(id) return assets[id]~=nil end
return Art
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000282">
				<Properties>
					<string name="Name">PassCatalog</string>
					<ProtectedString name="Source">-- Crie os passes na experiencia publicada e coloque os IDs reais aqui.
return {
 {key=&quot;VIP&quot;,id=0,name=&quot;Clube VIP&quot;,description=&quot;Titulo VIP dourado e rastro dourado. Beneficio cosmetico.&quot;,attribute=&quot;PassVIP&quot;},
 {key=&quot;Neon&quot;,id=0,name=&quot;Rastro Neon&quot;,description=&quot;Rastro ciano e roxo exclusivo. Beneficio cosmetico.&quot;,attribute=&quot;PassNeon&quot;}
}
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000283">
				<Properties>
					<string name="Name">PieceCatalog</string>
					<ProtectedString name="Source">local C=require(script.Parent.Config)
local rows={
 {&quot;Plataforma&quot;,5,8,1,8,&quot;Basica&quot;,true,&quot;Ponte segura&quot;},
 {&quot;PlataformaPeq&quot;,4,4,1,4,&quot;Basica&quot;,true,&quot;Salto preciso&quot;},
 {&quot;DegrauFalso&quot;,6,8,1,8,&quot;Basica&quot;,true,&quot;Degrau falso&quot;},
 {&quot;ParedeBaixa&quot;,7,8,4,1,&quot;Basica&quot;,true,&quot;Barreira para saltar&quot;},
 {&quot;PlataformaMovel&quot;,12,8,1,8,&quot;Movimento&quot;,false,&quot;Plataforma movel&quot;},
 {&quot;PlataformaGiratoria&quot;,14,12,1,12,&quot;Movimento&quot;,false,&quot;Plataforma giratoria&quot;},
 {&quot;Esteira&quot;,10,8,1,12,&quot;Movimento&quot;,false,&quot;Esteira&quot;},
 {&quot;Serra&quot;,18,4,4,12,&quot;Perigo&quot;,false,&quot;Serra&quot;,true},
 {&quot;Espinhos&quot;,12,8,1,8,&quot;Perigo&quot;,false,&quot;Espinhos&quot;},
 {&quot;EspinhosEscondidos&quot;,16,8,1,8,&quot;Perigo&quot;,false,&quot;Espinhos ocultos&quot;},
 {&quot;Laser&quot;,20,12,4,2,&quot;Perigo&quot;,false,&quot;Laser&quot;,false,true},
 {&quot;Pendulo&quot;,22,4,8,4,&quot;Perigo&quot;,false,&quot;Pendulo&quot;},
 {&quot;MarteloEmpurrao&quot;,15,8,4,4,&quot;Perigo&quot;,false,&quot;Martelo de empurrao&quot;},
 {&quot;BombaRelogio&quot;,25,4,4,4,&quot;Perigo&quot;,false,&quot;Bomba relogio&quot;,true},
 {&quot;Lava&quot;,14,8,1,8,&quot;Perigo&quot;,false,&quot;Lava&quot;},
 {&quot;Trampolim&quot;,10,8,1,8,&quot;Troll&quot;,true,&quot;Trampolim&quot;},
 {&quot;Ventilador&quot;,13,4,4,4,&quot;Troll&quot;,false,&quot;Ventilador&quot;},
 {&quot;PortalTroll&quot;,24,4,6,4,&quot;Troll&quot;,false,&quot;Portal troll&quot;,true},
 {&quot;BlocoEscorregadio&quot;,8,8,1,8,&quot;Troll&quot;,true,&quot;Bloco de gelo&quot;},
 {&quot;ParedeFantasma&quot;,9,8,6,1,&quot;Troll&quot;,false,&quot;Parede fantasma&quot;},
 {&quot;CheckpointFalso&quot;,20,8,1,8,&quot;Troll&quot;,false,&quot;Checkpoint falso&quot;}}
local colors={Basica=C.COLORS.CYAN,Movimento=C.COLORS.GOLD,Perigo=C.COLORS.DANGER,Troll=C.COLORS.PURPLE}
local list,byId={},{}
for _,r in ipairs(rows) do
 local d={id=r[1],custo=r[2],tamanho=Vector3.new(r[3],r[4],r[5]),categoria=r[6],helper=r[7],nome=r[8],descricao=r[8],epic=r[9] or false,warning=r[10] or false,cooldown=C.ENERGY.PLACE_COOLDOWN,cor=colors[r[6]],material=Enum.Material.SmoothPlastic,vidaUtil=C.PIECES.LIFETIME,height=true,icone=string.sub(r[8],1,2),dica=&quot;R gira \u{b7} Z desfaz \u{b7} Expira em 25s&quot;}
 table.freeze(d) table.insert(list,d) byId[d.id]=d
end
local P={}
function P.get(id) return byId[id] end
function P.list() return table.clone(list) end
function P.listForRole(role) local out={} for _,d in ipairs(list) do if role==&quot;Builder&quot; or (role==&quot;Helper&quot; and d.helper) then table.insert(out,d) end end return out end
function P.byCategory(cat) local out={} for _,d in ipairs(list) do if d.categoria==cat then table.insert(out,d) end end return out end
return P
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000284">
				<Properties>
					<string name="Name">Settings</string>
					<ProtectedString name="Source">local U=require(script.Parent.Util)
local S={}
S.DEFAULTS={
 audio={master=80,music=60,sfx=80,ui=70,muteMusicInRound=false,dangerAlert=true},
 graphics={quality=&quot;Alta&quot;,shadows=true,bloom=true,dof=true,sunrays=true,particles=&quot;Completas&quot;,motionBlur=false,effectDistance=200,showFps=false,fpsCap=60},
 controls={sensitivity=50,fov=70,invertY=false,builderCamSpeed=50,touchButtonSize=100,touchSide=&quot;Direita&quot;,keybinds={Dash=&quot;Q&quot;,Emote=&quot;G&quot;,Rotate=&quot;R&quot;,Undo=&quot;Z&quot;}},
 accessibility={reduceShake=false,reduceFlashes=false,colorblind=&quot;Normal&quot;,textSize=&quot;M&quot;,highContrast=false,captions=false},
 game={showNames=true,showTips=true,killfeed=true,language=&quot;pt&quot;}}
S.RANGES={audio={},graphics={quality={&quot;Baixa&quot;,&quot;Media&quot;,&quot;Alta&quot;},particles={&quot;Desligadas&quot;,&quot;Reduzidas&quot;,&quot;Completas&quot;},effectDistance={25,500},fpsCap={30,60,120,144,240}},controls={sensitivity={0,100},fov={50,100},builderCamSpeed={10,100},touchButtonSize={70,150},touchSide={&quot;Direita&quot;,&quot;Esquerda&quot;},keybinds={Dash={&quot;Q&quot;,&quot;E&quot;,&quot;F&quot;,&quot;LeftShift&quot;},Emote={&quot;G&quot;,&quot;H&quot;,&quot;T&quot;},Rotate={&quot;R&quot;,&quot;T&quot;,&quot;E&quot;},Undo={&quot;Z&quot;,&quot;X&quot;,&quot;U&quot;}}},accessibility={colorblind={&quot;Normal&quot;,&quot;Protanopia&quot;,&quot;Deuteranopia&quot;,&quot;Tritanopia&quot;},textSize={&quot;P&quot;,&quot;M&quot;,&quot;G&quot;}},game={language={&quot;pt&quot;,&quot;en&quot;}}}
for _,key in ipairs({&quot;master&quot;,&quot;music&quot;,&quot;sfx&quot;,&quot;ui&quot;}) do S.RANGES.audio[key]={0,100} end
local function clean(defaults,incoming,ranges)
 local out={} incoming=type(incoming)==&quot;table&quot; and incoming or {}
 for k,d in pairs(defaults) do
  local v=incoming[k] local r=ranges and ranges[k]
  if type(d)==&quot;table&quot; then out[k]=clean(d,v,r)
  elseif type(d)==&quot;boolean&quot; then if type(v)==&quot;boolean&quot; then out[k]=v else out[k]=d end
  elseif type(d)==&quot;number&quot; then
   if type(v)~=&quot;number&quot; or v~=v or math.abs(v)==math.huge then v=d end
   if k==&quot;fpsCap&quot; then out[k]=table.find(r,v) and v or d else out[k]=math.clamp(v,r[1],r[2]) end
  else out[k]=(type(v)==&quot;string&quot; and r and table.find(r,v)) and v or d end
 end return out
end
function S.validate(incoming) return clean(S.DEFAULTS,incoming,S.RANGES) end
S.TEXT={pt={audio=&quot;Audio&quot;,graphics=&quot;Graficos&quot;,controls=&quot;Controles&quot;,accessibility=&quot;Acessibilidade&quot;,game=&quot;Jogo&quot;,save=&quot;Salvar&quot;,close=&quot;Fechar&quot;},en={audio=&quot;Audio&quot;,graphics=&quot;Graphics&quot;,controls=&quot;Controls&quot;,accessibility=&quot;Accessibility&quot;,game=&quot;Game&quot;,save=&quot;Save&quot;,close=&quot;Close&quot;}}
local labels={master={&quot;Volume geral&quot;,&quot;Master volume&quot;},music={&quot;Musica&quot;,&quot;Music&quot;},sfx={&quot;Efeitos sonoros&quot;,&quot;Sound effects&quot;},ui={&quot;Interface&quot;,&quot;Interface&quot;},muteMusicInRound={&quot;Silenciar na rodada&quot;,&quot;Mute in round&quot;},dangerAlert={&quot;Alerta de perigo&quot;,&quot;Danger alert&quot;},quality={&quot;Qualidade&quot;,&quot;Quality&quot;},shadows={&quot;Sombras&quot;,&quot;Shadows&quot;},bloom={&quot;Brilho&quot;,&quot;Bloom&quot;},dof={&quot;Profundidade de campo&quot;,&quot;Depth of field&quot;},sunrays={&quot;Raios solares&quot;,&quot;Sun rays&quot;},particles={&quot;Particulas&quot;,&quot;Particles&quot;},motionBlur={&quot;Desfoque de movimento&quot;,&quot;Motion blur&quot;},effectDistance={&quot;Distancia de efeitos&quot;,&quot;Effect distance&quot;},showFps={&quot;Mostrar FPS&quot;,&quot;Show FPS&quot;},fpsCap={&quot;Limite de FPS desejado&quot;,&quot;Preferred FPS cap&quot;},sensitivity={&quot;Sensibilidade&quot;,&quot;Sensitivity&quot;},fov={&quot;Campo de visao&quot;,&quot;Field of view&quot;},invertY={&quot;Inverter Y&quot;,&quot;Invert Y&quot;},builderCamSpeed={&quot;Velocidade da camera&quot;,&quot;Camera speed&quot;},touchButtonSize={&quot;Tamanho dos botoes&quot;,&quot;Button size&quot;},touchSide={&quot;Lado dos botoes&quot;,&quot;Button side&quot;},keybinds={&quot;Teclas&quot;,&quot;Keybinds&quot;},reduceShake={&quot;Reduzir tremor&quot;,&quot;Reduce shake&quot;},reduceFlashes={&quot;Reduzir flashes&quot;,&quot;Reduce flashes&quot;},colorblind={&quot;Daltonismo&quot;,&quot;Colorblind mode&quot;},textSize={&quot;Tamanho do texto&quot;,&quot;Text size&quot;},highContrast={&quot;Alto contraste&quot;,&quot;High contrast&quot;},captions={&quot;Legendas&quot;,&quot;Captions&quot;},showNames={&quot;Mostrar nomes&quot;,&quot;Show names&quot;},showTips={&quot;Mostrar dicas&quot;,&quot;Show tips&quot;},killfeed={&quot;Registro de eliminacoes&quot;,&quot;Elimination feed&quot;},language={&quot;Idioma&quot;,&quot;Language&quot;}}
for k,v in pairs(labels) do S.TEXT.pt[k]=v[1] S.TEXT.en[k]=v[2] end
-- Teste: validate({audio={master=999},alien=true}).audio.master == 100
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000285">
				<Properties>
					<string name="Name">SoundBank</string>
					<ProtectedString name="Source">-- IDs reservados; COLOQUE AQUI seus audios autorizados.
local B={MUSIC={},SFX={},UI={}}
for _,k in ipairs({&quot;lobby&quot;,&quot;preparing&quot;,&quot;running&quot;,&quot;lastSeconds&quot;,&quot;victory&quot;}) do B.MUSIC[k]=&quot;rbxassetid://0&quot; end
for _,k in ipairs({&quot;place&quot;,&quot;error&quot;,&quot;saw&quot;,&quot;laser&quot;,&quot;bounce&quot;,&quot;explosion&quot;,&quot;checkpoint&quot;,&quot;finish&quot;,&quot;countdown&quot;}) do B.SFX[k]=&quot;rbxassetid://0&quot; end
for _,k in ipairs({&quot;click&quot;,&quot;hover&quot;,&quot;toast&quot;}) do B.UI[k]=&quot;rbxassetid://0&quot; end
function B.volumeOf(key) return B.MUSIC[key] and .35 or .65 end
return B
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000286">
				<Properties>
					<string name="Name">Types</string>
					<ProtectedString name="Source">--!strict
export type Role=&quot;Lobby&quot;|&quot;Builder&quot;|&quot;Runner&quot;|&quot;Helper&quot;|&quot;Spectator&quot;
export type State=&quot;WAITING&quot;|&quot;INTERMISSION&quot;|&quot;PREPARING&quot;|&quot;RUNNING&quot;|&quot;ENDING&quot;|&quot;RESET&quot;
export type PieceDef={id:string,nome:string,descricao:string,categoria:string,custo:number,cooldown:number,tamanho:Vector3,cor:Color3,material:Enum.Material,vidaUtil:number?,helper:boolean,epic:boolean,warning:boolean,height:boolean,icone:string,dica:string}
export type RoundStateData={state:State,timeLeft:number,round:number,builderUserId:number?,theme:string}
export type SettingsData={audio:{[string]:any},graphics:{[string]:any},controls:{[string]:any},accessibility:{[string]:any},game:{[string]:any}}
export type PlayerData={version:number,coins:number,xp:number,level:number,stats:{[string]:number},settings:SettingsData,owned:{[string]:any},equipped:{[string]:any},tutorialDone:boolean}
export type PlaceRequest={pieceId:string,cf:CFrame}
export type RoundResultData={winner:string,podium:{{userId:number,place:number,points:number}},mvpUserId:number?,rewards:{coins:number,xp:number},stats:{eliminations:number}}
return {}
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000287">
				<Properties>
					<string name="Name">Util</string>
					<ProtectedString name="Source">local TweenService=game:GetService(&quot;TweenService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local U={}
function U.snapToGrid(pos,grid) return Vector3.new(math.round(pos.X/grid)*grid,math.round(pos.Y/grid)*grid,math.round(pos.Z/grid)*grid) end
function U.clamp(n,low,high) return math.clamp(n,low,high) end
function U.round(n,decimals) local f=10^(decimals or 0) return math.round(n*f)/f end
function U.formatTime(seconds) seconds=math.max(0,math.ceil(seconds)) return string.format(&quot;%d:%02d&quot;,math.floor(seconds/60),seconds%60) end
function U.weldParts(a,b) local w=Instance.new(&quot;WeldConstraint&quot;) w.Part0=a w.Part1=b w.Parent=a return w end
function U.makePart(props)
 local p=Instance.new(&quot;Part&quot;) p.Anchored=true p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth
 for k,v in pairs(props) do if k~=&quot;Parent&quot; then p[k]=v end end
 p.Parent=props.Parent return p
end
function U.tween(obj,info,goal) local t=TweenService:Create(obj,info,goal) t:Play() return t end
function U.getCharacterRoot(player) return player.Character and player.Character:FindFirstChild(&quot;HumanoidRootPart&quot;) end
function U.shuffle(list) local r=table.clone(list) for i=#r,2,-1 do local j=math.random(i) r[i],r[j]=r[j],r[i] end return r end
function U.weightedPick(list,weightFn)
 local total=0 for _,v in ipairs(list) do total+=math.max(0,weightFn(v)) end
 local pick=math.random()*total for _,v in ipairs(list) do pick-=math.max(0,weightFn(v)) if pick&lt;=0 then return v end end return list[#list]
end
function U.deepCopy(t) if type(t)~=&quot;table&quot; then return t end local r={} for k,v in pairs(t) do r[k]=U.deepCopy(v) end return r end
function U.rateLimiter(maxPerSecond)
 local windows=setmetatable({},{__mode=&quot;k&quot;})
 Players.PlayerRemoving:Connect(function(p) windows[p]=nil end)
 return function(p)
  local now=os.clock() local w=windows[p] or {} windows[p]=w
  while w[1] and now-w[1]&gt;=1 do table.remove(w,1) end
  if #w&gt;=maxPerSecond then return false end table.insert(w,now) return true
 end
end
function U.createSound(parent,id,props) local s=Instance.new(&quot;Sound&quot;) s.SoundId=id for k,v in pairs(props or {}) do s[k]=v end s.Parent=parent return s end
function U.playEmitter(emitter,count) if emitter and emitter:IsA(&quot;ParticleEmitter&quot;) then emitter:Emit(count) end end
return U
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000288">
				<Properties>
					<string name="Name">WorldContent</string>
					<ProtectedString name="Source">local C=require(script.Parent.Config)
local Art=require(script.Parent.ModelArt)
local W={}
local function block(parent,name,size,pos,color,collide)
 local p=Instance.new(&quot;Part&quot;) p.Name=name p.Size=size p.Position=pos p.Color=color p.Anchored=true p.CanCollide=collide==true p.CanTouch=false p.CanQuery=collide==true p.Material=Enum.Material.Plastic p.TopSurface=Enum.SurfaceType.Studs p.BottomSurface=Enum.SurfaceType.Inlet p.Parent=parent return p
end
function W.build(theme)
 local arena=workspace.Arena local o=C.ARENA.ORIGIN local parent=Instance.new(&quot;Model&quot;) parent.Name=&quot;Mapa_&quot;..theme parent.Parent=arena
 local data=C.THEME_DATA[theme]
 -- Caminho inicial permite terminar a pista sem depender de pontes do construtor.
 for z=16,224,8 do
  local protected=false for _,cp in ipairs(C.ARENA.CHECKPOINTS_Z) do if math.abs(z-cp)&lt;10 then protected=true end end
  if not protected then
   local x=0
   if theme==&quot;Deserto&quot; then x=math.sin(z/30)*8 elseif theme==&quot;Gelo&quot; then x=math.sin(z/21)*10 elseif theme==&quot;Lava&quot; then x=z%32&lt;16 and -6 or 6 elseif theme==&quot;Espaco&quot; then x=math.sin(z/38)*12 end
   local path=block(parent,&quot;Trilha&quot;,Vector3.new(theme==&quot;Lava&quot; and 14 or 10,1,8),o+Vector3.new(x,-.5,z),data.floor,true)
   if theme==&quot;Gelo&quot; then path.Material=Enum.Material.Ice path.CustomPhysicalProperties=PhysicalProperties.new(.7,.12,.1) end
  end
 end
 for side=-1,1,2 do
  for i=1,6 do
   local x=side*(62+i%2*12) local z=i*37-12 local p=o+Vector3.new(x,-6,z)
   if theme==&quot;NeonCidade&quot; then
    local h=20+(i%3)*12 block(parent,&quot;Predio&quot;,Vector3.new(16,h,16),p+Vector3.new(0,h/2,0),Color3.fromRGB(53,74,109))
    for y=5,h-2,7 do for dx=-4,4,8 do block(parent,&quot;Janela&quot;,Vector3.new(3,3,.2),p+Vector3.new(dx,y,-8.2),Color3.fromRGB(255,215,105)) end end
    block(parent,&quot;Antena&quot;,Vector3.new(1,8,1),p+Vector3.new(0,h+4,0),data.neon)
   elseif theme==&quot;Deserto&quot; then
    for j=1,4 do block(parent,&quot;Piramide&quot;,Vector3.new(26-j*4,4,26-j*4),p+Vector3.new(0,j*4,0),Color3.fromRGB(218,174,99)) end
    block(parent,&quot;Cacto&quot;,Vector3.new(3,12,3),p+Vector3.new(12,6,0),Color3.fromRGB(67,131,75))
    block(parent,&quot;Braco cacto&quot;,Vector3.new(9,2,2),p+Vector3.new(12,8,0),Color3.fromRGB(67,131,75))
   elseif theme==&quot;Gelo&quot; then
    block(parent,&quot;Torre gelo&quot;,Vector3.new(10,28,10),p+Vector3.new(0,14,0),Color3.fromRGB(180,225,255))
    for dx=-4,4,4 do block(parent,&quot;Ameia&quot;,Vector3.new(2,4,10),p+Vector3.new(dx,30,0),Color3.fromRGB(210,240,255)) end
    Art.spawn(&quot;Pinheiro&quot;,CFrame.new(p+Vector3.new(13,0,0)),parent)
   elseif theme==&quot;Lava&quot; then
    for j=1,4 do block(parent,&quot;Vulcao&quot;,Vector3.new(30-j*5,5,30-j*5),p+Vector3.new(0,j*5,0),Color3.fromRGB(64,51,57)) end
    local lava=block(parent,&quot;Cratera&quot;,Vector3.new(10,1,10),p+Vector3.new(0,20.6,0),Color3.fromRGB(255,125,32)) lava.Material=Enum.Material.Neon
    local fire=Instance.new(&quot;ParticleEmitter&quot;) fire.Rate=3 fire.Lifetime=NumberRange.new(1,3) fire.Speed=NumberRange.new(2,5) fire.Color=ColorSequence.new(data.neon) fire.Size=NumberSequence.new(.3) fire.Parent=lava
   else
    local planet=block(parent,&quot;Planeta&quot;,Vector3.new(18,18,18),p+Vector3.new(0,20,0),i%2==0 and data.neon or Color3.fromRGB(85,152,206)) planet.Shape=Enum.PartType.Ball
    block(parent,&quot;Estacao orbital&quot;,Vector3.new(26,2,12),p+Vector3.new(0,5,0),Color3.fromRGB(162,177,198))
    for dx=-9,9,18 do block(parent,&quot;Painel solar&quot;,Vector3.new(10,.5,18),p+Vector3.new(dx,7,0),Color3.fromRGB(49,91,171)) end
   end
  end
 end
end
function W.lobby()
 local o=C.LOBBY.ORIGIN local m=Instance.new(&quot;Model&quot;) m.Name=&quot;Treino&quot; m.Parent=workspace.Lobby
 -- Percurso lateral acessivel, sem premiacao repetivel.
 block(m,&quot;Passarela treino&quot;,Vector3.new(12,2,18),o+Vector3.new(27,-1,-36),Color3.fromRGB(95,183,76),true)
 for i=1,8 do block(m,&quot;Salto treino&quot;,Vector3.new(6,1,6),o+Vector3.new(27+(i%2)*3,math.min(i,4)*.7,-45-i*7),Color3.fromRGB(40,114,232),true) end
 block(m,&quot;Fim do treino&quot;,Vector3.new(14,2,14),o+Vector3.new(28,1.8,-108),Color3.fromRGB(255,200,47),true)
 local save=Instance.new(&quot;Part&quot;) save.Name=&quot;Seguranca treino&quot; save.Size=Vector3.new(36,1,108) save.Position=o+Vector3.new(27,-8,-65) save.Anchored=true save.Transparency=.25 save.Color=Color3.fromRGB(95,183,76) save.TopSurface=Enum.SurfaceType.Studs save.Parent=m
 for i=1,4 do block(m,&quot;Escada de retorno&quot;,Vector3.new(7,1,7),o+Vector3.new(13,-8+i*2,-64+i*7),Color3.fromRGB(95,183,76),true) end
 local marker=block(m,&quot;Retorno&quot;,Vector3.new(2,4,2),o+Vector3.new(32,5,-108),Color3.fromRGB(255,200,47),false)
 local prompt=Instance.new(&quot;ProximityPrompt&quot;) prompt.ActionText=&quot;Voltar ao lobby&quot; prompt.ObjectText=&quot;Treino concluido&quot; prompt.HoldDuration=.25 prompt.MaxActivationDistance=12 prompt.RequiresLineOfSight=false prompt.Parent=marker
 prompt.Triggered:Connect(function(p)
  local root=p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;) local role=p:GetAttribute(&quot;Role&quot;)
  if root and (role==&quot;Lobby&quot; or role==&quot;Spectator&quot;) and (root.Position-marker.Position).Magnitude&lt;16 then p.Character:PivotTo(CFrame.new(o+Vector3.new(0,5,-5))) end
 end)
end
return W
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX00000276">
			<Properties>
				<string name="Name">Remotes</string>
			</Properties>
