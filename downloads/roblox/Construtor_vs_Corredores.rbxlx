			<Item class="ModuleScript" referent="RBX000001ED">
				<Properties>
					<string name="Name">RoundService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Data=require(script.Parent.DataService)
local Score=require(script.Parent.ScoreService)
local Map=require(script.Parent.MapService)
local Runner=require(script.Parent.RunnerService)
local Builder=require(script.Parent.BuilderService)
local R=RS.Remotes
local S={onStateChanged=Instance.new(&quot;BindableEvent&quot;)}
S.onStateChanged.Name=&quot;StateChanged&quot; S.onStateChanged.Parent=script
local state=&quot;WAITING&quot; local timeLeft=0 local round=0 local builder=nil local participants={} local previous=nil local theme=&quot;NeonCidade&quot; local grace=nil
local function packet() return {state=state,timeLeft=timeLeft,round=round,builderUserId=builder and builder.UserId,theme=theme} end
local function emit() R.RoundState:FireAllClients(packet()) end
local function setState(value,seconds) state=value timeLeft=seconds or 0 emit() S.onStateChanged:Fire(value) end
local function role(p,value) if p.Parent then p:SetAttribute(&quot;Role&quot;,value) R.RoleAssigned:FireClient(p,value) end end
local function teleport(p,cf) if p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;) then p.Character:PivotTo(cf) end end
local function present()
 local list={} for _,p in ipairs(participants) do if p.Parent==Players then table.insert(list,p) end end return list
end
local function eligible()
 local list={} for _,p in ipairs(Players:GetPlayers()) do
  local h=p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if #list&lt;C.MAX_PLAYERS and h and h.Health&gt;0 then table.insert(list,p) end
 end return list
end
local function cancelled() return not builder or builder.Parent~=Players or #present()&lt;C.MIN_PLAYERS end
local function reset()
 Builder.endRound() Runner.endRound() Map.resetArena() grace=nil
 for _,p in ipairs(Players:GetPlayers()) do
  role(p,&quot;Lobby&quot;) p:SetAttribute(&quot;InRound&quot;,false) p:SetAttribute(&quot;Lives&quot;,0) p:SetAttribute(&quot;Energy&quot;,0) p:SetAttribute(&quot;MaxEnergy&quot;,0)
  if p.Character then
   local root=U.getCharacterRoot(p) if root then root.Anchored=false end
   for _,v in ipairs(p.Character:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) and v.Name~=&quot;HumanoidRootPart&quot; then v.Transparency=0 end end
   local h=p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) if h then h.WalkSpeed=C.RUNNER.WALKSPEED h.UseJumpPower=true h.JumpPower=C.RUNNER.JUMPPOWER end
  end teleport(p,Map.getLobbySpawn())
 end
 participants={} builder=nil
end
function S.getState() return state end
function S.getBuilder() return builder end
function S.getParticipants() return present() end
function S.getTimeLeft() return timeLeft end
local function cycle()
 setState(&quot;WAITING&quot;,0)
 while #eligible()&lt;C.MIN_PLAYERS do emit() task.wait(1) end
 local candidates=eligible()
 if #candidates&gt;=3 and previous then local filtered={} for _,p in ipairs(candidates) do if p.UserId~=previous then table.insert(filtered,p) end end candidates=filtered end
 builder=U.weightedPick(candidates,function(p) local d=Data.get(p) return 1/(1+(d and d.stats.timesBuilder or 0)) end)
 setState(&quot;INTERMISSION&quot;,C.TIMES.INTERMISSION)
 for t=C.TIMES.INTERMISSION,1,-1 do
  timeLeft=t emit() if #eligible()&lt;C.MIN_PLAYERS or not builder.Parent then return end task.wait(1)
 end
 participants=eligible() if not table.find(participants,builder) then return end round+=1 previous=builder.UserId
 theme=Map.randomTheme(theme) Map.resetArena() Map.setTheme(theme)
 local runners={} local slots=Map.getSpawnCFrames(#participants)
 for _,p in ipairs(participants) do
  p:SetAttribute(&quot;InRound&quot;,true)
  if p==builder then role(p,&quot;Builder&quot;) teleport(p,Map.getBuilderCabinCFrame()) local root=U.getCharacterRoot(p) if root then root.Anchored=true end
  else role(p,&quot;Runner&quot;) table.insert(runners,p) teleport(p,slots[#runners]) end
 end
 Score.startRound(participants) Runner.startRound(runners)
 setState(&quot;PREPARING&quot;,C.TIMES.PREPARING)
 for t=C.TIMES.PREPARING,1,-1 do timeLeft=t emit() if cancelled() then return end if t&lt;=3 then R.Toast:FireAllClients(tostring(t),&quot;info&quot;) end task.wait(1) end
 setState(&quot;RUNNING&quot;,C.TIMES.RUNNING) grace=nil Builder.startRound(builder)
 for _,p in ipairs(runners) do Runner.freeze(p,false) end R.Toast:FireAllClients(&quot;GO! O construtor pode colocar plataformas.&quot;,&quot;good&quot;)
 local deadline=os.clock()+C.TIMES.RUNNING local nextSurvival=os.clock()+5 local winner=&quot;Builder&quot;
 while true do
  if cancelled() then R.Toast:FireAllClients(&quot;Rodada cancelada: faltam participantes.&quot;,&quot;warn&quot;) return end
  local now=os.clock()
  if Runner.getFinishCount()&gt;0 and not grace then grace=now+C.FINISH_GRACE end
  if grace then winner=&quot;Runners&quot; end
  if (grace and now&gt;=grace) or now&gt;=deadline or #Runner.getAlive()==0 then break end
  timeLeft=math.ceil((grace and math.min(grace,deadline) or deadline)-now) emit()
  if now&gt;=nextSurvival then Score.tickSurvival(Runner.getAlive()) nextSurvival=now+5 end
  task.wait(1)
 end
 Builder.endRound() Runner.endRound() setState(&quot;ENDING&quot;,C.TIMES.ENDING)
 if winner==&quot;Runners&quot; then Map.celebrate() end Score.finishRound(winner,{})
 for t=C.TIMES.ENDING,1,-1 do timeLeft=t emit() task.wait(1) end
end
function S.init()
 local function added(p)
  p:SetAttribute(&quot;Role&quot;,state==&quot;WAITING&quot; and &quot;Lobby&quot; or &quot;Spectator&quot;) p:SetAttribute(&quot;Lives&quot;,0) p:SetAttribute(&quot;InRound&quot;,false) p:SetAttribute(&quot;Points&quot;,0)
  p.CharacterAdded:Connect(function() task.wait(.25) if p.Parent then
   if p:GetAttribute(&quot;Role&quot;)==&quot;Builder&quot; then teleport(p,Map.getBuilderCabinCFrame()) local root=U.getCharacterRoot(p) if root then root.Anchored=true end elseif not p:GetAttribute(&quot;InRound&quot;) then teleport(p,Map.getLobbySpawn()) end
  end end)
 end
 Players.PlayerAdded:Connect(added) for _,p in ipairs(Players:GetPlayers()) do added(p) end
 local limiter=U.rateLimiter(2)
 R.ReadyForData.OnServerEvent:Connect(function(p) if limiter(p) then R.RoundState:FireClient(p,packet()) R.RoleAssigned:FireClient(p,p:GetAttribute(&quot;Role&quot;) or &quot;Lobby&quot;) R.ThemeChanged:FireClient(p,theme) end end)
 Runner.Finished.Event:Connect(function() if state==&quot;RUNNING&quot; and not grace then grace=os.clock()+C.FINISH_GRACE end end)
 task.spawn(function()
  while true do
   local ok,err=xpcall(cycle,debug.traceback) if not ok then warn(&quot;[RoundService] &quot;..tostring(err)) R.Toast:FireAllClients(&quot;Reiniciando rodada.&quot;,&quot;warn&quot;) end
   setState(&quot;RESET&quot;,C.TIMES.RESET) reset() task.wait(C.TIMES.RESET)
  end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000001EE">
				<Properties>
					<string name="Name">RunnerService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local CS=game:GetService(&quot;CollectionService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Map=require(script.Parent.MapService)
local Score=require(script.Parent.ScoreService)
local R=RS.Remotes
local S={HelperCreated=Instance.new(&quot;BindableEvent&quot;),Finished=Instance.new(&quot;BindableEvent&quot;)}
-- HelperCreated(player); Finished(player,place): eventos internos, somente servidor.
S.HelperCreated.Name=&quot;HelperCreated&quot; S.HelperCreated.Parent=script
S.Finished.Name=&quot;Finished&quot; S.Finished.Parent=script
local active=false local records={} local connections={} local hooked={} local finishCount=0
local function setRole(p,role) p:SetAttribute(&quot;Role&quot;,role) R.RoleAssigned:FireClient(p,role) end
local function configure(p,char)
 local h=char:WaitForChild(&quot;Humanoid&quot;,5) if not h then return end
 h.UseJumpPower=true h.WalkSpeed=C.RUNNER.WALKSPEED h.JumpPower=C.RUNNER.JUMPPOWER
 local rec=records[p]
 if rec and active then
  task.defer(function() if p.Parent and char.Parent then
   if p:GetAttribute(&quot;Role&quot;)==&quot;Helper&quot; then char:PivotTo(Map.getBuilderCabinCFrame()) local root=U.getCharacterRoot(p) if root then root.Anchored=true end
   elseif rec.finished then char:PivotTo(Map.getLobbySpawn())
   else S.respawnAtCheckpoint(p) S.freeze(p,rec.frozen) end
  end end)
 end
 h.Died:Connect(function()
  if active and S.isAlive(p) then local r=records[p] r.invuln=0 S.damage(p,&quot;Morte&quot;,nil) end
 end)
end
function S.freeze(p,value)
 local r=records[p] if r then r.frozen=value end
 local h=p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) if h then h.WalkSpeed=value and 0 or C.RUNNER.WALKSPEED h.JumpPower=value and 0 or C.RUNNER.JUMPPOWER end
end
function S.isAlive(p) local r=records[p] return active and r~=nil and not r.finished and p.Parent~=nil and p:GetAttribute(&quot;Role&quot;)==&quot;Runner&quot; and (p:GetAttribute(&quot;Lives&quot;) or 0)&gt;0 end
function S.getAlive() local out={} for p in pairs(records) do if S.isAlive(p) then table.insert(out,p) end end return out end
function S.getFinishCount() return finishCount end
function S.respawnAtCheckpoint(p)
 if not p.Character then return end local root=U.getCharacterRoot(p)
 if root then root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero end
 p.Character:PivotTo(Map.getCheckpointCFrame(p:GetAttribute(&quot;CheckpointIndex&quot;) or 0))
end
function S.becomeHelper(p)
 setRole(p,&quot;Helper&quot;) local r=records[p] if r then r.invuln=math.huge end
 if p.Character then
  p.Character:PivotTo(Map.getBuilderCabinCFrame()+Vector3.new(5,0,0))
  local root=U.getCharacterRoot(p) if root then root.Anchored=true end
  for _,v in ipairs(p.Character:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) then v.Transparency=math.max(v.Transparency,.65) end end
 end
 R.Toast:FireClient(p,&quot;Voce virou Ajudante! Construa pontes para os corredores.&quot;,&quot;info&quot;) S.HelperCreated:Fire(p)
end
function S.damage(p,pieceId,byBuilder)
 local rec=records[p] local now=os.clock()
 if not S.isAlive(p) or rec.frozen or now&lt;(rec.invuln or 0) then return end
 rec.invuln=now+C.RUNNER.INVULN_TIME
 local lives=math.max(0,(p:GetAttribute(&quot;Lives&quot;) or C.RUNNER.LIVES)-1)
 p:SetAttribute(&quot;Lives&quot;,lives) R.LivesUpdate:FireClient(p,lives) R.ScreenFX:FireClient(p,&quot;flash&quot;,.35)
 if lives==0 then
  Score.registerElimination(p,byBuilder,pieceId)
  R.PlayerEliminated:FireAllClients({userId=p.UserId,pieceId=pieceId,byUserId=byBuilder and byBuilder.UserId})
  S.becomeHelper(p)
 else
  R.Toast:FireClient(p,&quot;Voce perdeu uma vida \u{b7} &quot;..lives..&quot; restantes&quot;,&quot;bad&quot;)
  S.respawnAtCheckpoint(p)
  local f=Instance.new(&quot;ForceField&quot;) f.Visible=true f.Parent=p.Character game:GetService(&quot;Debris&quot;):AddItem(f,C.RUNNER.INVULN_TIME)
 end
end
local function playerFromHit(hit) local char=hit:FindFirstAncestorOfClass(&quot;Model&quot;) return char and Players:GetPlayerFromCharacter(char) end
local function hook(obj,tag)
 if not obj:IsA(&quot;BasePart&quot;) or hooked[obj] then return end hooked[obj]=true
 table.insert(connections,obj.Touched:Connect(function(hit)
  local p=playerFromHit(hit) if not p or not S.isAlive(p) then return end local rec=records[p] if rec.frozen then return end
  if tag==&quot;KillPlane&quot; then S.damage(p,&quot;Queda&quot;)
  elseif tag==&quot;Hazard&quot; then
   local piece=obj:FindFirstAncestorOfClass(&quot;Model&quot;) or obj
   if piece:GetAttribute(&quot;Armed&quot;)~=true then return end
   S.damage(p,piece:GetAttribute(&quot;PieceId&quot;),Players:GetPlayerByUserId(piece:GetAttribute(&quot;OwnerUserId&quot;) or 0))
  elseif tag==&quot;Checkpoint&quot; then
   local index=obj:GetAttribute(&quot;Index&quot;) if type(index)==&quot;number&quot; and index&gt;(p:GetAttribute(&quot;CheckpointIndex&quot;) or 0) then
    -- Impede saltar checkpoints em sequencia impossivel.
    if index~=(p:GetAttribute(&quot;CheckpointIndex&quot;) or 0)+1 then return end
    p:SetAttribute(&quot;CheckpointIndex&quot;,index) local flag=obj.Parent:FindFirstChild(&quot;Bandeira&quot;) if flag then U.tween(flag,TweenInfo.new(.4),{Color=C.COLORS.SUCCESS}) end
    R.Toast:FireClient(p,&quot;Checkpoint &quot;..index..&quot; salvo!&quot;,&quot;good&quot;) R.PieceActivated:FireClient(p,&quot;checkpoint&quot;,obj.Position)
   end
  elseif tag==&quot;FinishLine&quot; then
   if (p:GetAttribute(&quot;CheckpointIndex&quot;) or 0)&lt;#C.ARENA.CHECKPOINTS_Z then return end
   rec.finished=true finishCount+=1 p:SetAttribute(&quot;InRound&quot;,false) Score.registerFinish(p,finishCount)
   R.ReachedFinish:FireAllClients(p.UserId,finishCount) R.Toast:FireClient(p,&quot;Chegada! Posicao #&quot;..finishCount,&quot;good&quot;) S.Finished:Fire(p,finishCount)
  elseif tag==&quot;FakeCheckpoint&quot; and os.clock()&gt;(rec.fakeAt or 0) then
   rec.fakeAt=os.clock()+2 R.PieceActivated:FireClient(p,&quot;CheckpointFalso&quot;,obj.Position) R.Toast:FireClient(p,&quot;Era um checkpoint falso!&quot;,&quot;warn&quot;)
  end
 end))
end
function S.startRound(runners)
 S.endRound() active=true finishCount=0 records={}
 for _,p in ipairs(runners) do
  records[p]={invuln=0,dashAt=-math.huge,frozen=true,finished=false,speedTime=0}
  p:SetAttribute(&quot;Lives&quot;,C.RUNNER.LIVES) p:SetAttribute(&quot;CheckpointIndex&quot;,0) p:SetAttribute(&quot;InRound&quot;,true)
  R.LivesUpdate:FireClient(p,C.RUNNER.LIVES) S.freeze(p,true)
 end
 for _,tag in ipairs({&quot;Checkpoint&quot;,&quot;FakeCheckpoint&quot;,&quot;FinishLine&quot;,&quot;KillPlane&quot;,&quot;Hazard&quot;}) do
  for _,obj in ipairs(CS:GetTagged(tag)) do hook(obj,tag) end
  table.insert(connections,CS:GetInstanceAddedSignal(tag):Connect(function(obj) hook(obj,tag) end))
 end
end
function S.endRound()
 active=false for _,conn in ipairs(connections) do conn:Disconnect() end connections={} hooked={}
 for p in pairs(records) do if p.Parent then S.freeze(p,false) end end records={}
end
function S.init()
 local limit=U.rateLimiter(4)
 R.UseDash.OnServerEvent:Connect(function(p)
  if not limit(p) or not S.isAlive(p) then return end local rec=records[p] local now=os.clock()
  if rec.frozen or now-rec.dashAt&lt;C.RUNNER.DASH_COOLDOWN then return end
  local root=U.getCharacterRoot(p) if not root then return end
  rec.dashAt=now rec.motionUntil=now+.8
  local dir=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
  if dir.Magnitude&lt;.01 then return end dir=dir.Unit
  root.AssemblyLinearVelocity=dir*C.RUNNER.DASH_FORCE+Vector3.new(0,root.AssemblyLinearVelocity.Y,0)
  R.DashCooldown:FireClient(p,C.RUNNER.DASH_COOLDOWN) R.PieceActivated:FireAllClients(&quot;Dash&quot;,root.Position)
 end)
 local function added(p) p.CharacterAdded:Connect(function(c) configure(p,c) end) if p.Character then task.spawn(configure,p,p.Character) end end
 Players.PlayerAdded:Connect(added) for _,p in ipairs(Players:GetPlayers()) do added(p) end
 Players.PlayerRemoving:Connect(function(p) records[p]=nil end)
 Run.Heartbeat:Connect(function(dt)
  if not active then return end
  for p,rec in pairs(records) do
   if S.isAlive(p) and not rec.frozen then
    local root=U.getCharacterRoot(p)
    if root then
     if root.Position.Y&lt;C.ARENA.ORIGIN.Y+C.ARENA.KILL_Y-2 then S.damage(p,&quot;Queda&quot;) end
     local speed=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
     if speed&gt;C.RUNNER.WALKSPEED*3 and os.clock()&gt;(rec.motionUntil or 0) then rec.speedTime+=dt else rec.speedTime=0 end
     if rec.speedTime&gt;1 then rec.speedTime=0 S.respawnAtCheckpoint(p) warn(&quot;[Runner] Velocidade irregular: &quot;..p.UserId) end
    end
   end
  end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000001EF">
				<Properties>
					<string name="Name">ScoreService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local DSS=game:GetService(&quot;DataStoreService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local C=require(RS.Modules.Config)
local D=require(script.Parent.DataService)
local R=RS:WaitForChild(&quot;Remotes&quot;)
local S={} local participants={} local scores={} local roles={} local kills={} local finishes={} local top={} local dirty={}
local store=DSS:GetOrderedDataStore(&quot;Wins_v1&quot;)
function S.startRound(list)
 participants=table.clone(list) scores={} roles={} kills={} finishes={}
 for _,p in ipairs(list) do scores[p]=0 roles[p]=p:GetAttribute(&quot;Role&quot;) p:SetAttribute(&quot;Points&quot;,0) end
end
function S.addPoints(p,amount,reason)
 if not p or not p.Parent or scores[p]==nil then return end scores[p]+=amount p:SetAttribute(&quot;Points&quot;,scores[p])
 if reason~=&quot;Sobrevivencia&quot; then R.Toast:FireClient(p,&quot;+&quot;..amount..&quot; \u{b7} &quot;..(reason or &quot;Pontos&quot;),&quot;good&quot;) end
end
function S.registerFinish(p,place) if finishes[p] then return end finishes[p]=place S.addPoints(p,C.SCORE.PLACE[place] or C.SCORE.PLACE_DEFAULT,&quot;Chegada #&quot;..place) end
function S.registerElimination(victim,killer,pieceId)
 if killer and killer~=victim then
  kills[killer]=(kills[killer] or 0)+1
  if roles[killer]==&quot;Builder&quot; then
   local before=(kills[killer]-1)*C.SCORE.BUILDER_PER_ELIM local grant=math.max(0,math.min(C.SCORE.BUILDER_PER_ELIM,C.SCORE.BUILDER_ELIM_MAX-before))
   if grant&gt;0 then S.addPoints(killer,grant,&quot;Eliminacao&quot;) end
  else S.addPoints(killer,C.SCORE.HELPER_ELIM,&quot;Ajuda&quot;) end
 end
end
function S.registerCombo(p) S.addPoints(p,C.SCORE.BUILDER_COMBO,&quot;Combo&quot;) end
function S.tickSurvival(runners) for _,p in ipairs(runners) do S.addPoints(p,C.SCORE.SURVIVE_PER_5S,&quot;Sobrevivencia&quot;) end end
function S.finishRound(winner,summary)
 local podium={} local mvp=nil local highest=-1
 for _,p in ipairs(participants) do
  if p.Parent then
   if roles[p]==&quot;Builder&quot; and winner==&quot;Builder&quot; then S.addPoints(p,C.SCORE.BUILDER_WIN,&quot;Vitoria&quot;) end
   if (scores[p] or 0)&gt;highest then mvp=p highest=scores[p] or 0 end
   if finishes[p] then table.insert(podium,{userId=p.UserId,place=finishes[p],points=scores[p] or 0}) end
   D.update(p,function(d)
    d.stats.rounds+=1 d.stats.eliminations+=(kills[p] or 0)
    if roles[p]==&quot;Builder&quot; then d.stats.timesBuilder+=1 if winner==&quot;Builder&quot; then d.stats.winsBuilder+=1 end
    elseif winner==&quot;Runners&quot; then d.stats.winsRunner+=1 end
    if finishes[p] and (d.stats.bestPlace==0 or finishes[p]&lt;d.stats.bestPlace) then d.stats.bestPlace=finishes[p] end
   end)
   local d=D.get(p) if d and D.isPersistent(p) then dirty[p.UserId]=d.stats.winsRunner+d.stats.winsBuilder end
   D.addCoins(p,math.round((scores[p] or 0)*C.SCORE.COINS_FACTOR)) D.addXp(p,scores[p] or 0)
  end
 end
 table.sort(podium,function(a,b) return a.place&lt;b.place end)
 for _,p in ipairs(Players:GetPlayers()) do
  R.RoundResult:FireClient(p,{winner=winner,podium=podium,mvpUserId=mvp and mvp.UserId,rewards={coins=math.round((scores[p] or 0)*C.SCORE.COINS_FACTOR),xp=scores[p] or 0},stats={eliminations=kills[p] or 0}})
 end
 return {winner=winner,podium=podium,mvpUserId=mvp and mvp.UserId,rewards={coins=0,xp=0},stats={eliminations=0}}
end
function S.getTopWins(n) local out={} for i=1,math.min(n or 10,#top) do out[i]=top[i] end return out end
function S.init()
 -- Uma escrita por jogador alterado a cada 120s; uma leitura global por ciclo.
 task.spawn(function()
  while true do
   task.wait(C.DATA.RANK_INTERVAL)
   for userId,value in pairs(dirty) do
    local ok=pcall(function() store:UpdateAsync(tostring(userId),function(old) return math.max(old or 0,value) end) end)
    if ok and dirty[userId]==value then dirty[userId]=nil end
   end
   local ok,page=pcall(function() return store:GetSortedAsync(false,10):GetCurrentPage() end)
   if ok then
    top={} for _,entry in ipairs(page) do table.insert(top,{userId=tonumber(entry.key),wins=entry.value}) end
    local map=require(script.Parent.MapService) map.updateLeaderboard(top)
   end
  end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX000001F7">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">Main</string>
				<ProtectedString name="Source">-- Construtor vs Corredores \u{b7} base das etapas 01\u{2013}05.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local SoundService=game:GetService(&quot;SoundService&quot;)
local function folder(parent,name) local x=parent:FindFirstChild(name) if not x then x=Instance.new(&quot;Folder&quot;) x.Name=name x.Parent=parent end return x end
local remotes=folder(RS,&quot;Remotes&quot;) local count=0
for _,name in ipairs({&quot;RoundState&quot;,&quot;RoleAssigned&quot;,&quot;EnergyUpdate&quot;,&quot;LivesUpdate&quot;,&quot;DashCooldown&quot;,&quot;PlaceResult&quot;,&quot;PlayerEliminated&quot;,&quot;ReachedFinish&quot;,&quot;RoundResult&quot;,&quot;Toast&quot;,&quot;ThemeChanged&quot;,&quot;PieceActivated&quot;,&quot;ScreenFX&quot;,&quot;SettingsLoad&quot;,&quot;StatsUpdate&quot;,&quot;EmoteBroadcast&quot;,&quot;PlacePiece&quot;,&quot;UndoPiece&quot;,&quot;UseDash&quot;,&quot;SaveSettings&quot;,&quot;Emote&quot;,&quot;ReadyForData&quot;}) do
 if not remotes:FindFirstChild(name) then local r=Instance.new(&quot;RemoteEvent&quot;) r.Name=name r.Parent=remotes count+=1 end
end
if not remotes:FindFirstChild(&quot;GetPlayerData&quot;) then local r=Instance.new(&quot;RemoteFunction&quot;) r.Name=&quot;GetPlayerData&quot; r.Parent=remotes count+=1 end
for _,name in ipairs({&quot;Lobby&quot;,&quot;Arena&quot;,&quot;PiecesActive&quot;}) do folder(workspace,name) end
for _,name in ipairs({&quot;Pieces&quot;,&quot;Effects&quot;}) do folder(RS,name) end
local master=SoundService:FindFirstChild(&quot;Master&quot;) or Instance.new(&quot;SoundGroup&quot;) master.Name=&quot;Master&quot; master.Parent=SoundService
for _,name in ipairs({&quot;Music&quot;,&quot;SFX&quot;,&quot;UI&quot;}) do local g=master:FindFirstChild(name) or Instance.new(&quot;SoundGroup&quot;) g.Name=name g.Parent=master end
print(&quot;[Main] Remotes: &quot;..count..&quot; criados&quot;)
local services=script.Parent:WaitForChild(&quot;Services&quot;)
for _,name in ipairs({&quot;MapService&quot;,&quot;DataService&quot;,&quot;ScoreService&quot;,&quot;RunnerService&quot;,&quot;PieceService&quot;,&quot;BuilderService&quot;,&quot;AntiExploitService&quot;,&quot;ReplayService&quot;,&quot;RoundService&quot;}) do
 local mod=services:FindFirstChild(name)
 if mod then local ok,result=pcall(require,mod) if ok and type(result)==&quot;table&quot; and result.init then local success,err=pcall(result.init) if not success then warn(&quot;[Main] &quot;..name..&quot;: &quot;..tostring(err)) end elseif not ok then warn(&quot;[Main] &quot;..name..&quot;: &quot;..tostring(result)) end end
end
</ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX000001F8">
			<Properties>
				<string name="Name">LEIA_ME</string>
				<ProtectedString name="Source">-- CONSTRUTOR VS CORREDORES \u{b7} BASE 01\u{2013}05
-- Abra o arquivo e use Test &gt; Start Server com 2 jogadores.
-- Q: dash; R: girar; Z: desfazer; T/botao ALTURA: nivel.
-- Construtor: clique no mundo; WASD move a camera; roda do mouse aproxima.
-- O mapa tem lacunas: use plataformas para permitir a travessia.
-- Modelos atualizados no Blender com studs nativos; comportamentos especiais pendentes.
-- Audio e animacoes continuam com rbxassetid://0.
-- Dados funcionam em memoria no Studio sem publicacao.
-- Para persistir: publique uma copia de teste e habilite acesso a API Services.
-- Nunca testado neste ambiente dentro do Roblox Studio: validar multiplayer.
-- Os arquivos enviados eram especificacoes, sem codigo pronto.
return {escopo=&quot;Visual Stud Classico redesenhado no Blender; base 01\u{2013}05&quot;,etapasPendentes={6,7,8,9,10}}
</ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX000001DC">
		<Properties>
			<float name="CharacterJumpPower">50</float>
			<bool name="CharacterUseJumpPower">true</bool>
			<float name="CharacterWalkSpeed">16</float>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX000001DD">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX000001DE">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX000001F0">
					<Properties>
						<string name="Name">AudioController</string>
						<ProtectedString name="Source">-- Sem audios externos: os placeholders silenciosos podem ser substituidos no SoundBank.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local SoundService=game:GetService(&quot;SoundService&quot;)
local Bank=require(RS.Modules.SoundBank)
local U=require(RS.Modules.Util)
local Settings=require(script.Parent.SettingsController)
local A={} local music=nil
local function play(key,group)
 local id=Bank.SFX[key] or Bank.UI[key] if not id or id==&quot;rbxassetid://0&quot; then return end
 local s=U.createSound(SoundService,id,{Volume=Bank.volumeOf(key)*Settings.current.audio.master/100})
 local master=SoundService:FindFirstChild(&quot;Master&quot;) s.SoundGroup=master and master:FindFirstChild(group or &quot;SFX&quot;)
 s:Play() s.Ended:Once(function() s:Destroy() end) game:GetService(&quot;Debris&quot;):AddItem(s,30)
end
function A.setState(state)
 if music then music:Destroy() music=nil end local key=state==&quot;RUNNING&quot; and &quot;running&quot; or state==&quot;PREPARING&quot; and &quot;preparing&quot; or &quot;lobby&quot; local id=Bank.MUSIC[key]
 if id and id~=&quot;rbxassetid://0&quot; then music=U.createSound(SoundService,id,{Looped=true,Volume=Settings.current.audio.music/100*Settings.current.audio.master/100}) music:Play() end
end
function A.init() RS.Remotes.PieceActivated.OnClientEvent:Connect(function(id) play(id==&quot;Dash&quot; and &quot;place&quot; or id) end) end
return A
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000001F1">
					<Properties>
						<string name="Name">BuilderController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Input=game:GetService(&quot;UserInputService&quot;)
local GuiService=game:GetService(&quot;GuiService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local B={} local selected=&quot;Plataforma&quot; local rotation=0 local level=0 local role=&quot;Lobby&quot; local state=&quot;WAITING&quot; local ghost local target=nil local pointer=nil
function B.select(id) selected=id end
function B.rotate() rotation=(rotation+1)%4 end
function B.height() level=(level+1)%C.BUILD.HEIGHT_LEVELS return level end
function B.setRole(value) role=value end
function B.setState(value) state=value end
function B.init()
 ghost=U.makePart({Name=&quot;PreviewLocal&quot;,Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,Transparency=1,Material=Enum.Material.ForceField,Parent=workspace})
 local function canBuild() return (role==&quot;Builder&quot; or role==&quot;Helper&quot;) and state==&quot;RUNNING&quot; end
 Input.InputBegan:Connect(function(input,gp)
  if gp then return end
  if input.KeyCode==Enum.KeyCode.Q then RS.Remotes.UseDash:FireServer() end
  if not canBuild() then return end
  if input.KeyCode==Enum.KeyCode.R then B.rotate()
  elseif input.KeyCode==Enum.KeyCode.Z then RS.Remotes.UndoPiece:FireServer()
  elseif input.KeyCode==Enum.KeyCode.T then B.height()
  elseif input.UserInputType==Enum.UserInputType.MouseButton1 and target then RS.Remotes.PlacePiece:FireServer(selected,target) end
 end)
 local function atPoint(point)
  local camera=workspace.CurrentCamera if not camera then return nil end
  local ray=camera:ViewportPointToRay(point.X,point.Y) if math.abs(ray.Direction.Y)&lt;.001 then return nil end
  local t=(C.ARENA.ORIGIN.Y-ray.Origin.Y)/ray.Direction.Y if t&lt;0 then return nil end
  local pos=U.snapToGrid(ray.Origin+ray.Direction*t,C.PIECES.GRID) local d=Catalog.get(selected)
  return CFrame.new(pos.X,C.ARENA.ORIGIN.Y+d.tamanho.Y/2-1+level*C.BUILD.HEIGHT_STEP,pos.Z)*CFrame.Angles(0,rotation*math.pi/2,0)
 end
 Input.TouchTapInWorld:Connect(function(point,processed)
  if processed or not canBuild() then return end local inset=GuiService:GetGuiInset() local cf=atPoint(point-inset) if cf then pointer=point-inset RS.Remotes.PlacePiece:FireServer(selected,cf) end
 end)
 Run.RenderStepped:Connect(function()
  if not canBuild() then ghost.Transparency=1 target=nil return end
  local inset=GuiService:GetGuiInset() local pos=Input.TouchEnabled and pointer or (Input:GetMouseLocation()-inset)
  if not pos then ghost.Transparency=1 return end target=atPoint(pos)
  local d=Catalog.get(selected)
  if target then ghost.Size=d.tamanho ghost.CFrame=target ghost.Color=d.cor ghost.Transparency=.45 else ghost.Transparency=1 end
 end)
end
return B
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000001F2">
					<Properties>
						<string name="Name">CameraController</string>
						<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Input=game:GetService(&quot;UserInputService&quot;)
local C=require(game:GetService(&quot;ReplicatedStorage&quot;).Modules.Config)
local Cam={} local building=false local focus=Vector3.new(0,50,120) local height=230
function Cam.setRole(role) building=role==&quot;Builder&quot; or role==&quot;Helper&quot; if building then focus=C.ARENA.ORIGIN+Vector3.new(0,0,120) end end
function Cam.init()
 Input.InputChanged:Connect(function(i,gp) if building and not gp and i.UserInputType==Enum.UserInputType.MouseWheel then height=math.clamp(height-i.Position.Z*16,65,300) end end)
 Run:BindToRenderStep(&quot;BuilderCamera&quot;,Enum.RenderPriority.Camera.Value+1,function(dt)
  local camera=workspace.CurrentCamera if not camera then return end
  if building then
   camera.CameraType=Enum.CameraType.Scriptable
   if not Input:GetFocusedTextBox() then
    local x=(Input:IsKeyDown(Enum.KeyCode.D) and 1 or 0)-(Input:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
    local z=(Input:IsKeyDown(Enum.KeyCode.W) and 1 or 0)-(Input:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
    focus+=Vector3.new(-x,0,z)*dt*60 focus=Vector3.new(math.clamp(focus.X,-40,40),C.ARENA.ORIGIN.Y,math.clamp(focus.Z,0,240))
   end
   camera.CFrame=CFrame.lookAt(focus+Vector3.new(0,height,0),focus,Vector3.new(0,0,1))
  elseif camera.CameraType==Enum.CameraType.Scriptable then
   camera.CameraType=Enum.CameraType.Custom local char=Players.LocalPlayer.Character local hum=char and char:FindFirstChildOfClass(&quot;Humanoid&quot;) if hum then camera.CameraSubject=hum end
  end
 end)
end
return Cam
</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX000001F3">
					<Properties>
						<bool name="Disabled">false</bool>
						<string name="Name">ClientMain</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local R=RS:WaitForChild(&quot;Remotes&quot;)
for _,name in ipairs({&quot;RoundState&quot;,&quot;RoleAssigned&quot;,&quot;EnergyUpdate&quot;,&quot;LivesUpdate&quot;,&quot;DashCooldown&quot;,&quot;PlaceResult&quot;,&quot;RoundResult&quot;,&quot;Toast&quot;,&quot;ReadyForData&quot;}) do R:WaitForChild(name) end
local UI=require(script.Parent.UIController)
local Camera=require(script.Parent.CameraController)
local Builder=require(script.Parent.BuilderController)
local Settings=require(script.Parent.SettingsController)
local Audio=require(script.Parent.AudioController)
local VFX=require(script.Parent.VFXController)
UI.init({select=Builder.select,rotate=Builder.rotate,height=function() local level=Builder.height() UI.toast(&quot;Nivel de altura: &quot;..level,&quot;info&quot;) end,setting=function(cat,key) Settings.toggle(cat,key) UI.toast(&quot;Configuracao salva&quot;,&quot;info&quot;) end})
Camera.init() Builder.init() Settings.init() Audio.init() VFX.init()
R.RoundState.OnClientEvent:Connect(function(data) UI.setState(data) Builder.setState(data.state) Audio.setState(data.state) end)
R.RoleAssigned.OnClientEvent:Connect(function(role) UI.setRole(role) Camera.setRole(role) Builder.setRole(role) end)
R.EnergyUpdate.OnClientEvent:Connect(UI.setEnergy) R.LivesUpdate.OnClientEvent:Connect(UI.setLives) R.DashCooldown.OnClientEvent:Connect(UI.dashCooldown)
R.Toast.OnClientEvent:Connect(UI.toast) R.RoundResult.OnClientEvent:Connect(UI.showResult)
local reasons={SemEnergia=&quot;Sem energia suficiente&quot;,Cooldown=&quot;Aguarde o intervalo&quot;,ZonaProibida=&quot;Area protegida: afaste-se do checkpoint&quot;,ForaDoMapa=&quot;Escolha um ponto dentro da arena&quot;,Sobreposicao=&quot;Ja existe uma peca aqui&quot;,CaminhoBloqueado=&quot;Deixe espaco para passar&quot;,LimiteEpica=&quot;Espere a peca epica expirar&quot;,PecaInvalida=&quot;Peca nao permitida&quot;,Estado=&quot;Aguarde a corrida comecar&quot;}
R.PlaceResult.OnClientEvent:Connect(function(ok,reason) if not ok then UI.toast(reasons[reason] or tostring(reason),&quot;warn&quot;) end end)
UI.setRole(game:GetService(&quot;Players&quot;).LocalPlayer:GetAttribute(&quot;Role&quot;) or &quot;Lobby&quot;) R.ReadyForData:FireServer()
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000001F4">
					<Properties>
						<string name="Name">SettingsController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Lighting=game:GetService(&quot;Lighting&quot;)
local S=require(RS.Modules.Settings)
local U=require(RS.Modules.Util)
local X={current=U.deepCopy(S.DEFAULTS)}
function X.apply(data)
 X.current=S.validate(data) Lighting.GlobalShadows=X.current.graphics.shadows
 local cam=workspace.CurrentCamera if cam then cam.FieldOfView=X.current.controls.fov end
 local bloom=Lighting:FindFirstChildOfClass(&quot;BloomEffect&quot;) if bloom then bloom.Enabled=X.current.graphics.bloom end
end
function X.toggle(category,key)
 local d=U.deepCopy(X.current)
 if type(d[category])==&quot;table&quot; and type(d[category][key])==&quot;boolean&quot; then d[category][key]=not d[category][key] X.apply(d) RS.Remotes.SaveSettings:FireServer(d) end
end
function X.init() RS.Remotes.SettingsLoad.OnClientEvent:Connect(X.apply) end
return X
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000001F5">
					<Properties>
						<string name="Name">UIController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Players=game:GetService(&quot;Players&quot;)
local Tween=game:GetService(&quot;TweenService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local UI={} local gui local banner local roleLabel local energyLabel local livesLabel local toast local catalog local tools local dash local result local settingsPanel local callbacks={} local selected=nil local buttonList={}
local colors=C.COLORS
local function label(parent,text,size,pos,font)
 local l=Instance.new(&quot;TextLabel&quot;) l.Text=text l.Size=size l.Position=pos l.BackgroundTransparency=1 l.TextColor3=colors.TEXT l.Font=font or Enum.Font.GothamBold l.TextSize=16 l.TextWrapped=true l.Parent=parent return l
end
local function panel(parent,size,pos)
 local f=Instance.new(&quot;Frame&quot;) f.Size=size f.Position=pos f.BackgroundColor3=colors.BACKGROUND f.BackgroundTransparency=.07 f.Parent=parent
 local corner=Instance.new(&quot;UICorner&quot;) corner.CornerRadius=UDim.new(0,14) corner.Parent=f
 local stroke=Instance.new(&quot;UIStroke&quot;) stroke.Color=colors.CYAN stroke.Thickness=1.5 stroke.Transparency=.5 stroke.Parent=f
 local gradient=Instance.new(&quot;UIGradient&quot;) gradient.Color=ColorSequence.new(Color3.fromRGB(36,30,72),colors.BACKGROUND) gradient.Rotation=80 gradient.Parent=f return f
end
local function button(parent,text,size,pos,fn)
 local b=Instance.new(&quot;TextButton&quot;) b.Text=text b.Size=size b.Position=pos b.BackgroundColor3=colors.PURPLE b.TextColor3=colors.TEXT b.TextSize=14 b.Font=Enum.Font.GothamBold b.AutoButtonColor=true b.Parent=parent
 local corner=Instance.new(&quot;UICorner&quot;) corner.CornerRadius=UDim.new(0,10) corner.Parent=b
 b.Activated:Connect(fn) return b
end
function UI.toast(text,kind)
 local token={} UI.toastToken=token toast.Text=text toast.TextColor3=kind==&quot;bad&quot; and colors.DANGER or kind==&quot;good&quot; and colors.SUCCESS or colors.TEXT toast.Visible=true
 Tween:Create(toast,TweenInfo.new(.2,Enum.EasingStyle.Back),{TextTransparency=0}):Play()
 task.delay(3,function() if UI.toastToken==token then toast.Visible=false end end)
end
function UI.setState(data)
 local names={WAITING=&quot;ESPERANDO JOGADORES \u{b7} 2 NECESSARIOS&quot;,INTERMISSION=&quot;PROXIMA RODADA&quot;,PREPARING=&quot;PREPARE-SE&quot;,RUNNING=&quot;CORRA OU CONSTRUA!&quot;,ENDING=&quot;RODADA ENCERRADA&quot;,RESET=&quot;VOLTANDO AO LOBBY&quot;}
 banner.Text=(names[data.state] or data.state)..(data.timeLeft&gt;0 and &quot;  \u{b7}  &quot;..U.formatTime(data.timeLeft) or &quot;&quot;)
 UI.state=data.state if data.state~=&quot;ENDING&quot; then result.Visible=false end
end
function UI.setRole(role)
 UI.role=role local names={Builder=&quot;CONSTRUTOR&quot;,Runner=&quot;CORREDOR&quot;,Helper=&quot;AJUDANTE&quot;,Lobby=&quot;LOBBY&quot;,Spectator=&quot;ESPECTADOR&quot;}
 roleLabel.Text=names[role] or role
 local build=role==&quot;Builder&quot; or role==&quot;Helper&quot; catalog.Visible=build tools.Visible=build energyLabel.Visible=build livesLabel.Visible=role==&quot;Runner&quot; dash.Visible=role==&quot;Runner&quot;
 for _,b in ipairs(buttonList) do b:Destroy() end buttonList={}
 if build then
  for i,d in ipairs(Catalog.listForRole(role)) do
   local b=button(catalog,d.nome..&quot;\n&quot;..d.custo..&quot; energia&quot;,UDim2.fromOffset(150,56),UDim2.fromOffset(10+(i-1)*160,8),function() UI.select(d.id) end)
   b.BackgroundColor3=d.cor b.TextColor3=colors.BACKGROUND buttonList[#buttonList+1]=b
  end
  catalog.CanvasSize=UDim2.fromOffset(10+#buttonList*160,0)
  local first=Catalog.listForRole(role)[1] if first then UI.select(first.id) end
 end
end
function UI.select(id) selected=id local d=Catalog.get(id) UI.selectionLabel.Text=d.nome..&quot; \u{b7} &quot;..d.custo..&quot; energia   |   &quot;..(d.epic and &quot;EPICA&quot; or &quot;MODELO STUD CLASSICO&quot;) if callbacks.select then callbacks.select(id) end end
function UI.setEnergy(n,max) energyLabel.Text=string.format(&quot;ENERGIA  %d / %d&quot;,math.floor(n),max) end
function UI.setLives(n) livesLabel.Text=&quot;VIDAS  &quot;..string.rep(&quot;\u{2665} &quot;,math.max(0,n)) end
function UI.dashCooldown(seconds)
 local token={} UI.dashToken=token
 task.spawn(function() for s=math.ceil(seconds),1,-1 do if UI.dashToken~=token then return end dash.Text=&quot;DASH \u{b7} &quot;..s task.wait(1) end dash.Text=&quot;DASH \u{b7} Q&quot; end)
end
function UI.showResult(data)
 result.Visible=true
 result:FindFirstChild(&quot;Title&quot;).Text=data.winner==&quot;Runners&quot; and &quot;CORREDORES VENCERAM!&quot; or &quot;CONSTRUTOR VENCEU!&quot;
 local text={&quot;Recompensa: +&quot;..data.rewards.coins..&quot; moedas \u{b7} +&quot;..data.rewards.xp..&quot; XP&quot;}
 for _,v in ipairs(data.podium) do local p=Players:GetPlayerByUserId(v.userId) table.insert(text,&quot;#&quot;..v.place..&quot;  &quot;..(p and p.DisplayName or tostring(v.userId))..&quot; \u{b7} &quot;..v.points..&quot; pts&quot;) end
 result:FindFirstChild(&quot;Body&quot;).Text=table.concat(text,&quot;\n&quot;)
end
function UI.init(actions)
 callbacks=actions or {}
 gui=Instance.new(&quot;ScreenGui&quot;) gui.Name=&quot;ConstrutorVsCorredores&quot; gui.ResetOnSpawn=false gui.DisplayOrder=10 gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling gui.Parent=Players.LocalPlayer:WaitForChild(&quot;PlayerGui&quot;)
 local root=Instance.new(&quot;Frame&quot;) root.Name=&quot;Root&quot; root.Size=UDim2.fromScale(1,1) root.BackgroundTransparency=1 root.Parent=gui
 local head=panel(root,UDim2.new(.84,0,0,86),UDim2.new(.08,0,0,10))
 label(head,&quot;CONSTRUTOR vs CORREDORES&quot;,UDim2.new(1,-24,0,28),UDim2.fromOffset(12,5),Enum.Font.FredokaOne).TextSize=23
 banner=label(head,&quot;CARREGANDO...&quot;,UDim2.new(1,-24,0,28),UDim2.fromOffset(12,32)) banner.TextColor3=colors.CYAN banner.TextSize=14
 label(head,&quot;STUD CLASSICO \u{b7} MODELOS REMODELADOS NO BLENDER&quot;,UDim2.new(1,-24,0,16),UDim2.fromOffset(12,64)).TextSize=10
 local status=panel(root,UDim2.new(.46,0,0,68),UDim2.new(.02,0,0,108))
 roleLabel=label(status,&quot;LOBBY&quot;,UDim2.new(1,-16,0,28),UDim2.fromOffset(8,3)) roleLabel.TextColor3=colors.GOLD
 energyLabel=label(status,&quot;ENERGIA&quot;,UDim2.new(1,-16,0,26),UDim2.fromOffset(8,32)) energyLabel.Visible=false
 livesLabel=label(status,&quot;&quot;,UDim2.new(1,-16,0,26),UDim2.fromOffset(8,32))
 toast=label(root,&quot;&quot;,UDim2.new(.9,0,0,64),UDim2.new(.05,0,.35,0)) toast.TextSize=21 toast.Visible=false
 catalog=Instance.new(&quot;ScrollingFrame&quot;) catalog.Name=&quot;Catalogo&quot; catalog.Size=UDim2.new(1,-20,0,80) catalog.Position=UDim2.new(0,10,1,-90) catalog.BackgroundColor3=colors.BACKGROUND catalog.BackgroundTransparency=.05 catalog.ScrollBarThickness=6 catalog.ScrollingDirection=Enum.ScrollingDirection.X catalog.BorderSizePixel=0 catalog.Parent=root catalog.Visible=false
 tools=panel(root,UDim2.new(1,-20,0,82),UDim2.new(0,10,1,-180)) tools.Visible=false
 UI.selectionLabel=label(tools,&quot;&quot;,UDim2.new(1,-16,0,25),UDim2.fromOffset(8,0)) UI.selectionLabel.TextSize=13
 button(tools,&quot;GIRAR \u{b7} R&quot;,UDim2.new(.30,0,0,38),UDim2.new(.02,0,0,34),function() if callbacks.rotate then callbacks.rotate() end end)
 button(tools,&quot;ALTURA&quot;,UDim2.new(.30,0,0,38),UDim2.new(.35,0,0,34),function() if callbacks.height then callbacks.height() end end)
 button(tools,&quot;DESFAZER \u{b7} Z&quot;,UDim2.new(.30,0,0,38),UDim2.new(.68,0,0,34),function() RS.Remotes.UndoPiece:FireServer() end)
 dash=button(root,&quot;DASH \u{b7} Q&quot;,UDim2.fromOffset(130,56),UDim2.new(1,-145,1,-100),function() RS.Remotes.UseDash:FireServer() end) dash.Visible=false
 button(root,&quot;OPCOES&quot;,UDim2.fromOffset(100,36),UDim2.new(1,-112,0,108),function() settingsPanel.Visible=not settingsPanel.Visible end)
 settingsPanel=panel(root,UDim2.new(.8,0,0,190),UDim2.new(.1,0,.3,0)) settingsPanel.Visible=false settingsPanel.ZIndex=5
 label(settingsPanel,&quot;OPCOES RAPIDAS&quot;,UDim2.new(1,0,0,36),UDim2.new(),Enum.Font.FredokaOne)
 button(settingsPanel,&quot;Reduzir flashes&quot;,UDim2.new(.9,0,0,38),UDim2.new(.05,0,0,45),function() if callbacks.setting then callbacks.setting(&quot;accessibility&quot;,&quot;reduceFlashes&quot;) end end)
 button(settingsPanel,&quot;Ativar / desativar sombras&quot;,UDim2.new(.9,0,0,38),UDim2.new(.05,0,0,91),function() if callbacks.setting then callbacks.setting(&quot;graphics&quot;,&quot;shadows&quot;) end end)
 button(settingsPanel,&quot;FECHAR&quot;,UDim2.new(.9,0,0,32),UDim2.new(.05,0,0,140),function() settingsPanel.Visible=false end)
 result=panel(root,UDim2.new(.86,0,0,220),UDim2.new(.07,0,.29,0)) result.Visible=false
 local title=label(result,&quot;&quot;,UDim2.new(1,-20,0,55),UDim2.fromOffset(10,8),Enum.Font.FredokaOne) title.Name=&quot;Title&quot; title.TextSize=24 title.TextColor3=colors.GOLD
 local body=label(result,&quot;&quot;,UDim2.new(1,-20,1,-80),UDim2.fromOffset(10,70)) body.Name=&quot;Body&quot;
 return UI
end
return UI
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000001F6">
					<Properties>
						<string name="Name">VFXController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Settings=require(script.Parent.SettingsController)
local V={}
function V.init()
 RS.Remotes.ScreenFX.OnClientEvent:Connect(function(kind,intensity)
  if Settings.current.accessibility.reduceFlashes or kind~=&quot;flash&quot; then return end
  local effect=Instance.new(&quot;ColorCorrectionEffect&quot;) effect.Name=&quot;HitFeedback&quot; effect.TintColor=Color3.fromRGB(255,195,210) effect.Brightness=math.clamp(intensity,0,.15) effect.Parent=workspace.CurrentCamera
  game:GetService(&quot;TweenService&quot;):Create(effect,TweenInfo.new(.35),{Brightness=0,TintColor=Color3.new(1,1,1)}):Play() game:GetService(&quot;Debris&quot;):AddItem(effect,.4)
 end)
end
return V
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
