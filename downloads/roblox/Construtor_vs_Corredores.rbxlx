			<Item class="ModuleScript" referent="RBX0000027F">
				<Properties>
					<string name="Name">CosmeticCatalog</string>
					<ProtectedString name="Source">return {
 {id=&quot;Menta&quot;,name=&quot;Camisa menta&quot;,cost=100,color=Color3.fromRGB(73,192,154)},
