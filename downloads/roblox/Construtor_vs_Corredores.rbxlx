			<Item class="ModuleScript" referent="RBX000001EB">
				<Properties>
					<string name="Name">PieceService</string>
					<ProtectedString name="Source">-- Modelos redesenhados no Blender. TODO_ETAPA6: comportamentos especiais.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local CS=game:GetService(&quot;CollectionService&quot;)
local Http=game:GetService(&quot;HttpService&quot;)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local Art=require(RS.Modules.ModelArt)
local P={}
function P.spawn(id,cf,owner)
 local d=Catalog.get(id) local model=Art.spawn(id,cf,workspace.PiecesActive)
 model:SetAttribute(&quot;PieceId&quot;,id) model:SetAttribute(&quot;Uid&quot;,Http:GenerateGUID(false)) model:SetAttribute(&quot;OwnerUserId&quot;,owner.UserId)
 model:SetAttribute(&quot;PlacedAt&quot;,os.clock()) model:SetAttribute(&quot;ExpiresAt&quot;,os.clock()+d.vidaUtil) model:SetAttribute(&quot;Armed&quot;,false) model:SetAttribute(&quot;Epic&quot;,d.epic)
 local block=U.makePart({Name=&quot;Colisao&quot;,Size=d.tamanho,CFrame=cf,Transparency=1,CanQuery=true,Color=d.cor,Material=d.material,Parent=model})
 block:SetAttribute(&quot;Stage5Stub&quot;,true) model.PrimaryPart=block model.Parent=workspace.PiecesActive CS:AddTag(model,&quot;Piece&quot;)
 -- Perigos sao somente visuais nesta base. A etapa 06 deve montar tags e animacoes.
 return model
end
function P.dissolve(model)
 if not model or not model.Parent then return end
 -- Remove imediatamente do mundo; nao deixa colisao expirada.
 model:Destroy()
end
function P.init()
 local folder=RS:FindFirstChild(&quot;Pieces&quot;)
 for _,d in ipairs(Catalog.list()) do
  if not folder:FindFirstChild(d.id) then
   local m=Art.spawn(d.id,CFrame.new(),folder)
  end
 end
end
return P
</ProtectedString>
