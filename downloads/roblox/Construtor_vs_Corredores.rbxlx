				<string name="Name">Services</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX000001E7">
				<Properties>
					<string name="Name">AntiExploitService</string>
					<ProtectedString name="Source">-- Validacoes de colocacao estao no BuilderService; movimento no RunnerService.
-- Etapa 10: ampliar telemetria antes de publicar.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local U=require(RS.Modules.Util)
local A={}
function A.init()
 local limit=U.rateLimiter(2)
 RS.Remotes.Emote.OnServerEvent:Connect(function(p,id)
  if not limit(p) or type(id)~=&quot;string&quot; or #id&gt;16 then return end
  local Data=require(script.Parent.DataService) local d=Data.get(p)
  if d and table.find(d.owned.emotes,id) then RS.Remotes.EmoteBroadcast:FireAllClients(p.UserId,id) end
 end)
end
return A
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000001E8">
				<Properties>
					<string name="Name">BuilderService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Players=game:GetService(&quot;Players&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local Map=require(script.Parent.MapService)
local Piece=require(script.Parent.PieceService)
local Runner=require(script.Parent.RunnerService)
local B={}
B.REASONS={SemEnergia=&quot;Sem energia&quot;,Cooldown=&quot;Aguarde um instante&quot;,ZonaProibida=&quot;Perto de largada/checkpoint/chegada&quot;,ForaDoMapa=&quot;Fora do mapa&quot;,Sobreposicao=&quot;Ja existe uma peca aqui&quot;,CaminhoBloqueado=&quot;Deixe passagem livre&quot;,LimiteEpica=&quot;Limite de peca epica&quot;,PecaInvalida=&quot;Peca invalida&quot;,Estado=&quot;Espere a corrida comecar&quot;}
local active=false local accounts={} local placed={} local started=0 local lastSend=0 local lastSurge=-1
local rate=U.rateLimiter(C.BUILD.REQUESTS_PER_SECOND)
local function reject(p,reason) RS.Remotes.PlaceResult:FireClient(p,false,reason) return false,reason end
local function register(p,helper)
 local max=helper and C.ENERGY.HELPER_MAX or C.ENERGY.MAX
 accounts[p]={energy=max,max=max,regen=helper and C.ENERGY.HELPER_REGEN or C.ENERGY.REGEN,last=-math.huge,epicAt=-math.huge,cooldowns={},lastPiece=nil}
 p:SetAttribute(&quot;Energy&quot;,max) p:SetAttribute(&quot;MaxEnergy&quot;,max) RS.Remotes.EnergyUpdate:FireClient(p,max,max)
end
function B.addHelper(p) if active and p.Parent and p:GetAttribute(&quot;Role&quot;)==&quot;Helper&quot; then register(p,true) end end
function B.startRound(builder) B.endRound() active=true started=os.clock() lastSurge=-1 register(builder,false) end
function B.endRound()
 active=false accounts={}
 for _,entry in ipairs(placed) do Piece.dissolve(entry.model) end placed={}
end
local function solidWidth(cf,size)
 local x=math.abs(cf.RightVector.X)*size.X+math.abs(cf.LookVector.X)*size.Z
 local z=math.abs(cf.RightVector.Z)*size.X+math.abs(cf.LookVector.Z)*size.Z
 return x,z
end
local function blocked(cf,size)
 if size.Y&lt;=1 then return false end
 local w,z=solidWidth(cf,size) local half=C.ARENA.WIDTH/2
 -- Calcula a uniao de intervalos em X por faixa, sem dupla contagem.
 for strip=0,math.ceil(C.ARENA.LENGTH/8)-1 do
  local low=strip*8 local high=low+8 local intervals={}
  local function add(c,s)
   if s.Y&lt;=1 then return end local xw,zw=solidWidth(c,s) local rel=c.Position-C.ARENA.ORIGIN
   if rel.Z+zw/2&gt;low and rel.Z-zw/2&lt;high then table.insert(intervals,{math.max(-half,rel.X-xw/2),math.min(half,rel.X+xw/2)}) end
  end
  add(cf,size)
  for _,e in ipairs(placed) do if e.model.Parent then add(e.cf,e.size) end end
  table.sort(intervals,function(a,b) return a[1]&lt;b[1] end)
  local total=0 local right=-math.huge
  for _,v in ipairs(intervals) do if v[2]&gt;right then total+=v[2]-math.max(v[1],right) right=v[2] end end
  if total&gt;C.ARENA.WIDTH*C.ARENA.MAX_BLOCK_RATIO then return true end
 end return false
end
function B.handlePlace(p,id,cf)
 if not rate(p) then return reject(p,&quot;Cooldown&quot;) end
 if type(id)~=&quot;string&quot; or #id&gt;64 or typeof(cf)~=&quot;CFrame&quot; then return reject(p,&quot;PecaInvalida&quot;) end
 for _,n in ipairs({cf:GetComponents()}) do if n~=n or math.abs(n)&gt;1000000 then return reject(p,&quot;ForaDoMapa&quot;) end end
 local a=accounts[p] local role=p:GetAttribute(&quot;Role&quot;)
 if not active or not a or (role~=&quot;Builder&quot; and role~=&quot;Helper&quot;) then return reject(p,&quot;Estado&quot;) end
 local d=Catalog.get(id) if not d or (role==&quot;Helper&quot; and not d.helper) then return reject(p,&quot;PecaInvalida&quot;) end
 local now=os.clock()
 if a.energy&lt;d.custo then return reject(p,&quot;SemEnergia&quot;) end
 if now-a.last&lt;C.ENERGY.PLACE_COOLDOWN or now-(a.cooldowns[id] or -math.huge)&lt;d.cooldown then return reject(p,&quot;Cooldown&quot;) end
 local pos=cf.Position
 if not Map.isInsideArena(pos) then return reject(p,&quot;ForaDoMapa&quot;) end
 if Map.isInForbiddenZone(pos) then return reject(p,&quot;ZonaProibida&quot;) end
 local baseY=C.ARENA.ORIGIN.Y+d.tamanho.Y/2-1
 local level=math.clamp(math.round((pos.Y-baseY)/C.BUILD.HEIGHT_STEP),0,C.BUILD.HEIGHT_LEVELS-1)
 local snapped=U.snapToGrid(Vector3.new(pos.X,0,pos.Z),C.PIECES.GRID)
 local _,yaw=cf:ToOrientation() yaw=math.round(yaw/(math.pi/2))*(math.pi/2)
 local target=CFrame.new(snapped.X,baseY+level*C.BUILD.HEIGHT_STEP,snapped.Z)*CFrame.Angles(0,yaw,0)
 local width,depth=solidWidth(target,d.tamanho) local rel=target.Position-C.ARENA.ORIGIN
 if math.abs(rel.X)+width/2&gt;C.ARENA.WIDTH/2 or rel.Z-depth/2&lt;0 or rel.Z+depth/2&gt;C.ARENA.LENGTH then return reject(p,&quot;ForaDoMapa&quot;) end
 if Map.isInForbiddenZone(target.Position) then return reject(p,&quot;ZonaProibida&quot;) end
 if (target.Position-(C.ARENA.ORIGIN+Vector3.new(0,0,C.ARENA.LENGTH/2))).Magnitude&gt;C.ARENA.LENGTH then return reject(p,&quot;ForaDoMapa&quot;) end
 local filter=OverlapParams.new() filter.FilterType=Enum.RaycastFilterType.Include filter.FilterDescendantsInstances={workspace.PiecesActive}
 if #workspace:GetPartBoundsInBox(target,d.tamanho-Vector3.new(.15,.15,.15),filter)&gt;0 then return reject(p,&quot;Sobreposicao&quot;) end
 local epics=0 for _,e in ipairs(placed) do if e.model.Parent and e.epic then epics+=1 end end
 if d.epic and (epics&gt;=C.PIECES.MAX_EPIC_ACTIVE or now-a.epicAt&lt;C.PIECES.EPIC_COOLDOWN) then return reject(p,&quot;LimiteEpica&quot;) end
 if blocked(target,d.tamanho) then return reject(p,&quot;CaminhoBloqueado&quot;) end
 -- Todas as validacoes passaram: agora modifica o estado.
 if #placed&gt;=C.PIECES.MAX_ACTIVE then local old=table.remove(placed,1) Piece.dissolve(old.model) end
 local m=Piece.spawn(id,target,p)
 a.energy-=d.custo a.last=now a.cooldowns[id]=now if d.epic then a.epicAt=now end
 local entry={model=m,owner=p,cost=d.custo,time=now,expires=now+(d.vidaUtil or C.PIECES.LIFETIME),cf=target,size=d.tamanho,epic=d.epic}
 table.insert(placed,entry) a.lastPiece=entry
 RS.Remotes.PlaceResult:FireClient(p,true,nil,m:GetAttribute(&quot;Uid&quot;)) RS.Remotes.PieceActivated:FireAllClients(id,target.Position)
 return true,m:GetAttribute(&quot;Uid&quot;)
end
function B.undo(p)
 if not rate(p) or not active then return end local a=accounts[p] local e=a and a.lastPiece
 if not e or not e.model.Parent or os.clock()-e.time&gt;C.ENERGY.UNDO_WINDOW then return reject(p,&quot;Cooldown&quot;) end
 Piece.dissolve(e.model) a.energy=math.min(a.max,a.energy+e.cost*C.ENERGY.UNDO_REFUND) a.lastPiece=nil
end
function B.init()
 RS.Remotes.PlacePiece.OnServerEvent:Connect(B.handlePlace) RS.Remotes.UndoPiece.OnServerEvent:Connect(B.undo)
 Runner.HelperCreated.Event:Connect(B.addHelper)
 Players.PlayerRemoving:Connect(function(p) accounts[p]=nil end)
 Run.Heartbeat:Connect(function(dt)
  if not active then return end local now=os.clock() local elapsed=now-started
  local cycle=math.floor(elapsed/C.ENERGY.SURGE_INTERVAL)
  local surge=cycle&gt;0 and elapsed%C.ENERGY.SURGE_INTERVAL&lt;C.ENERGY.SURGE_DURATION
  if surge and lastSurge~=cycle then
   lastSurge=cycle for p in pairs(accounts) do if p.Parent then RS.Remotes.Toast:FireClient(p,&quot;SURTO DE ENERGIA!&quot;,&quot;good&quot;) RS.Remotes.ScreenFX:FireClient(p,&quot;flash&quot;,.12) end end
  end
  local send=now-lastSend&gt;=C.BUILD.SEND_INTERVAL if send then lastSend=now end
  for p,a in pairs(accounts) do
   a.energy=math.min(a.max,a.energy+a.regen*dt*(surge and C.ENERGY.SURGE_MULTIPLIER or 1))
   if send and p.Parent and a.sent~=math.floor(a.energy*10) then
    a.sent=math.floor(a.energy*10) p:SetAttribute(&quot;Energy&quot;,a.energy) RS.Remotes.EnergyUpdate:FireClient(p,a.energy,a.max)
   end
  end
  for i=#placed,1,-1 do local e=placed[i] if now&gt;=e.expires or not e.model.Parent then Piece.dissolve(e.model) table.remove(placed,i) end end
 end)
end
return B
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000001E9">
				<Properties>
					<string name="Name">DataService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local DSS=game:GetService(&quot;DataStoreService&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Http=game:GetService(&quot;HttpService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Settings=require(RS.Modules.Settings)
local D={}
local defaults={version=1,coins=0,xp=0,level=1,stats={winsRunner=0,winsBuilder=0,rounds=0,eliminations=0,timePlayed=0,bestPlace=0,timesBuilder=0},settings=Settings.DEFAULTS,owned={trails={},effects={},cabins={},emotes={&quot;Emote1&quot;}},equipped={},tutorialDone=false}
local cache,meta,ready={},{},{}
local store=DSS:GetDataStore(&quot;PlayerData_v1&quot;)
local session=Http:GenerateGUID(false)
local R=RS:WaitForChild(&quot;Remotes&quot;)
local memoryOnly=Run:IsStudio() and game.GameId==0
local function reconcile(old,template)
 local out=type(old)==&quot;table&quot; and U.deepCopy(old) or {}
 for k,v in pairs(template) do if type(v)==&quot;table&quot; then out[k]=reconcile(out[k],v) elseif type(out[k])~=type(v) then out[k]=v end end
 out._session=nil return out
end
local function retry(fn)
 for i=1,C.DATA.RETRIES do local ok,result=pcall(fn) if ok then return true,result end if i&lt;C.DATA.RETRIES then task.wait(2^(i-1)) end end
 return false,nil
end
local function push(p)
 if p.Parent and cache[p] then R.SettingsLoad:FireClient(p,cache[p].settings) R.StatsUpdate:FireClient(p,{stats=cache[p].stats,coins=cache[p].coins,xp=cache[p].xp,level=cache[p].level}) end
end
local function load(p)
 local data,loaded=nil,false
 if not memoryOnly then
  local ok,result=retry(function()
   return store:UpdateAsync(&quot;Player_&quot;..p.UserId,function(old)
    if type(old)==&quot;table&quot; and type(old._session)==&quot;table&quot; and old._session.id~=session and (old._session.expires or 0)&gt;os.time() then return nil end
    local new=reconcile(old,defaults) new._session={id=session,expires=os.time()+C.DATA.SESSION_TTL} return new
   end)
  end)
  if ok and type(result)==&quot;table&quot; then data=result loaded=true end
 end
 if not p.Parent then
  if loaded then retry(function() return store:UpdateAsync(&quot;Player_&quot;..p.UserId,function(old) if old and old._session and old._session.id==session then old._session=nil return old end return nil end) end) end
  return
 end
 cache[p]=reconcile(data,defaults) cache[p].settings=Settings.validate(cache[p].settings)
 meta[p]={noSave=not loaded,busy=false,leaving=false,joined=os.clock()}
 if ready[p] then push(p) end
 if not loaded and not memoryOnly then R.Toast:FireClient(p,&quot;Dados temporarios: esta sessao nao sera salva.&quot;,&quot;warn&quot;) end
end
function D.get(p) return cache[p] end
function D.waitForData(p,timeout) local endAt=os.clock()+(timeout or 25) repeat if cache[p] then return cache[p] end task.wait(.1) until not p.Parent or os.clock()&gt;endAt return nil end
function D.update(p,fn)
 if not cache[p] then return false end
 local copy=U.deepCopy(cache[p]) local ok,err=pcall(fn,copy)
 if not ok then warn(&quot;[DataService] &quot;..tostring(err)) return false end cache[p]=copy return true
end
function D.save(p,release)
 local m=meta[p] if not m or m.noSave or m.busy then return false end m.busy=true
 local data=U.deepCopy(cache[p]) data.stats.timePlayed+=math.floor(os.clock()-m.joined) m.joined=os.clock() cache[p].stats.timePlayed=data.stats.timePlayed
 local accepted=false
 local ok=retry(function()
  return store:UpdateAsync(&quot;Player_&quot;..p.UserId,function(old)
   if not old or not old._session or old._session.id~=session then return nil end
   local snapshot=U.deepCopy(data)
   if not release then snapshot._session={id=session,expires=os.time()+C.DATA.SESSION_TTL} end
   accepted=true return snapshot
  end)
 end)
 m.busy=false
 if not accepted then m.noSave=true end
 return ok and accepted
end
function D.addCoins(p,n) if D.update(p,function(d) d.coins=math.max(0,d.coins+math.round(n)) end) then push(p) end end
function D.addXp(p,n)
 if D.update(p,function(d)
  d.xp=math.max(0,d.xp+math.round(n)) local level=1 local need=100 local remaining=d.xp
  while remaining&gt;=need do remaining-=need level+=1 need=100+(level-1)*50 end d.level=level
 end) then push(p) end
end
function D.setSettings(p,s) if D.update(p,function(d) d.settings=Settings.validate(s) end) then push(p) end end
function D.isPersistent(p) return meta[p] and not meta[p].noSave end
function D.init()
 local readyLimit=U.rateLimiter(2) local settingsLimit=U.rateLimiter(2) local getLimit=U.rateLimiter(3)
 R.ReadyForData.OnServerEvent:Connect(function(p) if readyLimit(p) then ready[p]=true push(p) end end)
 R.SaveSettings.OnServerEvent:Connect(function(p,s) if settingsLimit(p) and type(s)==&quot;table&quot; then D.setSettings(p,s) end end)
 R.GetPlayerData.OnServerInvoke=function(p)
  if not getLimit(p) then return nil end local d=cache[p] if not d then return nil end
  return {stats=U.deepCopy(d.stats),settings=U.deepCopy(d.settings),coins=d.coins,level=d.level,xp=d.xp,owned=U.deepCopy(d.owned)}
 end
 Players.PlayerAdded:Connect(function(p) task.spawn(load,p) end)
 for _,p in ipairs(Players:GetPlayers()) do task.spawn(load,p) end
 Players.PlayerRemoving:Connect(function(p)
  local m=meta[p] if m then m.leaving=true while m.busy do task.wait(.1) end D.save(p,true) end
  cache[p]=nil meta[p]=nil ready[p]=nil
 end)
 task.spawn(function() while true do task.wait(C.DATA.AUTOSAVE) for p,m in pairs(meta) do if p.Parent and not m.leaving then task.spawn(D.save,p,false) end end end end)
 game:BindToClose(function()
  local count=0
  for p,m in pairs(meta) do if not m.leaving then count+=1 task.spawn(function() while m.busy do task.wait(.1) end D.save(p,true) count-=1 end) end end
  local deadline=os.clock()+25 while count&gt;0 and os.clock()&lt;deadline do task.wait(.1) end
 end)
end
return D
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000001EA">
				<Properties>
					<string name="Name">MapService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local CS=game:GetService(&quot;CollectionService&quot;)
local Lighting=game:GetService(&quot;Lighting&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Art=require(RS.Modules.MapArt)
local M={} local theme=&quot;NeonCidade&quot; local leaderboard=nil
local function model(parent,name) local m=Instance.new(&quot;Model&quot;) m.Name=name m.Parent=parent return m end
local function part(parent,name,size,pos,color,material)
 return U.makePart({Parent=parent,Name=name,Size=size,Position=pos,Color=color or C.COLORS.BACKGROUND,Material=material or Enum.Material.Plastic})
end
local function sign(parent,text,pos,size,color)
 local p=part(parent,&quot;Placa&quot;,size or Vector3.new(25,7,1),pos,C.COLORS.BACKGROUND)
 local g=Instance.new(&quot;SurfaceGui&quot;) g.Face=Enum.NormalId.Front g.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud g.PixelsPerStud=35 g.Parent=p
 local l=Instance.new(&quot;TextLabel&quot;) l.Size=UDim2.fromScale(1,1) l.BackgroundTransparency=1 l.Text=text l.TextColor3=color or C.COLORS.TEXT l.TextScaled=true l.Font=Enum.Font.FredokaOne l.Parent=g
 local pad=Instance.new(&quot;UIPadding&quot;) pad.PaddingLeft=UDim.new(0,12) pad.PaddingRight=UDim.new(0,12) pad.PaddingTop=UDim.new(0,10) pad.PaddingBottom=UDim.new(0,10) pad.Parent=l
 return l
end
local function neon(parent,name,size,pos,color)
 local p=part(parent,name,size,pos,color,Enum.Material.Neon) p.CanCollide=false p.CanTouch=false p.CanQuery=false p.CastShadow=false p:SetAttribute(&quot;ThemeNeon&quot;,true) return p
end
local function arch(parent,z,text,color)
 for _,x in ipairs({-18,18}) do neon(parent,&quot;Pilar&quot;,Vector3.new(1,13,1),C.ARENA.ORIGIN+Vector3.new(x,6,z),color) end
 neon(parent,&quot;Arco&quot;,Vector3.new(37,1,1),C.ARENA.ORIGIN+Vector3.new(0,12,z),color)
 sign(parent,text,C.ARENA.ORIGIN+Vector3.new(0,9,z),Vector3.new(28,4,1),color)
end
function M.buildLobby()
 local folder=workspace.Lobby folder:ClearAllChildren()
 local root=model(folder,&quot;Praca&quot;) local o=C.LOBBY.ORIGIN
 local floor=part(root,&quot;PracaCircular&quot;,Vector3.new(2,60,60),o-Vector3.new(0,1,0),Color3.fromRGB(28,30,60)) floor.Shape=Enum.PartType.Cylinder floor.Orientation=Vector3.new(0,0,90)
 for i=1,36 do local a=i*math.pi/18 local p=neon(root,&quot;Anel&quot;,Vector3.new(5.3,.25,.65),o+Vector3.new(math.cos(a)*29,.12,math.sin(a)*29),C.COLORS.CYAN) p.Orientation=Vector3.new(0,-math.deg(a)-90,0) end
 local spawn=Instance.new(&quot;SpawnLocation&quot;) spawn.Name=&quot;LobbySpawn&quot; spawn.Size=Vector3.new(8,1,8) spawn.Position=o+Vector3.new(0,.1,0) spawn.Anchored=true spawn.Neutral=true spawn.Duration=0 spawn.Material=Enum.Material.Neon spawn.Color=C.COLORS.PURPLE spawn.Parent=root
 sign(root,&quot;CONSTRUTOR\nVS CORREDORES&quot;,o+Vector3.new(0,13,22),Vector3.new(38,9,1),C.COLORS.CYAN)
 sign(root,&quot;COMO JOGAR\n1 \u{b7} Corra e salte entre plataformas\n2 \u{b7} Construa usando energia\n3 \u{b7} Alcance a chegada!&quot;,o+Vector3.new(-17,7,10),Vector3.new(15,10,1))
 leaderboard=sign(root,&quot;TOP 10\nVitorias globais\nDados apos publicar&quot;,o+Vector3.new(17,7,10),Vector3.new(14,10,1),C.COLORS.GOLD)
 sign(root,&quot;TESTE COM 2 JOGADORES\nQ \u{b7} Dash   |   R \u{b7} Girar   |   Z \u{b7} Desfazer&quot;,o+Vector3.new(0,4,-22),Vector3.new(31,5,1),C.COLORS.TEXT)
 for _,x in ipairs({-22,22}) do
  part(root,&quot;Banco&quot;,Vector3.new(8,1.5,3),o+Vector3.new(x,1,-7),C.COLORS.PURPLE)
  for _,z in ipairs({-16,17}) do
   part(root,&quot;Vaso&quot;,Vector3.new(3,3,3),o+Vector3.new(x,1,z),C.COLORS.GOLD)
   local tree=part(root,&quot;Planta&quot;,Vector3.new(5,6,5),o+Vector3.new(x,5,z),C.COLORS.SUCCESS) tree.Shape=Enum.PartType.Ball tree.CanCollide=false
  end
 end
 Art.lobby()
end
function M.buildArena(newTheme)
 local arena=workspace.Arena arena:ClearAllChildren()
 local o=C.ARENA.ORIGIN
 local start=model(arena,&quot;Start&quot;)
 local p=part(start,&quot;Largada&quot;,Vector3.new(40,1,24),o-Vector3.new(0,.5,0)) p:SetAttribute(&quot;ThemeFloor&quot;,true)
 arch(start,0,&quot;LARGADA&quot;,C.COLORS.CYAN)
 for i=1,C.MAX_PLAYERS do
  local slot=part(start,&quot;Slot&quot;..i,Vector3.new(2,.1,2),o+Vector3.new(((i-1)%4-1.5)*5,.1,math.floor((i-1)/4)*4-8),C.COLORS.PURPLE,Enum.Material.Neon)
  slot.CanCollide=false slot.CanTouch=false slot.Transparency=.3 slot:SetAttribute(&quot;Index&quot;,i) CS:AddTag(slot,&quot;SpawnSlot&quot;)
 end
 local checkpoints=model(arena,&quot;Checkpoints&quot;)
 for i,z in ipairs(C.ARENA.CHECKPOINTS_Z) do
  local cp=model(checkpoints,&quot;CP&quot;..i)
  local base=part(cp,&quot;Base&quot;,Vector3.new(20,1,12),o+Vector3.new(0,-.5,z)) base:SetAttribute(&quot;ThemeFloor&quot;,true) base:SetAttribute(&quot;Index&quot;,i) CS:AddTag(base,&quot;Checkpoint&quot;)
  neon(cp,&quot;Borda&quot;,Vector3.new(20,.12,.4),o+Vector3.new(0,.1,z-6),C.COLORS.CYAN)
  part(cp,&quot;Mastro&quot;,Vector3.new(.4,9,.4),o+Vector3.new(8,4,z),C.COLORS.TEXT)
  local flag=part(cp,&quot;Bandeira&quot;,Vector3.new(3,2,.2),o+Vector3.new(6.3,7,z),C.COLORS.PURPLE) flag.CanCollide=false
  sign(cp,&quot;CHECKPOINT &quot;..i,o+Vector3.new(0,6,z+5),Vector3.new(15,3,.5),C.COLORS.CYAN)
 end
 local finish=model(arena,&quot;Finish&quot;)
 p=part(finish,&quot;Plataforma&quot;,Vector3.new(40,1,24),o+Vector3.new(0,-.5,C.ARENA.LENGTH)) p:SetAttribute(&quot;ThemeFloor&quot;,true)
 arch(finish,C.ARENA.LENGTH,&quot;CHEGADA&quot;,C.COLORS.GOLD)
 p=part(finish,&quot;Gatilho&quot;,Vector3.new(38,8,2),o+Vector3.new(0,4,C.ARENA.LENGTH),C.COLORS.GOLD) p.Transparency=1 p.CanCollide=false CS:AddTag(p,&quot;FinishLine&quot;)
 local trophy=part(finish,&quot;Trofeu&quot;,Vector3.new(4,4,4),o+Vector3.new(0,6,C.ARENA.LENGTH+7),C.COLORS.GOLD,Enum.Material.Neon) trophy.Shape=Enum.PartType.Ball trophy.CanCollide=false
 U.tween(trophy,TweenInfo.new(4,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1),{Orientation=Vector3.new(0,360,0)})
 local confetti=Instance.new(&quot;ParticleEmitter&quot;) confetti.Name=&quot;Confetti&quot; confetti.Enabled=false confetti.Rate=80 confetti.Lifetime=NumberRange.new(2,4) confetti.Speed=NumberRange.new(12,20) confetti.SpreadAngle=Vector2.new(180,180) confetti.Color=ColorSequence.new(C.COLORS.CYAN,C.COLORS.GOLD) confetti.Parent=trophy
 local walls=model(arena,&quot;Walls&quot;)
 for _,x in ipairs({-20.5,20.5}) do p=part(walls,&quot;Parede&quot;,Vector3.new(1,200,264),o+Vector3.new(x,99,120)) p.Transparency=1 p.CanTouch=false end
 p=part(walls,&quot;Teto&quot;,Vector3.new(40,1,264),o+Vector3.new(0,199,120)) p.Transparency=1 p.CanTouch=false
 p=part(walls,&quot;Queda&quot;,Vector3.new(180,1,330),o+Vector3.new(0,C.ARENA.KILL_Y,120)) p.Transparency=1 p.CanCollide=false CS:AddTag(p,&quot;KillPlane&quot;)
 for _,x in ipairs({-20,20}) do neon(walls,&quot;Guia&quot;,Vector3.new(.35,.3,264),o+Vector3.new(x,-1,120),C.COLORS.CYAN) end
 local cabin=model(arena,&quot;BuilderCabin&quot;)
 p=part(cabin,&quot;Vidro&quot;,Vector3.new(18,1,18),C.BUILDER_CABIN-Vector3.new(0,.5,0),C.COLORS.PURPLE,Enum.Material.Glass) p.Transparency=.25
 for _,x in ipairs({-8.5,8.5}) do neon(cabin,&quot;Luz&quot;,Vector3.new(.4,.3,18),C.BUILDER_CABIN+Vector3.new(x,.1,0),C.COLORS.CYAN) end
 local seat=Instance.new(&quot;Seat&quot;) seat.Name=&quot;Trono&quot; seat.Anchored=true seat.Disabled=true seat.Size=Vector3.new(4,1,4) seat.Position=C.BUILDER_CABIN+Vector3.new(0,1,0) seat.Color=C.COLORS.GOLD seat.Parent=cabin
 local decor=model(arena,&quot;Decor&quot;)
 for i=1,28 do
  local z=(i-1)*10 local x=(i%2==0 and 1 or -1)*(35+(i%5)*8)
  p=part(decor,&quot;Ilha&quot;,Vector3.new(10+i%4*3,8,12),o+Vector3.new(x,-8-i%3*3,z),C.COLORS.PURPLE) p.CanCollide=false p.CanTouch=false p.CanQuery=false p.CastShadow=false p:SetAttribute(&quot;ThemeDecor&quot;,true)
  neon(decor,&quot;Farol&quot;,Vector3.new(.5,10,.5),o+Vector3.new(x,1,z),C.COLORS.CYAN)
  if i%3==0 then local star=neon(decor,&quot;Estrela&quot;,Vector3.new(1,1,1),o+Vector3.new(x*2,40+i,z),C.COLORS.TEXT) star.Shape=Enum.PartType.Ball end
 end
 Art.arena()
 M.setTheme(newTheme or theme)
end
function M.setTheme(value)
 if not C.THEME_DATA[value] then return end theme=value local data=C.THEME_DATA[value]
 for _,p in ipairs(workspace.Arena:GetDescendants()) do if p:IsA(&quot;BasePart&quot;) then
  if p:GetAttribute(&quot;ThemeFloor&quot;) then
   U.tween(p,TweenInfo.new(2),{Color=data.floor}) p.Material=value==&quot;Gelo&quot; and Enum.Material.Ice or Enum.Material.Plastic
   p:SetAttribute(&quot;Slippery&quot;,value==&quot;Gelo&quot;) p.CustomPhysicalProperties=value==&quot;Gelo&quot; and PhysicalProperties.new(.7,.05,.5) or nil
  elseif p:GetAttribute(&quot;ThemeNeon&quot;) then U.tween(p,TweenInfo.new(2),{Color=data.neon})
  elseif p:GetAttribute(&quot;ThemeDecor&quot;) then U.tween(p,TweenInfo.new(2),{Color=data.floor}) end
 end end
 U.tween(Lighting,TweenInfo.new(2),{Ambient=data.sky,OutdoorAmbient=data.fog,ClockTime=data.ClockTime,Brightness=data.Brightness,FogColor=data.fog,FogEnd=900})
 RS.Remotes.ThemeChanged:FireAllClients(value)
end
function M.resetArena()
 workspace.PiecesActive:ClearAllChildren()
 for _,p in ipairs(CS:GetTagged(&quot;Checkpoint&quot;)) do local flag=p.Parent:FindFirstChild(&quot;Bandeira&quot;) if flag then flag.Color=C.COLORS.PURPLE end end
end
function M.getSpawnCFrames(count)
 local out={} for i=1,count do out[i]=CFrame.new(C.ARENA.ORIGIN+Vector3.new(((i-1)%4-1.5)*5,4,math.floor((i-1)/4)*4-8))*CFrame.Angles(0,math.pi,0) end return out
end
function M.getCheckpointCFrame(i)
 local z=C.ARENA.CHECKPOINTS_Z[i] or 0 return CFrame.new(C.ARENA.ORIGIN+Vector3.new(0,4,z))*CFrame.Angles(0,math.pi,0)
end
function M.getLobbySpawn() return CFrame.new(C.LOBBY.ORIGIN+Vector3.new(0,5,-5)) end
function M.getBuilderCabinCFrame() return CFrame.new(C.BUILDER_CABIN+Vector3.new(0,5,0)) end
function M.isInForbiddenZone(pos)
 local z=pos.Z-C.ARENA.ORIGIN.Z
 for _,center in ipairs({0,60,120,180,C.ARENA.LENGTH}) do if math.abs(z-center)&lt;=C.ARENA.FORBIDDEN_RADIUS then return true end end return false
end
function M.isInsideArena(p)
 local v=p-C.ARENA.ORIGIN return math.abs(v.X)&lt;=C.ARENA.WIDTH/2 and v.Z&gt;=0 and v.Z&lt;=C.ARENA.LENGTH and v.Y&gt;=-2 and v.Y&lt;=16
end
function M.getArenaBounds() local o=C.ARENA.ORIGIN return {min=o+Vector3.new(-C.ARENA.WIDTH/2,-2,0),max=o+Vector3.new(C.ARENA.WIDTH/2,16,C.ARENA.LENGTH)} end
function M.randomTheme(exclude) local list={} for _,v in ipairs(C.THEMES) do if v~=exclude then table.insert(list,v) end end return list[math.random(#list)] end
function M.celebrate() local t=workspace.Arena:FindFirstChild(&quot;Finish&quot;) local e=t and t:FindFirstChild(&quot;Confetti&quot;,true) if e then e.Enabled=true task.delay(4,function() if e.Parent then e.Enabled=false end end) end end
function M.updateLeaderboard(list)
 if not leaderboard then return end local lines={&quot;TOP 10 \u{b7} VITORIAS&quot;}
 for i,v in ipairs(list) do table.insert(lines,string.format(&quot;%d. #%d \u{b7} %d&quot;,i,v.userId,v.wins)) end leaderboard.Text=table.concat(lines,&quot;\n&quot;)
end
function M.init() M.buildLobby() M.buildArena(&quot;NeonCidade&quot;) end
return M
</ProtectedString>
