			<Item class="ModuleScript" referent="RBX00000289">
				<Properties>
					<string name="Name">AntiExploitService</string>
					<ProtectedString name="Source">-- Validacoes de colocacao estao no BuilderService; movimento no RunnerService.
-- Etapa 10: ampliar telemetria antes de publicar.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local U=require(RS.Modules.Util)
local A={}
function A.init()
 local limit=U.rateLimiter(2)
 RS.Remotes.Emote.OnServerEvent:Connect(function(p,id)
  if not limit(p) or type(id)~=&quot;string&quot; or #id&gt;16 then return end
  local Data=require(script.Parent.DataService) local d=Data.get(p)
  if d and table.find(d.owned.emotes,id) then RS.Remotes.EmoteBroadcast:FireAllClients(p.UserId,id) end
 end)
end
return A
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000028A">
				<Properties>
					<string name="Name">BuilderService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Players=game:GetService(&quot;Players&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local Map=require(script.Parent.MapService)
local Piece=require(script.Parent.PieceService)
local Runner=require(script.Parent.RunnerService)
local B={}
B.REASONS={SemEnergia=&quot;Sem energia&quot;,Cooldown=&quot;Aguarde um instante&quot;,ZonaProibida=&quot;Perto de largada/checkpoint/chegada&quot;,ForaDoMapa=&quot;Fora do mapa&quot;,Sobreposicao=&quot;Ja existe uma peca aqui&quot;,CaminhoBloqueado=&quot;Deixe passagem livre&quot;,LimiteEpica=&quot;Limite de peca epica&quot;,PecaInvalida=&quot;Peca invalida&quot;,Estado=&quot;Espere a corrida comecar&quot;}
local active=false local accounts={} local placed={} local started=0 local lastSend=0 local lastSurge=-1
local rate=U.rateLimiter(C.BUILD.REQUESTS_PER_SECOND)
local function reject(p,reason) RS.Remotes.PlaceResult:FireClient(p,false,reason) return false,reason end
local function register(p,helper)
 local max=helper and C.ENERGY.HELPER_MAX or C.ENERGY.MAX
 accounts[p]={energy=max,max=max,regen=helper and C.ENERGY.HELPER_REGEN or C.ENERGY.REGEN,last=-math.huge,epicAt=-math.huge,cooldowns={},lastPiece=nil}
 p:SetAttribute(&quot;Energy&quot;,max) p:SetAttribute(&quot;MaxEnergy&quot;,max) RS.Remotes.EnergyUpdate:FireClient(p,max,max)
end
function B.addHelper(p) if active and p.Parent and p:GetAttribute(&quot;Role&quot;)==&quot;Helper&quot; then register(p,true) end end
function B.startRound(builder) B.endRound() active=true started=os.clock() lastSurge=-1 register(builder,false) end
function B.endRound()
 active=false accounts={}
 for _,entry in ipairs(placed) do Piece.dissolve(entry.model) end placed={}
end
local function solidWidth(cf,size)
 local x=math.abs(cf.RightVector.X)*size.X+math.abs(cf.LookVector.X)*size.Z
 local z=math.abs(cf.RightVector.Z)*size.X+math.abs(cf.LookVector.Z)*size.Z
 return x,z
end
local function blocked(cf,size)
 if size.Y&lt;=1 then return false end
 local w,z=solidWidth(cf,size) local half=C.ARENA.WIDTH/2
 -- Calcula a uniao de intervalos em X por faixa, sem dupla contagem.
 for strip=0,math.ceil(C.ARENA.LENGTH/8)-1 do
  local low=strip*8 local high=low+8 local intervals={}
  local function add(c,s)
   if s.Y&lt;=1 then return end local xw,zw=solidWidth(c,s) local rel=c.Position-C.ARENA.ORIGIN
   if rel.Z+zw/2&gt;low and rel.Z-zw/2&lt;high then table.insert(intervals,{math.max(-half,rel.X-xw/2),math.min(half,rel.X+xw/2)}) end
  end
  add(cf,size)
  for _,e in ipairs(placed) do if e.model.Parent then add(e.cf,e.size) end end
  table.sort(intervals,function(a,b) return a[1]&lt;b[1] end)
  local total=0 local right=-math.huge
  for _,v in ipairs(intervals) do if v[2]&gt;right then total+=v[2]-math.max(v[1],right) right=v[2] end end
  if total&gt;C.ARENA.WIDTH*C.ARENA.MAX_BLOCK_RATIO then return true end
 end return false
end
function B.handlePlace(p,id,cf)
 if not rate(p) then return reject(p,&quot;Cooldown&quot;) end
 if type(id)~=&quot;string&quot; or #id&gt;64 or typeof(cf)~=&quot;CFrame&quot; then return reject(p,&quot;PecaInvalida&quot;) end
 for _,n in ipairs({cf:GetComponents()}) do if n~=n or math.abs(n)&gt;1000000 then return reject(p,&quot;ForaDoMapa&quot;) end end
 local a=accounts[p] local role=p:GetAttribute(&quot;Role&quot;)
 if not active or not a or (role~=&quot;Builder&quot; and role~=&quot;Helper&quot;) then return reject(p,&quot;Estado&quot;) end
 local d=Catalog.get(id) if not d or (role==&quot;Helper&quot; and not d.helper) then return reject(p,&quot;PecaInvalida&quot;) end
 local now=os.clock()
 if a.energy&lt;d.custo then return reject(p,&quot;SemEnergia&quot;) end
 if now-a.last&lt;C.ENERGY.PLACE_COOLDOWN or now-(a.cooldowns[id] or -math.huge)&lt;d.cooldown then return reject(p,&quot;Cooldown&quot;) end
 local pos=cf.Position
 if not Map.isInsideArena(pos) then return reject(p,&quot;ForaDoMapa&quot;) end
 if Map.isInForbiddenZone(pos) then return reject(p,&quot;ZonaProibida&quot;) end
 local baseY=C.ARENA.ORIGIN.Y+d.tamanho.Y/2-1
 local level=math.clamp(math.round((pos.Y-baseY)/C.BUILD.HEIGHT_STEP),0,C.BUILD.HEIGHT_LEVELS-1)
 local snapped=U.snapToGrid(Vector3.new(pos.X,0,pos.Z),C.PIECES.GRID)
 local _,yaw=cf:ToOrientation() yaw=math.round(yaw/(math.pi/2))*(math.pi/2)
 local target=CFrame.new(snapped.X,baseY+level*C.BUILD.HEIGHT_STEP,snapped.Z)*CFrame.Angles(0,yaw,0)
 local width,depth=solidWidth(target,d.tamanho) local rel=target.Position-C.ARENA.ORIGIN
 if math.abs(rel.X)+width/2&gt;C.ARENA.WIDTH/2 or rel.Z-depth/2&lt;0 or rel.Z+depth/2&gt;C.ARENA.LENGTH then return reject(p,&quot;ForaDoMapa&quot;) end
 if Map.isInForbiddenZone(target.Position) then return reject(p,&quot;ZonaProibida&quot;) end
 if (target.Position-(C.ARENA.ORIGIN+Vector3.new(0,0,C.ARENA.LENGTH/2))).Magnitude&gt;C.ARENA.LENGTH then return reject(p,&quot;ForaDoMapa&quot;) end
 local filter=OverlapParams.new() filter.FilterType=Enum.RaycastFilterType.Include filter.FilterDescendantsInstances={workspace.PiecesActive}
 if #workspace:GetPartBoundsInBox(target,d.tamanho-Vector3.new(.15,.15,.15),filter)&gt;0 then return reject(p,&quot;Sobreposicao&quot;) end
 local epics=0 for _,e in ipairs(placed) do if e.model.Parent and e.epic then epics+=1 end end
 if d.epic and (epics&gt;=C.PIECES.MAX_EPIC_ACTIVE or now-a.epicAt&lt;C.PIECES.EPIC_COOLDOWN) then return reject(p,&quot;LimiteEpica&quot;) end
 if blocked(target,d.tamanho) then return reject(p,&quot;CaminhoBloqueado&quot;) end
 -- Todas as validacoes passaram: agora modifica o estado.
 if #placed&gt;=C.PIECES.MAX_ACTIVE then local old=table.remove(placed,1) Piece.dissolve(old.model) end
 local m=Piece.spawn(id,target,p)
 a.energy-=d.custo a.last=now a.cooldowns[id]=now if d.epic then a.epicAt=now end
 local entry={model=m,owner=p,cost=d.custo,time=now,expires=now+(d.vidaUtil or C.PIECES.LIFETIME),cf=target,size=d.tamanho,epic=d.epic}
 table.insert(placed,entry) a.lastPiece=entry
 RS.Remotes.PlaceResult:FireClient(p,true,nil,m:GetAttribute(&quot;Uid&quot;)) RS.Remotes.PieceActivated:FireAllClients(id,target.Position)
 return true,m:GetAttribute(&quot;Uid&quot;)
end
function B.undo(p)
 if not rate(p) or not active then return end local a=accounts[p] local e=a and a.lastPiece
 if not e or not e.model.Parent or os.clock()-e.time&gt;C.ENERGY.UNDO_WINDOW then return reject(p,&quot;Cooldown&quot;) end
 Piece.dissolve(e.model) a.energy=math.min(a.max,a.energy+e.cost*C.ENERGY.UNDO_REFUND) a.lastPiece=nil
end
function B.init()
 RS.Remotes.PlacePiece.OnServerEvent:Connect(B.handlePlace) RS.Remotes.UndoPiece.OnServerEvent:Connect(B.undo)
 Runner.HelperCreated.Event:Connect(B.addHelper)
 Players.PlayerRemoving:Connect(function(p) accounts[p]=nil end)
 Run.Heartbeat:Connect(function(dt)
  if not active then return end local now=os.clock() local elapsed=now-started
  local cycle=math.floor(elapsed/C.ENERGY.SURGE_INTERVAL)
  local surge=cycle&gt;0 and elapsed%C.ENERGY.SURGE_INTERVAL&lt;C.ENERGY.SURGE_DURATION
  if surge and lastSurge~=cycle then
   lastSurge=cycle for p in pairs(accounts) do if p.Parent then RS.Remotes.Toast:FireClient(p,&quot;SURTO DE ENERGIA!&quot;,&quot;good&quot;) RS.Remotes.ScreenFX:FireClient(p,&quot;flash&quot;,.12) end end
  end
  local send=now-lastSend&gt;=C.BUILD.SEND_INTERVAL if send then lastSend=now end
  for p,a in pairs(accounts) do
   a.energy=math.min(a.max,a.energy+a.regen*dt*(surge and C.ENERGY.SURGE_MULTIPLIER or 1))
   if send and p.Parent and a.sent~=math.floor(a.energy*10) then
    a.sent=math.floor(a.energy*10) p:SetAttribute(&quot;Energy&quot;,a.energy) RS.Remotes.EnergyUpdate:FireClient(p,a.energy,a.max)
   end
  end
  for i=#placed,1,-1 do local e=placed[i] if now&gt;=e.expires or not e.model.Parent then Piece.dissolve(e.model) table.remove(placed,i) end end
 end)
end
return B
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000028B">
				<Properties>
					<string name="Name">CharacterService</string>
					<ProtectedString name="Source">-- Rig R6 proprio: nao depende da configuracao de avatar da experiencia.
local Players=game:GetService(&quot;Players&quot;)
local C=require(game:GetService(&quot;ReplicatedStorage&quot;).Modules.Config)
local Physics=game:GetService(&quot;PhysicsService&quot;)
local S={} local spawning={}
local function spawnCharacter(p)
 if not p.Parent or spawning[p] then return end spawning[p]=true
 local old=p.Character local m=Instance.new(&quot;Model&quot;) m.Name=p.Name
 local start=CFrame.new(C.LOBBY.ORIGIN+Vector3.new(0,5,-5))
 local function limb(name,size,offset,color,collide)
  local part=Instance.new(&quot;Part&quot;) part.Name=name part.Size=size part.CFrame=start*CFrame.new(offset) part.Color=color part.TopSurface=Enum.SurfaceType.Smooth part.BottomSurface=Enum.SurfaceType.Smooth part.CanCollide=collide part.CollisionGroup=&quot;Characters&quot; part.Parent=m return part
 end
 local skin=Color3.fromRGB(255,207,123) local blue=Color3.fromRGB(40,114,232) local green=Color3.fromRGB(73,133,75)
 local root=limb(&quot;HumanoidRootPart&quot;,Vector3.new(2,2,1),Vector3.zero,blue,false) root.Transparency=1
 local torso=limb(&quot;Torso&quot;,Vector3.new(2,2,1),Vector3.zero,blue,true)
 local head=limb(&quot;Head&quot;,Vector3.new(2,1,1),Vector3.new(0,1.5,0),skin,false)
 local ra=limb(&quot;Right Arm&quot;,Vector3.new(1,2,1),Vector3.new(1.5,0,0),skin,false)
 local la=limb(&quot;Left Arm&quot;,Vector3.new(1,2,1),Vector3.new(-1.5,0,0),skin,false)
 local rl=limb(&quot;Right Leg&quot;,Vector3.new(1,2,1),Vector3.new(.5,-2,0),green,false)
 local ll=limb(&quot;Left Leg&quot;,Vector3.new(1,2,1),Vector3.new(-.5,-2,0),green,false)
 for _,part in ipairs({head,torso,ra,la,rl,ll}) do part.Massless=true end
 local function motor(name,a,b,c0,c1) local j=Instance.new(&quot;Motor6D&quot;) j.Name=name j.Part0=a j.Part1=b j.C0=CFrame.new(c0) j.C1=CFrame.new(c1) j.Parent=a end
 motor(&quot;RootJoint&quot;,root,torso,Vector3.zero,Vector3.zero)
 motor(&quot;Neck&quot;,torso,head,Vector3.new(0,1,0),Vector3.new(0,-.5,0))
 motor(&quot;Right Shoulder&quot;,torso,ra,Vector3.new(1.5,.5,0),Vector3.new(0,.5,0)) motor(&quot;Left Shoulder&quot;,torso,la,Vector3.new(-1.5,.5,0),Vector3.new(0,.5,0))
 motor(&quot;Right Hip&quot;,torso,rl,Vector3.new(.5,-1,0),Vector3.new(0,1,0)) motor(&quot;Left Hip&quot;,torso,ll,Vector3.new(-.5,-1,0),Vector3.new(0,1,0))
 -- Rosto desenhado com UI, sem dependencia de asset.
 local gui=Instance.new(&quot;SurfaceGui&quot;) gui.Name=&quot;Rosto&quot; gui.Face=Enum.NormalId.Front gui.CanvasSize=Vector2.new(160,80) gui.Parent=head
 local function facePart(name,x,y,w,h)
  local f=Instance.new(&quot;Frame&quot;) f.Name=name f.Position=UDim2.fromOffset(x,y) f.Size=UDim2.fromOffset(w,h) f.BackgroundColor3=Color3.fromRGB(40,34,31) f.BorderSizePixel=0 f.Parent=gui return f
 end
 for _,x in ipairs({45,105}) do local eye=facePart(&quot;Olho&quot;,x,20,10,10) local c=Instance.new(&quot;UICorner&quot;) c.CornerRadius=UDim.new(1,0) c.Parent=eye end
 facePart(&quot;Sorriso&quot;,50,56,60,5) facePart(&quot;Sorriso&quot;,45,47,6,10) facePart(&quot;Sorriso&quot;,109,47,6,10)

 local h=Instance.new(&quot;Humanoid&quot;) h.Name=&quot;Humanoid&quot; h.RigType=Enum.HumanoidRigType.R6 h.HipHeight=0 h.WalkSpeed=C.RUNNER.WALKSPEED h.UseJumpPower=true h.JumpPower=C.RUNNER.JUMPPOWER h.DisplayName=p.DisplayName h.Parent=m
 local animator=Instance.new(&quot;Animator&quot;) animator.Parent=h
 m.PrimaryPart=root m.Parent=workspace p.Character=m if old then old:Destroy() end
 spawning[p]=nil
 h.Died:Connect(function() task.delay(3,function() if p.Parent and p.Character==m then spawnCharacter(p) end end) end)
end
function S.init()
 pcall(function() Physics:RegisterCollisionGroup(&quot;Characters&quot;) end)
 Physics:CollisionGroupSetCollidable(&quot;Characters&quot;,&quot;Characters&quot;,false)
 Players.CharacterAutoLoads=false
 Players.PlayerAdded:Connect(function(p) task.defer(spawnCharacter,p) end)
 Players.PlayerRemoving:Connect(function(p) spawning[p]=nil end)
 for _,p in ipairs(Players:GetPlayers()) do task.defer(spawnCharacter,p) end
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000028C">
				<Properties>
					<string name="Name">CosmeticService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Players=game:GetService(&quot;Players&quot;)
local Data=require(script.Parent.DataService)
local Catalog=require(RS.Modules.CosmeticCatalog)
local U=require(RS.Modules.Util)
local S={}
local function apply(p)
 local d=Data.get(p) local torso=p.Character and p.Character:FindFirstChild(&quot;Torso&quot;)
 if not d or not torso then return end
 for _,c in ipairs(Catalog) do if d.equipped.shirt==c.id then torso.Color=c.color break end end
end
function S.init()
 local limit=U.rateLimiter(2)
 RS.Remotes.BuyCosmetic.OnServerEvent:Connect(function(p,id)
  if not limit(p) or type(id)~=&quot;string&quot; or #id&gt;32 then return end
  local choice=nil for _,c in ipairs(Catalog) do if c.id==id then choice=c break end end if not choice then return end
  local granted=false
  Data.update(p,function(d)
   d.owned.shirts=d.owned.shirts or {}
   if not table.find(d.owned.shirts,id) then
    if d.coins&lt;choice.cost then return end
    d.coins-=choice.cost table.insert(d.owned.shirts,id)
   end
   d.equipped.shirt=id granted=true
  end)
  if granted then apply(p) Data.addCoins(p,0) RS.Remotes.Toast:FireClient(p,&quot;Camisa equipada!&quot;,&quot;good&quot;) else RS.Remotes.Toast:FireClient(p,&quot;Moedas insuficientes.&quot;,&quot;warn&quot;) end
 end)
 local function add(p)
  p.CharacterAdded:Connect(function(char) char:WaitForChild(&quot;Torso&quot;,10) Data.waitForData(p,25) if p.Character==char then apply(p) end end)
  task.spawn(function() Data.waitForData(p,25) apply(p) end)
 end
 Players.PlayerAdded:Connect(add) for _,p in ipairs(Players:GetPlayers()) do add(p) end
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000028D">
				<Properties>
					<string name="Name">DataService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local DSS=game:GetService(&quot;DataStoreService&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Http=game:GetService(&quot;HttpService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Settings=require(RS.Modules.Settings)
local D={}
local defaults={version=1,coins=0,xp=0,level=1,stats={winsRunner=0,winsBuilder=0,rounds=0,eliminations=0,timePlayed=0,bestPlace=0,timesBuilder=0},settings=Settings.DEFAULTS,owned={trails={},effects={},cabins={},emotes={&quot;Emote1&quot;}},equipped={},tutorialDone=false}
local cache,meta,ready={},{},{}
local store=DSS:GetDataStore(&quot;PlayerData_v1&quot;)
local session=Http:GenerateGUID(false)
local R=RS:WaitForChild(&quot;Remotes&quot;)
local memoryOnly=Run:IsStudio() and game.GameId==0
local function reconcile(old,template)
 local out=type(old)==&quot;table&quot; and U.deepCopy(old) or {}
 for k,v in pairs(template) do if type(v)==&quot;table&quot; then out[k]=reconcile(out[k],v) elseif type(out[k])~=type(v) then out[k]=v end end
 out._session=nil return out
end
local function retry(fn)
 for i=1,C.DATA.RETRIES do local ok,result=pcall(fn) if ok then return true,result end if i&lt;C.DATA.RETRIES then task.wait(2^(i-1)) end end
 return false,nil
end
local function push(p)
 if p.Parent and cache[p] then R.SettingsLoad:FireClient(p,cache[p].settings) R.StatsUpdate:FireClient(p,{stats=cache[p].stats,coins=cache[p].coins,xp=cache[p].xp,level=cache[p].level}) end
end
local function load(p)
 local data,loaded=nil,false
 if not memoryOnly then
  local ok,result=retry(function()
   return store:UpdateAsync(&quot;Player_&quot;..p.UserId,function(old)
    if type(old)==&quot;table&quot; and type(old._session)==&quot;table&quot; and old._session.id~=session and (old._session.expires or 0)&gt;os.time() then return nil end
    local new=reconcile(old,defaults) new._session={id=session,expires=os.time()+C.DATA.SESSION_TTL} return new
   end)
  end)
  if ok and type(result)==&quot;table&quot; then data=result loaded=true end
 end
 if not p.Parent then
  if loaded then retry(function() return store:UpdateAsync(&quot;Player_&quot;..p.UserId,function(old) if old and old._session and old._session.id==session then old._session=nil return old end return nil end) end) end
  return
 end
 cache[p]=reconcile(data,defaults) cache[p].settings=Settings.validate(cache[p].settings)
 meta[p]={noSave=not loaded,busy=false,leaving=false,joined=os.clock()}
 if ready[p] then push(p) end
 if not loaded and not memoryOnly then R.Toast:FireClient(p,&quot;Dados temporarios: esta sessao nao sera salva.&quot;,&quot;warn&quot;) end
end
function D.get(p) return cache[p] end
function D.waitForData(p,timeout) local endAt=os.clock()+(timeout or 25) repeat if cache[p] then return cache[p] end task.wait(.1) until not p.Parent or os.clock()&gt;endAt return nil end
function D.update(p,fn)
 if not cache[p] then return false end
 local copy=U.deepCopy(cache[p]) local ok,err=pcall(fn,copy)
 if not ok then warn(&quot;[DataService] &quot;..tostring(err)) return false end cache[p]=copy return true
end
function D.save(p,release)
 local m=meta[p] if not m or m.noSave or m.busy then return false end m.busy=true
 local data=U.deepCopy(cache[p]) data.stats.timePlayed+=math.floor(os.clock()-m.joined) m.joined=os.clock() cache[p].stats.timePlayed=data.stats.timePlayed
 local accepted=false
 local ok=retry(function()
  accepted=false
  return store:UpdateAsync(&quot;Player_&quot;..p.UserId,function(old)
   if not old or not old._session or old._session.id~=session then return nil end
   local snapshot=U.deepCopy(data)
   if not release then snapshot._session={id=session,expires=os.time()+C.DATA.SESSION_TTL} end
   accepted=true return snapshot
  end)
 end)
 m.busy=false
 if ok and not accepted then m.noSave=true if p.Parent then R.Toast:FireClient(p,&quot;Outra sessao assumiu os dados. Esta sessao nao sera salva.&quot;,&quot;warn&quot;) end end
 if not ok and p.Parent and not m.warned then m.warned=true R.Toast:FireClient(p,&quot;Falha temporaria ao salvar. Tentaremos novamente.&quot;,&quot;warn&quot;) end
 if ok and accepted then m.warned=false end
 return ok and accepted
end
function D.addCoins(p,n) if D.update(p,function(d) d.coins=math.max(0,d.coins+math.round(n)) end) then push(p) end end
function D.addXp(p,n)
 if D.update(p,function(d)
  d.xp=math.max(0,d.xp+math.round(n)) local level=1 local need=100 local remaining=d.xp
  while remaining&gt;=need do remaining-=need level+=1 need=100+(level-1)*50 end d.level=level
 end) then push(p) end
end
function D.setSettings(p,s) if D.update(p,function(d) d.settings=Settings.validate(s) end) then push(p) end end
function D.isPersistent(p) return meta[p] and not meta[p].noSave end
function D.init()
 local readyLimit=U.rateLimiter(2) local settingsLimit=U.rateLimiter(2) local getLimit=U.rateLimiter(3)
 R.ReadyForData.OnServerEvent:Connect(function(p) if readyLimit(p) then ready[p]=true push(p) end end)
 R.SaveSettings.OnServerEvent:Connect(function(p,s) if settingsLimit(p) and type(s)==&quot;table&quot; then D.setSettings(p,s) end end)
 R.GetPlayerData.OnServerInvoke=function(p)
  if not getLimit(p) then return nil end local d=cache[p] if not d then return nil end
  return {stats=U.deepCopy(d.stats),settings=U.deepCopy(d.settings),coins=d.coins,level=d.level,xp=d.xp,owned=U.deepCopy(d.owned)}
 end
 Players.PlayerAdded:Connect(function(p) task.spawn(load,p) end)
 for _,p in ipairs(Players:GetPlayers()) do task.spawn(load,p) end
 Players.PlayerRemoving:Connect(function(p)
  local m=meta[p] if m then m.leaving=true while m.busy do task.wait(.1) end D.save(p,true) end
  cache[p]=nil meta[p]=nil ready[p]=nil
 end)
 task.spawn(function() while true do task.wait(C.DATA.AUTOSAVE) for p,m in pairs(meta) do if p.Parent and not m.leaving then task.spawn(D.save,p,false) end end end end)
 game:BindToClose(function()
  local count=0
  for p,m in pairs(meta) do if not m.leaving then count+=1 task.spawn(function() while m.busy do task.wait(.1) end D.save(p,true) count-=1 end) end end
  local deadline=os.clock()+25 while count&gt;0 and os.clock()&lt;deadline do task.wait(.1) end
 end)
end
return D
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000028E">
				<Properties>
					<string name="Name">MapService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local CS=game:GetService(&quot;CollectionService&quot;)
local Lighting=game:GetService(&quot;Lighting&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Art=require(RS.Modules.MapArt)
local M={} local theme=&quot;NeonCidade&quot; local leaderboard=nil
local function model(parent,name) local m=Instance.new(&quot;Model&quot;) m.Name=name m.Parent=parent return m end
local function part(parent,name,size,pos,color,material)
 return U.makePart({Parent=parent,Name=name,Size=size,Position=pos,Color=color or C.COLORS.BACKGROUND,Material=material or Enum.Material.Plastic})
end
local function sign(parent,text,pos,size,color)
 local p=part(parent,&quot;Placa&quot;,size or Vector3.new(25,7,1),pos,C.COLORS.BACKGROUND)
 local g=Instance.new(&quot;SurfaceGui&quot;) g.Face=Enum.NormalId.Front g.SizingMode=Enum.SurfaceGuiSizingMode.PixelsPerStud g.PixelsPerStud=35 g.Parent=p
 local l=Instance.new(&quot;TextLabel&quot;) l.Size=UDim2.fromScale(1,1) l.BackgroundTransparency=1 l.Text=text l.TextColor3=color or C.COLORS.TEXT l.TextScaled=true l.Font=Enum.Font.FredokaOne l.Parent=g
 local pad=Instance.new(&quot;UIPadding&quot;) pad.PaddingLeft=UDim.new(0,12) pad.PaddingRight=UDim.new(0,12) pad.PaddingTop=UDim.new(0,10) pad.PaddingBottom=UDim.new(0,10) pad.Parent=l
 return l
end
local function neon(parent,name,size,pos,color)
 local p=part(parent,name,size,pos,color,Enum.Material.Neon) p.CanCollide=false p.CanTouch=false p.CanQuery=false p.CastShadow=false p:SetAttribute(&quot;ThemeNeon&quot;,true) return p
end
local function arch(parent,z,text,color)
 for _,x in ipairs({-18,18}) do neon(parent,&quot;Pilar&quot;,Vector3.new(1,13,1),C.ARENA.ORIGIN+Vector3.new(x,6,z),color) end
 neon(parent,&quot;Arco&quot;,Vector3.new(37,1,1),C.ARENA.ORIGIN+Vector3.new(0,12,z),color)
 sign(parent,text,C.ARENA.ORIGIN+Vector3.new(0,9,z),Vector3.new(28,4,1),color)
end
function M.buildLobby()
 local folder=workspace.Lobby folder:ClearAllChildren()
 local root=model(folder,&quot;Praca&quot;) local o=C.LOBBY.ORIGIN
 local floor=part(root,&quot;PracaCircular&quot;,Vector3.new(2,60,60),o-Vector3.new(0,1,0),Color3.fromRGB(28,30,60)) floor.Shape=Enum.PartType.Cylinder floor.Orientation=Vector3.new(0,0,90)
 for i=1,36 do local a=i*math.pi/18 local p=neon(root,&quot;Anel&quot;,Vector3.new(5.3,.25,.65),o+Vector3.new(math.cos(a)*29,.12,math.sin(a)*29),C.COLORS.CYAN) p.Orientation=Vector3.new(0,-math.deg(a)-90,0) end
 local spawn=Instance.new(&quot;SpawnLocation&quot;) spawn.Name=&quot;LobbySpawn&quot; spawn.Size=Vector3.new(8,1,8) spawn.Position=o+Vector3.new(0,.1,0) spawn.Anchored=true spawn.Neutral=true spawn.Duration=0 spawn.Material=Enum.Material.Neon spawn.Color=C.COLORS.PURPLE spawn.Parent=root
 sign(root,&quot;CONSTRUTOR\nVS CORREDORES&quot;,o+Vector3.new(0,13,22),Vector3.new(38,9,1),C.COLORS.CYAN)
 sign(root,&quot;COMO JOGAR\n1 \u{b7} Corra e salte entre plataformas\n2 \u{b7} Construa usando energia\n3 \u{b7} Alcance a chegada!&quot;,o+Vector3.new(-17,7,10),Vector3.new(15,10,1))
 leaderboard=sign(root,&quot;TOP 10\nVitorias globais\nDados apos publicar&quot;,o+Vector3.new(17,7,10),Vector3.new(14,10,1),C.COLORS.GOLD)
 sign(root,&quot;TESTE COM 2 JOGADORES\nQ \u{b7} Dash   |   R \u{b7} Girar   |   Z \u{b7} Desfazer&quot;,o+Vector3.new(0,4,-22),Vector3.new(31,5,1),C.COLORS.TEXT)
 for _,x in ipairs({-22,22}) do
  part(root,&quot;Banco&quot;,Vector3.new(8,1.5,3),o+Vector3.new(x,1,-7),C.COLORS.PURPLE)
  for _,z in ipairs({-16,17}) do
   part(root,&quot;Vaso&quot;,Vector3.new(3,3,3),o+Vector3.new(x,1,z),C.COLORS.GOLD)
   local tree=part(root,&quot;Planta&quot;,Vector3.new(5,6,5),o+Vector3.new(x,5,z),C.COLORS.SUCCESS) tree.Shape=Enum.PartType.Ball tree.CanCollide=false
  end
 end
 Art.lobby()
 require(RS.Modules.WorldContent).lobby()
end
function M.buildArena(newTheme)
 local arena=workspace.Arena arena:ClearAllChildren()
 local o=C.ARENA.ORIGIN
 local start=model(arena,&quot;Start&quot;)
 local p=part(start,&quot;Largada&quot;,Vector3.new(40,1,24),o-Vector3.new(0,.5,0)) p:SetAttribute(&quot;ThemeFloor&quot;,true)
 arch(start,0,&quot;LARGADA&quot;,C.COLORS.CYAN)
 for i=1,C.MAX_PLAYERS do
  local slot=part(start,&quot;Slot&quot;..i,Vector3.new(2,.1,2),o+Vector3.new(((i-1)%4-1.5)*5,.1,math.floor((i-1)/4)*4-8),C.COLORS.PURPLE,Enum.Material.Neon)
  slot.CanCollide=false slot.CanTouch=false slot.Transparency=.3 slot:SetAttribute(&quot;Index&quot;,i) CS:AddTag(slot,&quot;SpawnSlot&quot;)
 end
 local checkpoints=model(arena,&quot;Checkpoints&quot;)
 for i,z in ipairs(C.ARENA.CHECKPOINTS_Z) do
  local cp=model(checkpoints,&quot;CP&quot;..i)
  local base=part(cp,&quot;Base&quot;,Vector3.new(20,1,12),o+Vector3.new(0,-.5,z)) base:SetAttribute(&quot;ThemeFloor&quot;,true) base:SetAttribute(&quot;Index&quot;,i) CS:AddTag(base,&quot;Checkpoint&quot;)
  neon(cp,&quot;Borda&quot;,Vector3.new(20,.12,.4),o+Vector3.new(0,.1,z-6),C.COLORS.CYAN)
  part(cp,&quot;Mastro&quot;,Vector3.new(.4,9,.4),o+Vector3.new(8,4,z),C.COLORS.TEXT)
  local flag=part(cp,&quot;Bandeira&quot;,Vector3.new(3,2,.2),o+Vector3.new(6.3,7,z),C.COLORS.PURPLE) flag.CanCollide=false
  sign(cp,&quot;CHECKPOINT &quot;..i,o+Vector3.new(0,6,z+5),Vector3.new(15,3,.5),C.COLORS.CYAN)
 end
 local finish=model(arena,&quot;Finish&quot;)
 p=part(finish,&quot;Plataforma&quot;,Vector3.new(40,1,24),o+Vector3.new(0,-.5,C.ARENA.LENGTH)) p:SetAttribute(&quot;ThemeFloor&quot;,true)
 arch(finish,C.ARENA.LENGTH,&quot;CHEGADA&quot;,C.COLORS.GOLD)
 p=part(finish,&quot;Gatilho&quot;,Vector3.new(38,8,2),o+Vector3.new(0,4,C.ARENA.LENGTH),C.COLORS.GOLD) p.Transparency=1 p.CanCollide=false CS:AddTag(p,&quot;FinishLine&quot;)
 local trophy=part(finish,&quot;Trofeu&quot;,Vector3.new(4,4,4),o+Vector3.new(0,6,C.ARENA.LENGTH+7),C.COLORS.GOLD,Enum.Material.Neon) trophy.Shape=Enum.PartType.Ball trophy.CanCollide=false
 U.tween(trophy,TweenInfo.new(4,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1),{Orientation=Vector3.new(0,360,0)})
 local confetti=Instance.new(&quot;ParticleEmitter&quot;) confetti.Name=&quot;Confetti&quot; confetti.Enabled=false confetti.Rate=80 confetti.Lifetime=NumberRange.new(2,4) confetti.Speed=NumberRange.new(12,20) confetti.SpreadAngle=Vector2.new(180,180) confetti.Color=ColorSequence.new(C.COLORS.CYAN,C.COLORS.GOLD) confetti.Parent=trophy
 local walls=model(arena,&quot;Walls&quot;)
 for _,x in ipairs({-20.5,20.5}) do p=part(walls,&quot;Parede&quot;,Vector3.new(1,200,264),o+Vector3.new(x,99,120)) p.Transparency=1 p.CanTouch=false end
 p=part(walls,&quot;Teto&quot;,Vector3.new(40,1,264),o+Vector3.new(0,199,120)) p.Transparency=1 p.CanTouch=false
 p=part(walls,&quot;Queda&quot;,Vector3.new(180,1,330),o+Vector3.new(0,C.ARENA.KILL_Y,120)) p.Transparency=1 p.CanCollide=false CS:AddTag(p,&quot;KillPlane&quot;)
 for _,x in ipairs({-20,20}) do neon(walls,&quot;Guia&quot;,Vector3.new(.35,.3,264),o+Vector3.new(x,-1,120),C.COLORS.CYAN) end
 local cabin=model(arena,&quot;BuilderCabin&quot;)
 p=part(cabin,&quot;Vidro&quot;,Vector3.new(18,1,18),C.BUILDER_CABIN-Vector3.new(0,.5,0),C.COLORS.PURPLE,Enum.Material.Glass) p.Transparency=.25
 for _,x in ipairs({-8.5,8.5}) do neon(cabin,&quot;Luz&quot;,Vector3.new(.4,.3,18),C.BUILDER_CABIN+Vector3.new(x,.1,0),C.COLORS.CYAN) end
 local seat=Instance.new(&quot;Seat&quot;) seat.Name=&quot;Trono&quot; seat.Anchored=true seat.Disabled=true seat.Size=Vector3.new(4,1,4) seat.Position=C.BUILDER_CABIN+Vector3.new(0,1,0) seat.Color=C.COLORS.GOLD seat.Parent=cabin
 local decor=model(arena,&quot;Decor&quot;)
 for i=1,28 do
  local z=(i-1)*10 local x=(i%2==0 and 1 or -1)*(35+(i%5)*8)
  p=part(decor,&quot;Ilha&quot;,Vector3.new(10+i%4*3,8,12),o+Vector3.new(x,-8-i%3*3,z),C.COLORS.PURPLE) p.CanCollide=false p.CanTouch=false p.CanQuery=false p.CastShadow=false p:SetAttribute(&quot;ThemeDecor&quot;,true)
  neon(decor,&quot;Farol&quot;,Vector3.new(.5,10,.5),o+Vector3.new(x,1,z),C.COLORS.CYAN)
  if i%3==0 then local star=neon(decor,&quot;Estrela&quot;,Vector3.new(1,1,1),o+Vector3.new(x*2,40+i,z),C.COLORS.TEXT) star.Shape=Enum.PartType.Ball end
 end
 Art.arena()
 require(RS.Modules.WorldContent).build(newTheme or theme)
 M.setTheme(newTheme or theme)
end
function M.setTheme(value)
 if not C.THEME_DATA[value] then return end theme=value local data=C.THEME_DATA[value]
 for _,p in ipairs(workspace.Arena:GetDescendants()) do if p:IsA(&quot;BasePart&quot;) then
  if p:GetAttribute(&quot;ThemeFloor&quot;) then
   U.tween(p,TweenInfo.new(2),{Color=data.floor}) p.Material=value==&quot;Gelo&quot; and Enum.Material.Ice or Enum.Material.Plastic
   p:SetAttribute(&quot;Slippery&quot;,value==&quot;Gelo&quot;) p.CustomPhysicalProperties=value==&quot;Gelo&quot; and PhysicalProperties.new(.7,.05,.5) or nil
  elseif p:GetAttribute(&quot;ThemeNeon&quot;) then U.tween(p,TweenInfo.new(2),{Color=data.neon})
  elseif p:GetAttribute(&quot;ThemeDecor&quot;) then U.tween(p,TweenInfo.new(2),{Color=data.floor}) end
 end end
 U.tween(Lighting,TweenInfo.new(2),{Ambient=data.sky,OutdoorAmbient=data.fog,ClockTime=data.ClockTime,Brightness=data.Brightness,FogColor=data.fog,FogEnd=900})
 RS.Remotes.ThemeChanged:FireAllClients(value)
end
function M.resetArena()
 workspace.PiecesActive:ClearAllChildren()
 for _,p in ipairs(CS:GetTagged(&quot;Checkpoint&quot;)) do local flag=p.Parent:FindFirstChild(&quot;Bandeira&quot;) if flag then flag.Color=C.COLORS.PURPLE end end
end
function M.getSpawnCFrames(count)
 local out={} for i=1,count do out[i]=CFrame.new(C.ARENA.ORIGIN+Vector3.new(((i-1)%4-1.5)*5,4,math.floor((i-1)/4)*4-8))*CFrame.Angles(0,math.pi,0) end return out
end
function M.getCheckpointCFrame(i)
 local z=C.ARENA.CHECKPOINTS_Z[i] or 0 return CFrame.new(C.ARENA.ORIGIN+Vector3.new(0,4,z))*CFrame.Angles(0,math.pi,0)
end
function M.getLobbySpawn() return CFrame.new(C.LOBBY.ORIGIN+Vector3.new(0,5,-5)) end
function M.getBuilderCabinCFrame() return CFrame.new(C.BUILDER_CABIN+Vector3.new(0,5,0)) end
function M.isInForbiddenZone(pos)
 local z=pos.Z-C.ARENA.ORIGIN.Z
 for _,center in ipairs({0,60,120,180,C.ARENA.LENGTH}) do if math.abs(z-center)&lt;=C.ARENA.FORBIDDEN_RADIUS then return true end end return false
end
function M.isInsideArena(p)
 local v=p-C.ARENA.ORIGIN return math.abs(v.X)&lt;=C.ARENA.WIDTH/2 and v.Z&gt;=0 and v.Z&lt;=C.ARENA.LENGTH and v.Y&gt;=-2 and v.Y&lt;=16
end
function M.getArenaBounds() local o=C.ARENA.ORIGIN return {min=o+Vector3.new(-C.ARENA.WIDTH/2,-2,0),max=o+Vector3.new(C.ARENA.WIDTH/2,16,C.ARENA.LENGTH)} end
function M.randomTheme(exclude) local list={} for _,v in ipairs(C.THEMES) do if v~=exclude then table.insert(list,v) end end return list[math.random(#list)] end
function M.celebrate() local t=workspace.Arena:FindFirstChild(&quot;Finish&quot;) local e=t and t:FindFirstChild(&quot;Confetti&quot;,true) if e then e.Enabled=true task.delay(4,function() if e.Parent then e.Enabled=false end end) end end
function M.updateLeaderboard(list)
 if not leaderboard then return end local lines={&quot;TOP 10 \u{b7} VITORIAS&quot;}
 for i,v in ipairs(list) do table.insert(lines,string.format(&quot;%d. #%d \u{b7} %d&quot;,i,v.userId,v.wins)) end leaderboard.Text=table.concat(lines,&quot;\n&quot;)
end
function M.init() M.buildLobby() M.buildArena(&quot;NeonCidade&quot;) end
return M
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX0000028F">
				<Properties>
					<string name="Name">PassService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local Marketplace=game:GetService(&quot;MarketplaceService&quot;)
local Catalog=require(game:GetService(&quot;ReplicatedStorage&quot;).Modules.PassCatalog)
local S={}
local function cosmetics(p)
 local char=p.Character local root=char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)
 if not root then return end
 local old=root:FindFirstChild(&quot;PassCosmetics&quot;) if old then old:Destroy() end
 local folder=Instance.new(&quot;Folder&quot;) folder.Name=&quot;PassCosmetics&quot; folder.Parent=root
 if p:GetAttribute(&quot;PassVIP&quot;) then
  local gui=Instance.new(&quot;BillboardGui&quot;) gui.Size=UDim2.fromOffset(140,28) gui.StudsOffset=Vector3.new(0,3.8,0) gui.AlwaysOnTop=true gui.Parent=folder gui.Adornee=root
  local text=Instance.new(&quot;TextLabel&quot;) text.Size=UDim2.fromScale(1,1) text.BackgroundTransparency=1 text.Text=&quot;\u{2605} VIP \u{b7} &quot;..p.DisplayName text.Font=Enum.Font.GothamBold text.TextColor3=Color3.fromRGB(255,204,69) text.TextSize=14 text.Parent=gui
 end
 if p:GetAttribute(&quot;PassVIP&quot;) or p:GetAttribute(&quot;PassNeon&quot;) then
  local a=Instance.new(&quot;Attachment&quot;) a.Position=Vector3.new(0,.7,0) a.Parent=folder
  local b=Instance.new(&quot;Attachment&quot;) b.Position=Vector3.new(0,-.7,0) b.Parent=folder
  -- Attachments precisam ser filhos de BasePart para seguir o personagem.
  a.Parent=root b.Parent=root a.Name=&quot;PassTrailA&quot; b.Name=&quot;PassTrailB&quot;
  for _,v in ipairs(root:GetChildren()) do if (v.Name==&quot;PassTrailA&quot; and v~=a) or (v.Name==&quot;PassTrailB&quot; and v~=b) then v:Destroy() end end
  local t=Instance.new(&quot;Trail&quot;) t.Attachment0=a t.Attachment1=b t.Lifetime=.45 t.MinLength=.1 t.FaceCamera=true
  t.Color=p:GetAttribute(&quot;PassNeon&quot;) and ColorSequence.new(Color3.fromRGB(39,224,255),Color3.fromRGB(147,87,204)) or ColorSequence.new(Color3.fromRGB(255,204,69)) t.Parent=folder
 end
end
local function refresh(p,onlyId)
 for _,d in ipairs(Catalog) do
  if d.id&gt;0 and (not onlyId or onlyId==d.id) then
   local ok,owned=pcall(Marketplace.UserOwnsGamePassAsync,Marketplace,p.UserId,d.id)
   if ok and p.Parent then p:SetAttribute(d.attribute,owned) end
  end
 end
 if p.Parent then cosmetics(p) end
end
function S.init()
 local function added(p)
  p.CharacterAdded:Connect(function(char) char:WaitForChild(&quot;HumanoidRootPart&quot;,10) if p.Character==char then cosmetics(p) end end)
  task.spawn(refresh,p)
 end
 Players.PlayerAdded:Connect(added) for _,p in ipairs(Players:GetPlayers()) do added(p) end
 Marketplace.PromptGamePassPurchaseFinished:Connect(function(p,id,purchased)
  if not purchased then return end
  for _,d in ipairs(Catalog) do if d.id==id and id&gt;0 then task.delay(2,function() refresh(p,id) end) break end end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000290">
				<Properties>
					<string name="Name">PieceService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local CS=game:GetService(&quot;CollectionService&quot;)
local Http=game:GetService(&quot;HttpService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local Tween=game:GetService(&quot;TweenService&quot;)
local U=require(RS.Modules.Util)
local C=require(RS.Modules.Config)
local Catalog=require(RS.Modules.PieceCatalog)
local Art=require(RS.Modules.ModelArt)
local P={} local entries={} local clock=0
local danger={Serra=true,Espinhos=true,EspinhosEscondidos=true,Laser=true,Pendulo=true,Lava=true}
function P.spawn(id,cf,owner)
 local d=Catalog.get(id) local m=Art.spawn(id,cf,workspace.PiecesActive)
 local now=os.clock()
 for k,v in pairs({PieceId=id,Uid=Http:GenerateGUID(false),OwnerUserId=owner.UserId,PlacedAt=now,ExpiresAt=now+d.vidaUtil,Armed=false,Epic=d.epic}) do m:SetAttribute(k,v) end
 local block=U.makePart({Name=&quot;Colisao&quot;,Size=d.tamanho,CFrame=cf,Transparency=1,CanQuery=true,Color=d.cor,Parent=m})
 block.CanTouch=false
 if danger[id] or id==&quot;PortalTroll&quot; or id==&quot;ParedeFantasma&quot; or id==&quot;BombaRelogio&quot; then block.CanCollide=false end
 if id==&quot;BlocoEscorregadio&quot; then block.CustomPhysicalProperties=PhysicalProperties.new(.7,.02,0) end
 if id==&quot;ParedeFantasma&quot; then for _,v in ipairs(m:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) and v~=block then v.Transparency=.5 end end end
 if id==&quot;BlocoEscorregadio&quot; then for _,v in ipairs(m:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) and v.Name==&quot;Base&quot; then v.Material=Enum.Material.Ice v.Transparency=.15 end end end
 m.PrimaryPart=block CS:AddTag(m,&quot;Piece&quot;)
 local e={m=m,id=id,cf=cf,d=d,at=now,owner=owner,cool={},armedAt=now+C.PIECES.WARNING_TIME}
 e.sawParts={}
 if id==&quot;Serra&quot; then for _,part in ipairs(m:GetDescendants()) do if part:IsA(&quot;BasePart&quot;) and (part.Name==&quot;Disco de corte&quot; or part.Name==&quot;Dente&quot; or part.Name==&quot;Miolo&quot;) then table.insert(e.sawParts,{part=part,cf=part.CFrame}) end end end
 entries[m]=e
 -- Portais tem entrada e saida deterministicas, visiveis e dentro da arena.
 if id==&quot;PortalTroll&quot; then
  local z=math.clamp(cf.Position.Z+16,16,C.ARENA.LENGTH-16)
  e.exit=CFrame.new(cf.Position.X,cf.Position.Y,z)
  local exit=Art.spawn(id,e.exit,m) exit.Name=&quot;SaidaPortal&quot;
 end
 return m
end
function P.dissolve(m) entries[m]=nil if m and m.Parent then m:Destroy() end end
local function flash(m,on)
 for _,p in ipairs(m:GetDescendants()) do if p:IsA(&quot;BasePart&quot;) and p.Name~=&quot;Colisao&quot; then p.Transparency=on and .55 or 0 end end
end
function P.init()
 local folder=RS:FindFirstChild(&quot;Pieces&quot;)
 for _,d in ipairs(Catalog.list()) do if not folder:FindFirstChild(d.id) then Art.spawn(d.id,CFrame.new(),folder) end end
 local Runner=require(script.Parent.RunnerService)
 Run.Heartbeat:Connect(function(dt)
  clock+=dt if clock&lt;.1 then return end local step=clock clock=0
  local now=os.clock() local alive=Runner.getAlive()
  for m,e in pairs(entries) do
   if not m.Parent then entries[m]=nil continue end
   local t=now-e.at local id=e.id
   local armed=now&gt;=e.armedAt and not e.fell
   if id==&quot;EspinhosEscondidos&quot; then armed=armed and (t%5&gt;=2) end
   if id==&quot;Laser&quot; then armed=armed and (t%4&gt;=1.5) end
   m:SetAttribute(&quot;Armed&quot;,armed)
   if id==&quot;Serra&quot; then for _,r in ipairs(e.sawParts) do r.part.CFrame=r.cf+e.cf.LookVector*(math.sin(t*1.5)*4) end end
   if id==&quot;PlataformaMovel&quot; then m:PivotTo(e.cf*CFrame.new(0,0,math.sin(t*.9)*8))
   elseif id==&quot;PlataformaGiratoria&quot; then m:PivotTo(e.cf*CFrame.Angles(0,t*.55,0))
   elseif id==&quot;Pendulo&quot; then m:PivotTo(e.cf*CFrame.Angles(0,0,math.sin(t*1.8)*.55)) end
   if id==&quot;Laser&quot; or id==&quot;EspinhosEscondidos&quot; then if e.visual~=armed then e.visual=armed flash(m,not armed) end end
   for _,p in ipairs(alive) do
    local root=U.getCharacterRoot(p)
    if not root or not Runner.isAlive(p) or p:GetAttribute(&quot;Frozen&quot;) then continue end
    local localPos=m.PrimaryPart.CFrame:PointToObjectSpace(root.Position)
    local size=e.d.tamanho
    local near=math.abs(localPos.X)&lt;=size.X/2+1 and math.abs(localPos.Z)&lt;=size.Z/2+1 and localPos.Y&gt;=-size.Y/2-1 and localPos.Y&lt;=size.Y/2+3.5
    if id==&quot;Serra&quot; then near=near and math.abs(localPos.Z+math.sin(t*1.5)*4)&lt;2.7 end
    if id==&quot;Laser&quot; then near=near and localPos.Y&lt;3.2 end
    if id==&quot;Pendulo&quot; then near=near and math.abs(localPos.Y+2.2)&lt;3.2 end
    if id==&quot;PortalTroll&quot; and e.exit then
     local v=e.exit:PointToObjectSpace(root.Position)
     if math.abs(v.X)&lt;3 and math.abs(v.Z)&lt;3 and math.abs(v.Y)&lt;6 then near=true e.reverse=true else e.reverse=false end
    end
    if not near or not armed then continue end
    if danger[id] then Runner.damage(p,id,e.owner)
    elseif id==&quot;DegrauFalso&quot; and not e.falling then
     e.falling=true task.delay(.4,function() if m.Parent then e.fell=true for _,v in ipairs(m:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) then v.CanCollide=false Tween:Create(v,TweenInfo.new(.4),{Transparency=1}):Play() end end end end)
    elseif id==&quot;Esteira&quot; then Runner.allowMotion(p,1) local v=root.AssemblyLinearVelocity+e.cf.LookVector*18*step local horizontal=Vector3.new(v.X,0,v.Z) if horizontal.Magnitude&gt;36 then horizontal=horizontal.Unit*36 end root.AssemblyLinearVelocity=horizontal+Vector3.new(0,v.Y,0)
    elseif now&gt;(e.cool[p] or 0) then
     e.cool[p]=now+(id==&quot;Ventilador&quot; and .15 or 1)
     if id==&quot;Trampolim&quot; or id==&quot;PortalTroll&quot; or id==&quot;Ventilador&quot; or id==&quot;MarteloEmpurrao&quot; then p:SetAttribute(&quot;InteractionOwner&quot;,e.owner.UserId) p:SetAttribute(&quot;InteractionAt&quot;,now) p:SetAttribute(&quot;InteractionPiece&quot;,id) end
     if id==&quot;Trampolim&quot; or id==&quot;PortalTroll&quot; or id==&quot;MarteloEmpurrao&quot; then RS.Remotes.PieceActivated:FireAllClients(id,root.Position) end
     if id==&quot;Trampolim&quot; then Runner.allowMotion(p,2) root.AssemblyLinearVelocity=Vector3.new(root.AssemblyLinearVelocity.X,75,root.AssemblyLinearVelocity.Z)
     elseif id==&quot;Ventilador&quot; or id==&quot;MarteloEmpurrao&quot; then Runner.allowMotion(p,2) root.AssemblyLinearVelocity=e.cf.LookVector*(id==&quot;Ventilador&quot; and 35 or 55)+Vector3.new(0,20,0)
     elseif id==&quot;PortalTroll&quot; then
      Runner.allowMotion(p,2) p.Character:PivotTo((e.reverse and e.cf or e.exit)+Vector3.new(0,4,0))
     elseif id==&quot;CheckpointFalso&quot; then RS.Remotes.Toast:FireClient(p,&quot;Checkpoint falso! Seu progresso continua salvo.&quot;,&quot;warn&quot;)
     end
    end
   end
   if id==&quot;BombaRelogio&quot; and t&gt;=5 and not e.exploded then
    e.exploded=true RS.Remotes.PieceActivated:FireAllClients(&quot;explosion&quot;,e.cf.Position)
    for _,p in ipairs(alive) do local r=U.getCharacterRoot(p) if r and (r.Position-e.cf.Position).Magnitude&lt;12 then Runner.damage(p,id,e.owner) end end
    P.dissolve(m)
   end
  end
 end)
end
return P
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000291">
				<Properties>
					<string name="Name">ReplayService</string>
					<ProtectedString name="Source">-- Reservado para a etapa 10; nenhum replay e gravado nesta base.
local R={}
function R.init() end
return R
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000292">
				<Properties>
					<string name="Name">RoundService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Data=require(script.Parent.DataService)
local Score=require(script.Parent.ScoreService)
local Map=require(script.Parent.MapService)
local Runner=require(script.Parent.RunnerService)
local Builder=require(script.Parent.BuilderService)
local R=RS.Remotes
local S={onStateChanged=Instance.new(&quot;BindableEvent&quot;)}
S.onStateChanged.Name=&quot;StateChanged&quot; S.onStateChanged.Parent=script
local state=&quot;WAITING&quot; local timeLeft=0 local round=0 local builder=nil local participants={} local previous=nil local theme=&quot;NeonCidade&quot; local grace=nil
local function packet() return {state=state,timeLeft=timeLeft,round=round,builderUserId=builder and builder.UserId,theme=theme} end
local function emit() R.RoundState:FireAllClients(packet()) end
local function setState(value,seconds) state=value timeLeft=seconds or 0 emit() S.onStateChanged:Fire(value) end
local function role(p,value) if p.Parent then p:SetAttribute(&quot;Role&quot;,value) R.RoleAssigned:FireClient(p,value) end end
local function teleport(p,cf) if p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;) then p.Character:PivotTo(cf) end end
local function present()
 local list={} for _,p in ipairs(participants) do if p.Parent==Players then table.insert(list,p) end end return list
end
local function eligible()
 local list={} for _,p in ipairs(Players:GetPlayers()) do
  local h=p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;)
  if #list&lt;C.MAX_PLAYERS and h and h.Health&gt;0 and Data.get(p) then table.insert(list,p) end
 end return list
end
local function cancelled() return not builder or builder.Parent~=Players or #present()&lt;C.MIN_PLAYERS end
local function reset()
 Builder.endRound() Runner.endRound() Map.resetArena() grace=nil
 for _,p in ipairs(Players:GetPlayers()) do
  role(p,&quot;Lobby&quot;) p:SetAttribute(&quot;InRound&quot;,false) p:SetAttribute(&quot;Lives&quot;,0) p:SetAttribute(&quot;Energy&quot;,0) p:SetAttribute(&quot;MaxEnergy&quot;,0)
  if p.Character then
   local root=U.getCharacterRoot(p) if root then root.Anchored=false end
   p:SetAttribute(&quot;Frozen&quot;,false)
   for _,v in ipairs(p.Character:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) and v.Name~=&quot;HumanoidRootPart&quot; then v.Transparency=0 end end
   local h=p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) if h then h.WalkSpeed=C.RUNNER.WALKSPEED h.UseJumpPower=true h.JumpPower=C.RUNNER.JUMPPOWER end
  end teleport(p,Map.getLobbySpawn())
 end
 participants={} builder=nil
end
function S.getState() return state end
function S.getBuilder() return builder end
function S.getParticipants() return present() end
function S.getTimeLeft() return timeLeft end
local function cycle()
 setState(&quot;WAITING&quot;,0)
 while #eligible()&lt;C.MIN_PLAYERS do emit() task.wait(1) end
 local candidates=eligible()
 if #candidates&gt;=3 and previous then local filtered={} for _,p in ipairs(candidates) do if p.UserId~=previous then table.insert(filtered,p) end end candidates=filtered end
 builder=U.weightedPick(candidates,function(p) local d=Data.get(p) return 1/(1+(d and d.stats.timesBuilder or 0)) end)
 setState(&quot;INTERMISSION&quot;,C.TIMES.INTERMISSION)
 for t=C.TIMES.INTERMISSION,1,-1 do
  timeLeft=t emit() if #eligible()&lt;C.MIN_PLAYERS or not builder.Parent then return end task.wait(1)
 end
 participants=eligible() if not table.find(participants,builder) then return end round+=1 previous=builder.UserId
 theme=Map.randomTheme(theme) Map.resetArena() Map.buildArena(theme)
 local runners={} local slots=Map.getSpawnCFrames(#participants)
 for _,p in ipairs(participants) do
  p:SetAttribute(&quot;InRound&quot;,true)
  if p==builder then role(p,&quot;Builder&quot;) teleport(p,Map.getBuilderCabinCFrame()) local root=U.getCharacterRoot(p) if root then root.Anchored=true end
  else role(p,&quot;Runner&quot;) table.insert(runners,p) teleport(p,slots[#runners]) end
 end
 Score.startRound(participants) Runner.startRound(runners)
 setState(&quot;PREPARING&quot;,C.TIMES.PREPARING)
 for t=C.TIMES.PREPARING,1,-1 do timeLeft=t emit() if cancelled() then return end if t&lt;=3 then R.Toast:FireAllClients(tostring(t),&quot;info&quot;) end task.wait(1) end
 setState(&quot;RUNNING&quot;,C.TIMES.RUNNING) grace=nil Builder.startRound(builder)
 for _,p in ipairs(runners) do Runner.freeze(p,false) end R.Toast:FireAllClients(&quot;GO! O construtor pode colocar plataformas.&quot;,&quot;good&quot;)
 local deadline=os.clock()+C.TIMES.RUNNING local nextSurvival=os.clock()+5 local winner=&quot;Builder&quot;
 while true do
  if cancelled() and not grace and Runner.getFinishCount()==0 then R.Toast:FireAllClients(&quot;Rodada cancelada: faltam participantes.&quot;,&quot;warn&quot;) return end
  local now=os.clock()
  if Runner.getFinishCount()&gt;0 and not grace then grace=now+C.FINISH_GRACE end
  if grace then winner=&quot;Runners&quot; end
  if (grace and now&gt;=grace) or now&gt;=deadline or #Runner.getAlive()==0 then break end
  timeLeft=math.ceil((grace and math.min(grace,deadline) or deadline)-now) emit()
  if now&gt;=nextSurvival then Score.tickSurvival(Runner.getAlive()) nextSurvival=now+5 end
  task.wait(1)
 end
 Builder.endRound() Runner.endRound() setState(&quot;ENDING&quot;,C.TIMES.ENDING)
 if winner==&quot;Runners&quot; then Map.celebrate() end Score.finishRound(winner,{})
 for t=C.TIMES.ENDING,1,-1 do timeLeft=t emit() task.wait(1) end
end
function S.init()
 local function added(p)
  p:SetAttribute(&quot;Role&quot;,state==&quot;WAITING&quot; and &quot;Lobby&quot; or &quot;Spectator&quot;) p:SetAttribute(&quot;Lives&quot;,0) p:SetAttribute(&quot;InRound&quot;,false) p:SetAttribute(&quot;Points&quot;,0)
  p.CharacterAdded:Connect(function() task.wait(.25) if p.Parent then
   if p:GetAttribute(&quot;Role&quot;)==&quot;Builder&quot; then teleport(p,Map.getBuilderCabinCFrame()) local root=U.getCharacterRoot(p) if root then root.Anchored=true end elseif not p:GetAttribute(&quot;InRound&quot;) then teleport(p,Map.getLobbySpawn()) end
  end end)
 end
 Players.PlayerAdded:Connect(added) for _,p in ipairs(Players:GetPlayers()) do added(p) end
 local limiter=U.rateLimiter(2)
 R.ReadyForData.OnServerEvent:Connect(function(p) if limiter(p) then R.RoundState:FireClient(p,packet()) R.RoleAssigned:FireClient(p,p:GetAttribute(&quot;Role&quot;) or &quot;Lobby&quot;) R.ThemeChanged:FireClient(p,theme) end end)
 Runner.Finished.Event:Connect(function() if state==&quot;RUNNING&quot; and not grace then grace=os.clock()+C.FINISH_GRACE end end)
 task.spawn(function()
  while true do
   local ok,err=xpcall(cycle,debug.traceback) if not ok then warn(&quot;[RoundService] &quot;..tostring(err)) R.Toast:FireAllClients(&quot;Reiniciando rodada.&quot;,&quot;warn&quot;) end
   setState(&quot;RESET&quot;,C.TIMES.RESET) reset() task.wait(C.TIMES.RESET)
  end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000293">
				<Properties>
					<string name="Name">RunnerService</string>
					<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local CS=game:GetService(&quot;CollectionService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Map=require(script.Parent.MapService)
local Score=require(script.Parent.ScoreService)
local R=RS.Remotes
local S={HelperCreated=Instance.new(&quot;BindableEvent&quot;),Finished=Instance.new(&quot;BindableEvent&quot;)}
-- HelperCreated(player); Finished(player,place): eventos internos, somente servidor.
S.HelperCreated.Name=&quot;HelperCreated&quot; S.HelperCreated.Parent=script
S.Finished.Name=&quot;Finished&quot; S.Finished.Parent=script
local active=false local records={} local connections={} local hooked={} local finishCount=0
local function setRole(p,role) p:SetAttribute(&quot;Role&quot;,role) R.RoleAssigned:FireClient(p,role) end
local function configure(p,char)
 local h=char:WaitForChild(&quot;Humanoid&quot;,5) if not h then return end
 h.UseJumpPower=true h.WalkSpeed=C.RUNNER.WALKSPEED h.JumpPower=C.RUNNER.JUMPPOWER
 local rec=records[p]
 if rec and active then
  task.defer(function() if p.Parent and char.Parent then
   if p:GetAttribute(&quot;Role&quot;)==&quot;Helper&quot; then for _,v in ipairs(char:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) then v.Transparency=math.max(v.Transparency,.65) end end char:PivotTo(Map.getBuilderCabinCFrame()) local root=U.getCharacterRoot(p) if root then root.Anchored=true end
   elseif rec.finished then char:PivotTo(Map.getLobbySpawn())
   else S.respawnAtCheckpoint(p) S.freeze(p,rec.frozen) end
  end end)
 end
 h.Died:Connect(function()
  if active and S.isAlive(p) then local r=records[p] r.invuln=0 S.damage(p,&quot;Morte&quot;,nil) end
 end)
end
function S.allowMotion(p,seconds) local r=records[p] if r then r.motionUntil=os.clock()+seconds end end
function S.freeze(p,value)
 p:SetAttribute(&quot;Frozen&quot;,value)
 local r=records[p] if r then r.frozen=value end
 local h=p.Character and p.Character:FindFirstChildOfClass(&quot;Humanoid&quot;) if h then h.WalkSpeed=value and 0 or C.RUNNER.WALKSPEED h.JumpPower=value and 0 or C.RUNNER.JUMPPOWER end
end
function S.isAlive(p) local r=records[p] return active and r~=nil and not r.finished and p.Parent~=nil and p:GetAttribute(&quot;Role&quot;)==&quot;Runner&quot; and (p:GetAttribute(&quot;Lives&quot;) or 0)&gt;0 end
function S.getAlive() local out={} for p in pairs(records) do if S.isAlive(p) then table.insert(out,p) end end return out end
function S.getFinishCount() return finishCount end
function S.respawnAtCheckpoint(p)
 if not p.Character then return end local root=U.getCharacterRoot(p)
 if root then root.AssemblyLinearVelocity=Vector3.zero root.AssemblyAngularVelocity=Vector3.zero end
 p.Character:PivotTo(Map.getCheckpointCFrame(p:GetAttribute(&quot;CheckpointIndex&quot;) or 0))
end
function S.becomeHelper(p)
 setRole(p,&quot;Helper&quot;) local r=records[p] if r then r.invuln=math.huge end
 if p.Character then
  p.Character:PivotTo(Map.getBuilderCabinCFrame()+Vector3.new(5,0,0))
  local root=U.getCharacterRoot(p) if root then root.Anchored=true end
  for _,v in ipairs(p.Character:GetDescendants()) do if v:IsA(&quot;BasePart&quot;) then v.Transparency=math.max(v.Transparency,.65) end end
 end
 R.Toast:FireClient(p,&quot;Voce virou Ajudante! Construa pontes para os corredores.&quot;,&quot;info&quot;) S.HelperCreated:Fire(p)
end
function S.damage(p,pieceId,byBuilder)
 local rec=records[p] local now=os.clock()
 if not S.isAlive(p) or rec.frozen or now&lt;(rec.invuln or 0) then return end
 rec.invuln=now+C.RUNNER.INVULN_TIME
 local lives=math.max(0,(p:GetAttribute(&quot;Lives&quot;) or C.RUNNER.LIVES)-1)
 p:SetAttribute(&quot;Lives&quot;,lives) R.LivesUpdate:FireClient(p,lives) R.ScreenFX:FireClient(p,&quot;flash&quot;,.35)
 if lives==0 then
  local recent=now-(p:GetAttribute(&quot;InteractionAt&quot;) or -100)&lt;2
  local interaction=recent and Players:GetPlayerByUserId(p:GetAttribute(&quot;InteractionOwner&quot;) or 0) or nil
  if not byBuilder and interaction then byBuilder=interaction pieceId=p:GetAttribute(&quot;InteractionPiece&quot;) end
  Score.registerElimination(p,byBuilder,pieceId)
  if interaction and interaction:GetAttribute(&quot;Role&quot;)==&quot;Builder&quot; and (p:GetAttribute(&quot;InteractionPiece&quot;)==&quot;Trampolim&quot; or p:GetAttribute(&quot;InteractionPiece&quot;)==&quot;PortalTroll&quot;) then Score.registerCombo(interaction) end
  R.PlayerEliminated:FireAllClients({userId=p.UserId,pieceId=pieceId,byUserId=byBuilder and byBuilder.UserId})
  S.becomeHelper(p)
 else
  R.Toast:FireClient(p,&quot;Voce perdeu uma vida \u{b7} &quot;..lives..&quot; restantes&quot;,&quot;bad&quot;)
  S.respawnAtCheckpoint(p)
  local f=Instance.new(&quot;ForceField&quot;) f.Visible=true f.Parent=p.Character game:GetService(&quot;Debris&quot;):AddItem(f,C.RUNNER.INVULN_TIME)
 end
end
local function playerFromHit(hit) local char=hit:FindFirstAncestorOfClass(&quot;Model&quot;) return char and Players:GetPlayerFromCharacter(char) end
local function contact(obj,tag,p)
  if not p or not S.isAlive(p) then return end local rec=records[p] if rec.frozen then return end
  local root=U.getCharacterRoot(p) if not root then return end
  local rel=obj.CFrame:PointToObjectSpace(root.Position)
  if math.abs(rel.X)&gt;obj.Size.X/2+2 or math.abs(rel.Z)&gt;obj.Size.Z/2+2 or math.abs(rel.Y)&gt;obj.Size.Y/2+6 then return end
  if tag==&quot;KillPlane&quot; then S.damage(p,&quot;Queda&quot;)
  elseif tag==&quot;Hazard&quot; then
   local piece=obj:FindFirstAncestorOfClass(&quot;Model&quot;) or obj
   if piece:GetAttribute(&quot;Armed&quot;)~=true then return end
   S.damage(p,piece:GetAttribute(&quot;PieceId&quot;),Players:GetPlayerByUserId(piece:GetAttribute(&quot;OwnerUserId&quot;) or 0))
  elseif tag==&quot;Checkpoint&quot; then
   local index=obj:GetAttribute(&quot;Index&quot;) if type(index)==&quot;number&quot; and index&gt;(p:GetAttribute(&quot;CheckpointIndex&quot;) or 0) then
    -- Impede saltar checkpoints em sequencia impossivel.
    if index~=(p:GetAttribute(&quot;CheckpointIndex&quot;) or 0)+1 then return end
    p:SetAttribute(&quot;CheckpointIndex&quot;,index) local flag=obj.Parent:FindFirstChild(&quot;Bandeira&quot;) if flag then U.tween(flag,TweenInfo.new(.4),{Color=C.COLORS.SUCCESS}) end
    R.Toast:FireClient(p,&quot;Checkpoint &quot;..index..&quot; salvo!&quot;,&quot;good&quot;) R.PieceActivated:FireClient(p,&quot;checkpoint&quot;,obj.Position)
   end
  elseif tag==&quot;FinishLine&quot; then
   if (p:GetAttribute(&quot;CheckpointIndex&quot;) or 0)&lt;#C.ARENA.CHECKPOINTS_Z then
    if os.clock()&gt;(rec.finishWarnAt or 0) then rec.finishWarnAt=os.clock()+3 R.Toast:FireClient(p,&quot;Passe pelos 3 checkpoints antes de terminar.&quot;,&quot;warn&quot;) end return end
   rec.finished=true finishCount+=1 p:SetAttribute(&quot;InRound&quot;,false) Score.registerFinish(p,finishCount)
   R.ReachedFinish:FireAllClients(p.UserId,finishCount) R.Toast:FireClient(p,&quot;Chegada! Posicao #&quot;..finishCount,&quot;good&quot;) S.Finished:Fire(p,finishCount)
  elseif tag==&quot;FakeCheckpoint&quot; and os.clock()&gt;(rec.fakeAt or 0) then
   rec.fakeAt=os.clock()+2 R.PieceActivated:FireClient(p,&quot;CheckpointFalso&quot;,obj.Position) R.Toast:FireClient(p,&quot;Era um checkpoint falso!&quot;,&quot;warn&quot;)
  end
end
local function hook(obj,tag)
 if not obj:IsA(&quot;BasePart&quot;) or hooked[obj] then return end hooked[obj]=true
 table.insert(connections,obj.Touched:Connect(function(hit) contact(obj,tag,playerFromHit(hit)) end))
end
function S.startRound(runners)
 S.endRound() active=true finishCount=0 records={}
 for _,p in ipairs(runners) do
  p:SetAttribute(&quot;InteractionAt&quot;,-100)
  records[p]={invuln=0,dashAt=-math.huge,frozen=true,finished=false,speedTime=0}
  p:SetAttribute(&quot;Lives&quot;,C.RUNNER.LIVES) p:SetAttribute(&quot;CheckpointIndex&quot;,0) p:SetAttribute(&quot;InRound&quot;,true)
  R.LivesUpdate:FireClient(p,C.RUNNER.LIVES) S.freeze(p,true)
 end
 for _,tag in ipairs({&quot;Checkpoint&quot;,&quot;FakeCheckpoint&quot;,&quot;FinishLine&quot;,&quot;KillPlane&quot;,&quot;Hazard&quot;}) do
  for _,obj in ipairs(CS:GetTagged(tag)) do hook(obj,tag) end
  table.insert(connections,CS:GetInstanceAddedSignal(tag):Connect(function(obj) hook(obj,tag) end))
 end
end
function S.endRound()
 active=false for _,conn in ipairs(connections) do conn:Disconnect() end connections={} hooked={}
 for p in pairs(records) do if p.Parent then S.freeze(p,false) end end records={}
end
function S.init()
 local limit=U.rateLimiter(4)
 R.UseDash.OnServerEvent:Connect(function(p)
  if not limit(p) or not S.isAlive(p) then return end local rec=records[p] local now=os.clock()
  if rec.frozen or now-rec.dashAt&lt;C.RUNNER.DASH_COOLDOWN then return end
  local root=U.getCharacterRoot(p) if not root then return end
  rec.dashAt=now rec.motionUntil=now+.8
  local dir=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
  if dir.Magnitude&lt;.01 then return end dir=dir.Unit
  root.AssemblyLinearVelocity=dir*C.RUNNER.DASH_FORCE+Vector3.new(0,root.AssemblyLinearVelocity.Y,0)
  R.DashCooldown:FireClient(p,C.RUNNER.DASH_COOLDOWN) R.PieceActivated:FireAllClients(&quot;Dash&quot;,root.Position)
 end)
 local function added(p) p.CharacterAdded:Connect(function(c) configure(p,c) end) if p.Character then task.spawn(configure,p,p.Character) end end
 Players.PlayerAdded:Connect(added) for _,p in ipairs(Players:GetPlayers()) do added(p) end
 Players.PlayerRemoving:Connect(function(p) records[p]=nil end)
 Run.Heartbeat:Connect(function(dt)
  if not active then return end
  for p,rec in pairs(records) do
   if S.isAlive(p) and not rec.frozen then
    local root=U.getCharacterRoot(p)
    if root then
     if root.Position.Y&lt;C.ARENA.ORIGIN.Y+C.ARENA.KILL_Y-2 then S.damage(p,&quot;Queda&quot;) end
     if os.clock()&gt;(rec.objectiveAt or 0) then
      rec.objectiveAt=os.clock()+.1
      for _,obj in ipairs(CS:GetTagged(&quot;Checkpoint&quot;)) do if obj:IsA(&quot;BasePart&quot;) then contact(obj,&quot;Checkpoint&quot;,p) end end
      for _,obj in ipairs(CS:GetTagged(&quot;FinishLine&quot;)) do if obj:IsA(&quot;BasePart&quot;) then contact(obj,&quot;FinishLine&quot;,p) end end
     end
     local speed=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
     if speed&gt;C.RUNNER.WALKSPEED*3 and os.clock()&gt;(rec.motionUntil or 0) then rec.speedTime+=dt else rec.speedTime=0 end
     if rec.speedTime&gt;1 then rec.speedTime=0 S.respawnAtCheckpoint(p) warn(&quot;[Runner] Velocidade irregular: &quot;..p.UserId) end
    end
   end
  end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX00000294">
				<Properties>
					<string name="Name">ScoreService</string>
					<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local DSS=game:GetService(&quot;DataStoreService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local C=require(RS.Modules.Config)
local D=require(script.Parent.DataService)
local R=RS:WaitForChild(&quot;Remotes&quot;)
local S={} local participants={} local scores={} local roles={} local kills={} local finishes={} local top={} local dirty={}
local store=DSS:GetOrderedDataStore(&quot;Wins_v1&quot;)
function S.startRound(list)
 participants=table.clone(list) scores={} roles={} kills={} finishes={}
 for _,p in ipairs(list) do scores[p]=0 roles[p]=p:GetAttribute(&quot;Role&quot;) p:SetAttribute(&quot;Points&quot;,0) end
end
function S.addPoints(p,amount,reason)
 if not p or not p.Parent or scores[p]==nil then return end scores[p]+=amount p:SetAttribute(&quot;Points&quot;,scores[p])
 if reason~=&quot;Sobrevivencia&quot; then R.Toast:FireClient(p,&quot;+&quot;..amount..&quot; \u{b7} &quot;..(reason or &quot;Pontos&quot;),&quot;good&quot;) end
end
function S.registerFinish(p,place) if finishes[p] then return end finishes[p]=place S.addPoints(p,C.SCORE.PLACE[place] or C.SCORE.PLACE_DEFAULT,&quot;Chegada #&quot;..place) end
function S.registerElimination(victim,killer,pieceId)
 if killer and killer~=victim then
  kills[killer]=(kills[killer] or 0)+1
  if roles[killer]==&quot;Builder&quot; then
   local before=(kills[killer]-1)*C.SCORE.BUILDER_PER_ELIM local grant=math.max(0,math.min(C.SCORE.BUILDER_PER_ELIM,C.SCORE.BUILDER_ELIM_MAX-before))
   if grant&gt;0 then S.addPoints(killer,grant,&quot;Eliminacao&quot;) end
  else S.addPoints(killer,C.SCORE.HELPER_ELIM,&quot;Ajuda&quot;) end
 end
end
function S.registerCombo(p) S.addPoints(p,C.SCORE.BUILDER_COMBO,&quot;Combo&quot;) end
function S.tickSurvival(runners) for _,p in ipairs(runners) do S.addPoints(p,C.SCORE.SURVIVE_PER_5S,&quot;Sobrevivencia&quot;) end end
function S.finishRound(winner,summary)
 local podium={} local mvp=nil local highest=-1
 for _,p in ipairs(participants) do
  if p.Parent then
   if roles[p]==&quot;Builder&quot; and winner==&quot;Builder&quot; then S.addPoints(p,C.SCORE.BUILDER_WIN,&quot;Vitoria&quot;) end
   if (scores[p] or 0)&gt;highest then mvp=p highest=scores[p] or 0 end
   if finishes[p] then table.insert(podium,{userId=p.UserId,place=finishes[p],points=scores[p] or 0}) end
   D.update(p,function(d)
    d.stats.rounds+=1 d.stats.eliminations+=(kills[p] or 0)
    if roles[p]==&quot;Builder&quot; then d.stats.timesBuilder+=1 if winner==&quot;Builder&quot; then d.stats.winsBuilder+=1 end
    elseif winner==&quot;Runners&quot; then d.stats.winsRunner+=1 end
    if finishes[p] and (d.stats.bestPlace==0 or finishes[p]&lt;d.stats.bestPlace) then d.stats.bestPlace=finishes[p] end
   end)
   local d=D.get(p) if d and D.isPersistent(p) then dirty[p.UserId]=d.stats.winsRunner+d.stats.winsBuilder end
   D.addCoins(p,math.round((scores[p] or 0)*C.SCORE.COINS_FACTOR)) D.addXp(p,scores[p] or 0)
  end
 end
 table.sort(podium,function(a,b) return a.place&lt;b.place end)
 for _,p in ipairs(Players:GetPlayers()) do
  R.RoundResult:FireClient(p,{winner=winner,podium=podium,mvpUserId=mvp and mvp.UserId,rewards={coins=math.round((scores[p] or 0)*C.SCORE.COINS_FACTOR),xp=scores[p] or 0},stats={eliminations=kills[p] or 0}})
 end
 return {winner=winner,podium=podium,mvpUserId=mvp and mvp.UserId,rewards={coins=0,xp=0},stats={eliminations=0}}
end
function S.getTopWins(n) local out={} for i=1,math.min(n or 10,#top) do out[i]=top[i] end return out end
function S.init()
 -- Uma escrita por jogador alterado a cada 120s; uma leitura global por ciclo.
 task.spawn(function()
  while true do
   task.wait(C.DATA.RANK_INTERVAL)
   for userId,value in pairs(dirty) do
    local ok=pcall(function() store:UpdateAsync(tostring(userId),function(old) return math.max(old or 0,value) end) end)
    if ok and dirty[userId]==value then dirty[userId]=nil end
   end
   local ok,page=pcall(function() return store:GetSortedAsync(false,10):GetCurrentPage() end)
   if ok then
    top={} for _,entry in ipairs(page) do table.insert(top,{userId=tonumber(entry.key),wins=entry.value}) end
    local map=require(script.Parent.MapService) map.updateLeaderboard(top)
   end
  end
 end)
end
return S
</ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Script" referent="RBX0000029D">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">Main</string>
				<ProtectedString name="Source">-- Construtor vs Corredores \u{b7} base das etapas 01\u{2013}05.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local SoundService=game:GetService(&quot;SoundService&quot;)
local function folder(parent,name) local x=parent:FindFirstChild(name) if not x then x=Instance.new(&quot;Folder&quot;) x.Name=name x.Parent=parent end return x end
local remotes=folder(RS,&quot;Remotes&quot;) local count=0
for _,name in ipairs({&quot;RoundState&quot;,&quot;RoleAssigned&quot;,&quot;EnergyUpdate&quot;,&quot;LivesUpdate&quot;,&quot;DashCooldown&quot;,&quot;PlaceResult&quot;,&quot;PlayerEliminated&quot;,&quot;ReachedFinish&quot;,&quot;RoundResult&quot;,&quot;Toast&quot;,&quot;ThemeChanged&quot;,&quot;PieceActivated&quot;,&quot;ScreenFX&quot;,&quot;SettingsLoad&quot;,&quot;StatsUpdate&quot;,&quot;EmoteBroadcast&quot;,&quot;PlacePiece&quot;,&quot;UndoPiece&quot;,&quot;UseDash&quot;,&quot;SaveSettings&quot;,&quot;Emote&quot;,&quot;ReadyForData&quot;,&quot;BuyCosmetic&quot;}) do
 if not remotes:FindFirstChild(name) then local r=Instance.new(&quot;RemoteEvent&quot;) r.Name=name r.Parent=remotes count+=1 end
end
if not remotes:FindFirstChild(&quot;GetPlayerData&quot;) then local r=Instance.new(&quot;RemoteFunction&quot;) r.Name=&quot;GetPlayerData&quot; r.Parent=remotes count+=1 end
for _,name in ipairs({&quot;Lobby&quot;,&quot;Arena&quot;,&quot;PiecesActive&quot;}) do folder(workspace,name) end
for _,name in ipairs({&quot;Pieces&quot;,&quot;Effects&quot;}) do folder(RS,name) end
local master=SoundService:FindFirstChild(&quot;Master&quot;) or Instance.new(&quot;SoundGroup&quot;) master.Name=&quot;Master&quot; master.Parent=SoundService
for _,name in ipairs({&quot;Music&quot;,&quot;SFX&quot;,&quot;UI&quot;}) do local g=master:FindFirstChild(name) or Instance.new(&quot;SoundGroup&quot;) g.Name=name g.Parent=master end
print(&quot;[Main] Remotes: &quot;..count..&quot; criados&quot;)
local services=script.Parent:WaitForChild(&quot;Services&quot;)
for _,name in ipairs({&quot;MapService&quot;,&quot;DataService&quot;,&quot;ScoreService&quot;,&quot;RunnerService&quot;,&quot;PieceService&quot;,&quot;BuilderService&quot;,&quot;AntiExploitService&quot;,&quot;ReplayService&quot;,&quot;PassService&quot;,&quot;CharacterService&quot;,&quot;CosmeticService&quot;,&quot;RoundService&quot;}) do
 local mod=services:FindFirstChild(name)
 if mod then local ok,result=pcall(require,mod) if ok and type(result)==&quot;table&quot; and result.init then local success,err=pcall(result.init) if not success then warn(&quot;[Main] &quot;..name..&quot;: &quot;..tostring(err)) end elseif not ok then warn(&quot;[Main] &quot;..name..&quot;: &quot;..tostring(result)) end end
end
</ProtectedString>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX0000029E">
			<Properties>
				<string name="Name">LEIA_ME</string>
				<ProtectedString name="Source">-- CONSTRUTOR VS CORREDORES \u{b7} R6
-- CharacterService gera o rig R6. AnimationController anima os Motor6D sem IDs.
-- Cinco mapas sao gerados por WorldContent e escolhidos a cada rodada.
-- PieceService aplica comportamentos das 21 pecas no servidor.
-- Loja: camisas com moedas; passes cosmeticos em breve (IDs zero por escolha).
-- Abra a copia no Studio e teste servidor local com 2 jogadores antes de publicar.
-- Audio permanece opcional, sem IDs externos configurados.
return {version=&quot;R6-Minimal&quot;,maps=5,pieces=21,rig=&quot;R6&quot;}
</ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX0000027B">
		<Properties>
			<float name="CharacterJumpPower">50</float>
			<bool name="CharacterUseJumpPower">true</bool>
			<float name="CharacterWalkSpeed">16</float>
			<string name="Name">StarterPlayer</string>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX0000027C">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX0000027D">
				<Properties>
					<string name="Name">Client</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX00000295">
					<Properties>
						<string name="Name">AnimationController</string>
						<ProtectedString name="Source">-- Animacoes R6 autorais por Motor6D, executadas para todos os personagens visiveis.
local Players=game:GetService(&quot;Players&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local A={} local rigs={} local emotes={}
local function bind(p,char)
 local torso=char:WaitForChild(&quot;Torso&quot;,8) local h=char:FindFirstChildOfClass(&quot;Humanoid&quot;) local root=char:FindFirstChild(&quot;HumanoidRootPart&quot;) if not torso or not h or not root then return end
 local joints={} for _,j in ipairs(char:GetDescendants()) do if j:IsA(&quot;Motor6D&quot;) then joints[j.Name]=j end end local eyes={} local head=char:FindFirstChild(&quot;Head&quot;) local face=head and head:FindFirstChild(&quot;Rosto&quot;) if face then for _,f in ipairs(face:GetChildren()) do if f.Name==&quot;Olho&quot; then table.insert(eyes,f) end end end rigs[p]={char=char,h=h,root=root,j=joints,eyes=eyes}
end
function A.init()
 local function add(p) p.CharacterAdded:Connect(function(c) task.spawn(bind,p,c) end) if p.Character then task.spawn(bind,p,p.Character) end end
 Players.PlayerAdded:Connect(add) Players.PlayerRemoving:Connect(function(p) rigs[p]=nil emotes[p]=nil end) for _,p in ipairs(Players:GetPlayers()) do add(p) end
 RS.Remotes.EmoteBroadcast.OnClientEvent:Connect(function(id) local p=Players:GetPlayerByUserId(id) if p then emotes[p]=os.clock()+2 end end)
 RS.Remotes.ReachedFinish.OnClientEvent:Connect(function(id) local p=Players:GetPlayerByUserId(id) if p and rigs[p] then rigs[p].winUntil=os.clock()+3 end end)
 RS.Remotes.RoundResult.OnClientEvent:Connect(function(d) for p,r in pairs(rigs) do local role=p:GetAttribute(&quot;Role&quot;) if (d.winner==&quot;Builder&quot; and role==&quot;Builder&quot;) or (d.winner==&quot;Runners&quot; and (role==&quot;Runner&quot; or role==&quot;Helper&quot;)) then r.winUntil=os.clock()+3 end end end)
 Run.PreSimulation:Connect(function(dt)
  local t=os.clock()
  for p,r in pairs(rigs) do
   if not r.char.Parent then rigs[p]=nil continue end
   local speed=Vector3.new(r.root.AssemblyLinearVelocity.X,0,r.root.AssemblyLinearVelocity.Z).Magnitude
   local walking=speed&gt;1 and r.h.FloorMaterial~=Enum.Material.Air and not r.root.Anchored
   local jump=r.h.FloorMaterial==Enum.Material.Air and not r.root.Anchored
   local stride=walking and math.sin(t*math.clamp(speed*.65,6,16))*.75 or math.sin(t*2)*.025
   local pose={}
   pose[&quot;Right Hip&quot;]=CFrame.Angles(stride,0,0) pose[&quot;Left Hip&quot;]=CFrame.Angles(-stride,0,0)
   pose[&quot;Right Shoulder&quot;]=CFrame.Angles(-stride,0,.04) pose[&quot;Left Shoulder&quot;]=CFrame.Angles(stride,0,-.04)
   pose.RootJoint=CFrame.new(0,walking and math.abs(math.sin(t*10))*.045 or math.sin(t*2)*.025,0)*CFrame.Angles(walking and -.06 or 0,0,0)
   pose.Neck=CFrame.Angles(math.sin(t*1.5)*.02,0,0)
   if jump then pose[&quot;Right Shoulder&quot;]=CFrame.Angles(-.5,0,.65) pose[&quot;Left Shoulder&quot;]=CFrame.Angles(-.5,0,-.65) pose[&quot;Right Hip&quot;]=CFrame.Angles(-.25,0,0) pose[&quot;Left Hip&quot;]=CFrame.Angles(.25,0,0) end
   if (emotes[p] or 0)&gt;t then pose[&quot;Right Shoulder&quot;]=CFrame.Angles(0,0,2.3+math.sin(t*12)*.3) end
   if (r.winUntil or 0)&gt;t then pose[&quot;Right Shoulder&quot;]=CFrame.Angles(0,0,2.5+math.sin(t*8)*.15) pose[&quot;Left Shoulder&quot;]=CFrame.Angles(0,0,-2.5-math.sin(t*8)*.15) end
   for _,eye in ipairs(r.eyes) do if eye.Parent then eye.Size=UDim2.fromOffset(10,math.sin(t*1.7)&gt; .995 and 2 or 10) end end
   for name,j in pairs(r.j) do if j.Parent then j.Transform=j.Transform:Lerp(pose[name] or CFrame.new(),math.min(1,dt*16)) end end
  end
 end)
end
return A
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000296">
					<Properties>
						<string name="Name">AudioController</string>
						<ProtectedString name="Source">-- Sem audios externos: os placeholders silenciosos podem ser substituidos no SoundBank.
local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local SoundService=game:GetService(&quot;SoundService&quot;)
local Bank=require(RS.Modules.SoundBank)
local U=require(RS.Modules.Util)
local Settings=require(script.Parent.SettingsController)
local A={} local music=nil
local function play(key,group)
 local id=Bank.SFX[key] or Bank.UI[key] if not id or id==&quot;rbxassetid://0&quot; then return end
 local s=U.createSound(SoundService,id,{Volume=Bank.volumeOf(key)*Settings.current.audio.master/100})
 local master=SoundService:FindFirstChild(&quot;Master&quot;) s.SoundGroup=master and master:FindFirstChild(group or &quot;SFX&quot;)
 s:Play() s.Ended:Once(function() s:Destroy() end) game:GetService(&quot;Debris&quot;):AddItem(s,30)
end
function A.setState(state)
 if music then music:Destroy() music=nil end local key=state==&quot;RUNNING&quot; and &quot;running&quot; or state==&quot;PREPARING&quot; and &quot;preparing&quot; or &quot;lobby&quot; local id=Bank.MUSIC[key]
 if id and id~=&quot;rbxassetid://0&quot; then music=U.createSound(SoundService,id,{Looped=true,Volume=Settings.current.audio.music/100*Settings.current.audio.master/100}) music:Play() end
end
function A.init() RS.Remotes.PieceActivated.OnClientEvent:Connect(function(id) play(id==&quot;Dash&quot; and &quot;place&quot; or id) end) end
return A
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000297">
					<Properties>
						<string name="Name">BuilderController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Input=game:GetService(&quot;UserInputService&quot;)
local GuiService=game:GetService(&quot;GuiService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Players=game:GetService(&quot;Players&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local B={} local selected=&quot;Plataforma&quot; local rotation=0 local level=0 local role=&quot;Lobby&quot; local state=&quot;WAITING&quot; local ghost local target=nil local pointer=nil
function B.select(id) selected=id end
function B.rotate() rotation=(rotation+1)%4 end
function B.height() level=(level+1)%C.BUILD.HEIGHT_LEVELS return level end
function B.setRole(value) role=value end
function B.setState(value) state=value end
function B.init()
 ghost=U.makePart({Name=&quot;PreviewLocal&quot;,Anchored=true,CanCollide=false,CanTouch=false,CanQuery=false,Transparency=1,Material=Enum.Material.ForceField,Parent=workspace})
 local function canBuild() return (role==&quot;Builder&quot; or role==&quot;Helper&quot;) and state==&quot;RUNNING&quot; end
 Input.InputBegan:Connect(function(input,gp)
  if gp then return end
  if input.KeyCode==Enum.KeyCode.G then RS.Remotes.Emote:FireServer(&quot;Emote1&quot;) end
  if input.KeyCode==Enum.KeyCode.Q then RS.Remotes.UseDash:FireServer() end
  if not canBuild() then return end
  if input.KeyCode==Enum.KeyCode.R then B.rotate()
  elseif input.KeyCode==Enum.KeyCode.Z then RS.Remotes.UndoPiece:FireServer()
  elseif input.KeyCode==Enum.KeyCode.T then B.height()
  elseif input.UserInputType==Enum.UserInputType.MouseButton1 and target then RS.Remotes.PlacePiece:FireServer(selected,target) end
 end)
 local function atPoint(point)
  local camera=workspace.CurrentCamera if not camera then return nil end
  local ray=camera:ViewportPointToRay(point.X,point.Y) if math.abs(ray.Direction.Y)&lt;.001 then return nil end
  local t=(C.ARENA.ORIGIN.Y-ray.Origin.Y)/ray.Direction.Y if t&lt;0 then return nil end
  local pos=U.snapToGrid(ray.Origin+ray.Direction*t,C.PIECES.GRID) local d=Catalog.get(selected)
  return CFrame.new(pos.X,C.ARENA.ORIGIN.Y+d.tamanho.Y/2-1+level*C.BUILD.HEIGHT_STEP,pos.Z)*CFrame.Angles(0,rotation*math.pi/2,0)
 end
 Input.TouchTapInWorld:Connect(function(point,processed)
  if processed or not canBuild() then return end local inset=GuiService:GetGuiInset() local cf=atPoint(point-inset) if cf then pointer=point-inset RS.Remotes.PlacePiece:FireServer(selected,cf) end
 end)
 Run.RenderStepped:Connect(function()
  if not canBuild() then ghost.Transparency=1 target=nil return end
  local inset=GuiService:GetGuiInset() local pos=Input.TouchEnabled and pointer or (Input:GetMouseLocation()-inset)
  if not pos then ghost.Transparency=1 return end target=atPoint(pos)
  local d=Catalog.get(selected)
  if target then ghost.Size=d.tamanho ghost.CFrame=target ghost.Color=d.cor ghost.Transparency=.45 else ghost.Transparency=1 end
 end)
end
return B
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX00000298">
					<Properties>
						<string name="Name">CameraController</string>
						<ProtectedString name="Source">local Players=game:GetService(&quot;Players&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Input=game:GetService(&quot;UserInputService&quot;)
local C=require(game:GetService(&quot;ReplicatedStorage&quot;).Modules.Config)
local Cam={} local building=false local focus=Vector3.new(0,50,120) local height=230
function Cam.setRole(role) building=role==&quot;Builder&quot; or role==&quot;Helper&quot; if building then focus=C.ARENA.ORIGIN+Vector3.new(0,0,120) end end
function Cam.init()
 local pinchHeight=height
 Input.TouchPinch:Connect(function(_,scale,_,state,processed)
  if not building or processed then return end
  if state==Enum.UserInputState.Begin then pinchHeight=height elseif state==Enum.UserInputState.Change and scale&gt;0 then height=math.clamp(pinchHeight/scale,65,300) end
 end)
 Input.InputChanged:Connect(function(i,gp) if building and not gp and i.UserInputType==Enum.UserInputType.MouseWheel then height=math.clamp(height-i.Position.Z*16,65,300) end end)
 Run:BindToRenderStep(&quot;BuilderCamera&quot;,Enum.RenderPriority.Camera.Value+1,function(dt)
  local camera=workspace.CurrentCamera if not camera then return end
  if building then
   camera.CameraType=Enum.CameraType.Scriptable
   if not Input:GetFocusedTextBox() then
    local x=(Input:IsKeyDown(Enum.KeyCode.D) and 1 or 0)-(Input:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
    local z=(Input:IsKeyDown(Enum.KeyCode.W) and 1 or 0)-(Input:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
    focus+=Vector3.new(-x,0,z)*dt*60 focus=Vector3.new(math.clamp(focus.X,-40,40),C.ARENA.ORIGIN.Y,math.clamp(focus.Z,0,240))
   end
   camera.CFrame=CFrame.lookAt(focus+Vector3.new(0,height,0),focus,Vector3.new(0,0,1))
  elseif camera.CameraType==Enum.CameraType.Scriptable then
   camera.CameraType=Enum.CameraType.Custom local char=Players.LocalPlayer.Character local hum=char and char:FindFirstChildOfClass(&quot;Humanoid&quot;) if hum then camera.CameraSubject=hum end
  end
 end)
end
return Cam
</ProtectedString>
					</Properties>
				</Item>
				<Item class="LocalScript" referent="RBX00000299">
					<Properties>
						<bool name="Disabled">false</bool>
						<string name="Name">ClientMain</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local R=RS:WaitForChild(&quot;Remotes&quot;)
for _,name in ipairs({&quot;RoundState&quot;,&quot;RoleAssigned&quot;,&quot;EnergyUpdate&quot;,&quot;LivesUpdate&quot;,&quot;DashCooldown&quot;,&quot;PlaceResult&quot;,&quot;RoundResult&quot;,&quot;Toast&quot;,&quot;ReadyForData&quot;}) do R:WaitForChild(name) end
local UI=require(script.Parent.UIController)
local Camera=require(script.Parent.CameraController)
local Builder=require(script.Parent.BuilderController)
local Settings=require(script.Parent.SettingsController)
local Audio=require(script.Parent.AudioController)
local VFX=require(script.Parent.VFXController)
UI.init({select=Builder.select,rotate=Builder.rotate,height=function() local level=Builder.height() UI.toast(&quot;Nivel de altura: &quot;..level,&quot;info&quot;) end,setting=function(cat,key) Settings.toggle(cat,key) UI.toast(&quot;Configuracao salva&quot;,&quot;info&quot;) end})
require(script.Parent.AnimationController).init()
Camera.init() Builder.init() Settings.init() Audio.init() VFX.init()
R.RoundState.OnClientEvent:Connect(function(data) UI.setState(data) Builder.setState(data.state) Audio.setState(data.state) end)
R.RoleAssigned.OnClientEvent:Connect(function(role) UI.setRole(role) Camera.setRole(role) Builder.setRole(role) end)
R.EnergyUpdate.OnClientEvent:Connect(UI.setEnergy) R.LivesUpdate.OnClientEvent:Connect(UI.setLives) R.DashCooldown.OnClientEvent:Connect(UI.dashCooldown)
R.Toast.OnClientEvent:Connect(UI.toast) R.RoundResult.OnClientEvent:Connect(UI.showResult)
local reasons={SemEnergia=&quot;Sem energia suficiente&quot;,Cooldown=&quot;Aguarde o intervalo&quot;,ZonaProibida=&quot;Area protegida: afaste-se do checkpoint&quot;,ForaDoMapa=&quot;Escolha um ponto dentro da arena&quot;,Sobreposicao=&quot;Ja existe uma peca aqui&quot;,CaminhoBloqueado=&quot;Deixe espaco para passar&quot;,LimiteEpica=&quot;Espere a peca epica expirar&quot;,PecaInvalida=&quot;Peca nao permitida&quot;,Estado=&quot;Aguarde a corrida comecar&quot;}
R.PlaceResult.OnClientEvent:Connect(function(ok,reason) if not ok then UI.toast(reasons[reason] or tostring(reason),&quot;warn&quot;) end end)
UI.setRole(game:GetService(&quot;Players&quot;).LocalPlayer:GetAttribute(&quot;Role&quot;) or &quot;Lobby&quot;) R.ReadyForData:FireServer()
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000029A">
					<Properties>
						<string name="Name">SettingsController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Lighting=game:GetService(&quot;Lighting&quot;)
local S=require(RS.Modules.Settings)
local U=require(RS.Modules.Util)
local X={current=U.deepCopy(S.DEFAULTS)}
function X.apply(data)
 X.current=S.validate(data) Lighting.GlobalShadows=X.current.graphics.shadows
 local cam=workspace.CurrentCamera if cam then cam.FieldOfView=X.current.controls.fov end
 local bloom=Lighting:FindFirstChildOfClass(&quot;BloomEffect&quot;) if bloom then bloom.Enabled=X.current.graphics.bloom end
end
function X.toggle(category,key)
 local d=U.deepCopy(X.current)
 if type(d[category])==&quot;table&quot; and type(d[category][key])==&quot;boolean&quot; then d[category][key]=not d[category][key] X.apply(d) RS.Remotes.SaveSettings:FireServer(d) end
end
function X.init() RS.Remotes.SettingsLoad.OnClientEvent:Connect(X.apply) end
return X
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000029B">
					<Properties>
						<string name="Name">UIController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Players=game:GetService(&quot;Players&quot;)
local Tween=game:GetService(&quot;TweenService&quot;)
local C=require(RS.Modules.Config)
local U=require(RS.Modules.Util)
local Catalog=require(RS.Modules.PieceCatalog)
local UI={} local actions={} local root local header local role local detail local energy local energyTrack local timer local toast local dock local cards local selectedText local dash local menu local modal local result local balance
local buttons={} local fg=Color3.fromRGB(236,241,248) local muted=Color3.fromRGB(159,174,193) local bg=Color3.fromRGB(20,28,41) local accent=Color3.fromRGB(80,205,219)
local function text(p,s,size,pos,fs)
 local t=Instance.new(&quot;TextLabel&quot;) t.BackgroundTransparency=1 t.Text=s t.Size=size t.Position=pos t.Font=Enum.Font.GothamMedium t.TextSize=fs or 14 t.TextColor3=fg t.TextWrapped=true t.Parent=p return t
end
local function panel(p,size,pos)
 local f=Instance.new(&quot;Frame&quot;) f.Active=true f.Size=size f.Position=pos f.BackgroundColor3=bg f.BackgroundTransparency=.08 f.BorderSizePixel=0 f.Parent=p
 local c=Instance.new(&quot;UICorner&quot;) c.CornerRadius=UDim.new(0,10) c.Parent=f
 local s=Instance.new(&quot;UIStroke&quot;) s.Color=Color3.fromRGB(77,94,117) s.Transparency=.65 s.Parent=f return f
end
local function button(p,s,size,pos,fn)
 local b=Instance.new(&quot;TextButton&quot;) b.Size=size b.Position=pos b.Text=s b.Font=Enum.Font.GothamMedium b.TextSize=13 b.TextColor3=fg b.BackgroundColor3=Color3.fromRGB(35,47,65) b.BorderSizePixel=0 b.Parent=p
 local c=Instance.new(&quot;UICorner&quot;) c.CornerRadius=UDim.new(0,7) c.Parent=b
 b.MouseEnter:Connect(function() Tween:Create(b,TweenInfo.new(.12),{BackgroundColor3=Color3.fromRGB(48,65,85)}):Play() end)
 b.MouseLeave:Connect(function() Tween:Create(b,TweenInfo.new(.12),{BackgroundColor3=Color3.fromRGB(35,47,65)}):Play() end)
 b.Activated:Connect(fn) return b
end
local function hideModal() if modal then modal:Destroy() modal=nil end end
local function openModal(title,height)
 hideModal() menu.Visible=false
 local visibleHeight=math.min(height,workspace.CurrentCamera.ViewportSize.Y-24)
 modal=panel(root,UDim2.new(.9,0,0,visibleHeight),UDim2.fromScale(.5,.5)) modal.AnchorPoint=Vector2.new(.5,.5) modal.ZIndex=20
 local max=Instance.new(&quot;UISizeConstraint&quot;) max.MaxSize=Vector2.new(500,height) max.Parent=modal
 local body=Instance.new(&quot;ScrollingFrame&quot;) body.Size=UDim2.fromScale(1,1) body.BackgroundTransparency=1 body.BorderSizePixel=0 body.ScrollBarThickness=3 body.ScrollingDirection=Enum.ScrollingDirection.Y body.CanvasSize=UDim2.fromOffset(0,height) body.ClipsDescendants=true body.Active=true body.Parent=modal
 text(body,title,UDim2.new(1,-70,0,40),UDim2.fromOffset(14,8),19).TextXAlignment=Enum.TextXAlignment.Left
 button(modal,&quot;\u{d7}&quot;,UDim2.fromOffset(32,32),UDim2.new(1,-44,0,12),hideModal)
 return body
end
function UI.toast(s,kind)
 local token={} UI.token=token toast.Text=s toast.TextColor3=kind==&quot;bad&quot; and C.COLORS.DANGER or kind==&quot;good&quot; and C.COLORS.SUCCESS or fg toast.Visible=true toast.TextTransparency=1
 Tween:Create(toast,TweenInfo.new(.2),{TextTransparency=0}):Play()
 task.delay(3,function() if UI.token==token then toast.Visible=false end end)
end
function UI.setState(d)
 local names={WAITING=&quot;Esperando 2 jogadores&quot;,INTERMISSION=&quot;Proxima rodada&quot;,PREPARING=&quot;Prepare-se&quot;,RUNNING=&quot;Chegue ao final&quot;,ENDING=&quot;Rodada encerrada&quot;,RESET=&quot;Voltando ao lobby&quot;}
 header.Text=(names[d.state] or d.state)..(d.state==&quot;PREPARING&quot; and &quot; \u{b7} &quot;..(d.theme or &quot;&quot;) or &quot;&quot;)..(d.timeLeft&gt;0 and &quot;  \u{b7}  &quot;..U.formatTime(d.timeLeft) or &quot;&quot;)
 Tween:Create(timer,TweenInfo.new(.6),{Size=UDim2.fromScale(math.clamp(d.timeLeft/math.max(1,C.TIMES[d.state] or 150),0,1),1)}):Play()
 if d.state~=&quot;ENDING&quot; and result then result:Destroy() result=nil end
end
function UI.select(id)
 local d=Catalog.get(id) if not d then return end
 selectedText.Text=d.nome..&quot;  \u{b7}  &quot;..d.custo..&quot; energia&quot;
 for key,b in pairs(buttons) do b.TextColor3=key==id and accent or fg end
 if actions.select then actions.select(id) end
end
function UI.setRole(value)
 local build=value==&quot;Builder&quot; or value==&quot;Helper&quot;
 role.Text=({Builder=&quot;Construtor&quot;,Helper=&quot;Ajudante&quot;,Runner=&quot;Corredor&quot;,Lobby=&quot;Lobby&quot;,Spectator=&quot;Espectador&quot;})[value] or value
 dock.Visible=build energyTrack.Visible=build dash.Visible=value==&quot;Runner&quot; detail.Visible=build or value==&quot;Runner&quot;
 for _,b in pairs(buttons) do b:Destroy() end buttons={}
 if build then
  local list=Catalog.listForRole(value)
  for i,d in ipairs(list) do
   local b=button(cards,d.nome..&quot;\n&quot;..d.custo,UDim2.fromOffset(126,48),UDim2.fromOffset((i-1)*134,0),function() UI.select(d.id) end)
   buttons[d.id]=b
   local mark=Instance.new(&quot;Frame&quot;) mark.Size=UDim2.new(0,3,1,-16) mark.Position=UDim2.fromOffset(0,8) mark.BackgroundColor3=d.cor mark.BorderSizePixel=0 mark.Parent=b
  end
  cards.CanvasSize=UDim2.fromOffset(#list*134,0) if list[1] then UI.select(list[1].id) end
 end
end
function UI.setEnergy(n,max)
 detail.Text=string.format(&quot;%d / %d energia&quot;,math.floor(n),max)
 Tween:Create(energy,TweenInfo.new(.2),{Size=UDim2.fromScale(math.clamp(n/math.max(1,max),0,1),1)}):Play()
end
function UI.setLives(n) detail.Text=tostring(n)..&quot; vidas&quot; end
function UI.dashCooldown(seconds)
 local token={} UI.dashToken=token task.spawn(function() for i=math.ceil(seconds),1,-1 do if UI.dashToken~=token then return end dash.Text=&quot;Dash \u{b7} &quot;..i task.wait(1) end dash.Text=&quot;Dash \u{b7} Q&quot; end)
end
function UI.showResult(d)
 local content=openModal(d.winner==&quot;Runners&quot; and &quot;Corredores venceram&quot; or &quot;Construtor venceu&quot;,math.max(180,114+#d.podium*34)) result=modal
 local reward=text(content,&quot;+&quot;..d.rewards.coins..&quot; moedas   \u{b7}   +&quot;..d.rewards.xp..&quot; XP&quot;,UDim2.new(1,-32,0,28),UDim2.fromOffset(16,58),15) reward.TextColor3=accent
 for i,r in ipairs(d.podium) do
  local p=Players:GetPlayerByUserId(r.userId)
  local name=text(content,&quot;#&quot;..r.place..&quot;   &quot;..(p and p.DisplayName or tostring(r.userId)),UDim2.new(.7,-16,0,30),UDim2.fromOffset(16,100+(i-1)*34),14)
  name.TextWrapped=false name.TextTruncate=Enum.TextTruncate.AtEnd name.TextXAlignment=Enum.TextXAlignment.Left
  local points=text(content,r.points..&quot; pts&quot;,UDim2.new(.3,-16,0,30),UDim2.new(.7,0,0,100+(i-1)*34),13) points.TextXAlignment=Enum.TextXAlignment.Right points.TextColor3=muted
 end
end
local function help()
 local m=openModal(&quot;Como jogar&quot;,320)
 text(m,&quot;CORREDOR\nSiga as plataformas e salve os 3 checkpoints.\nQ: dash. Cair ou tocar um perigo custa uma vida.\n\nCONSTRUTOR\nEscolha uma peca e clique na pista.\nR: girar \u{b7} T: altura \u{b7} Z: desfazer.\n\nSem vidas? Ajude construindo plataformas.&quot;,UDim2.new(1,-32,1,-70),UDim2.fromOffset(16,60),14)
end
local function shop()
 local m=openModal(&quot;Loja&quot;,485)
 UI.shopBalance=text(m,&quot;Saldo: &quot;..tostring(UI.coins or 0)..&quot; moedas \u{b7} Apenas cosmeticos&quot;,UDim2.new(1,-32,0,28),UDim2.fromOffset(16,53),12) UI.shopBalance.TextColor3=muted
 for i,d in ipairs(require(RS.Modules.PassCatalog)) do
  local b=button(m,d.name..&quot; \u{b7} &quot;..(d.id&gt;0 and &quot;Ver preco&quot; or &quot;Em breve&quot;),UDim2.new(1,-32,0,44),UDim2.fromOffset(16,94+(i-1)*88),function()
   if Players.LocalPlayer:GetAttribute(d.attribute) then UI.toast(&quot;Voce ja possui este passe.&quot;,&quot;info&quot;) return end
   if d.id==0 then UI.toast(&quot;Disponivel em breve.&quot;,&quot;info&quot;) return end
   local ok=pcall(function() game:GetService(&quot;MarketplaceService&quot;):PromptGamePassPurchase(Players.LocalPlayer,d.id) end) if not ok then UI.toast(&quot;Loja indisponivel no momento.&quot;,&quot;warn&quot;) end
  end)
  text(m,d.description,UDim2.new(1,-40,0,36),UDim2.fromOffset(20,140+(i-1)*88),12).TextColor3=muted
  if d.id&gt;0 then task.spawn(function() local ok,info=pcall(function() return game:GetService(&quot;MarketplaceService&quot;):GetProductInfo(d.id,Enum.InfoType.GamePass) end) if ok and b.Parent then b.Text=d.name..&quot; \u{b7} &quot;..(info.IsForSale and tostring(info.PriceInRobux)..&quot; Robux&quot; or &quot;Indisponivel&quot;) end end) end
 end
 text(m,&quot;COM MOEDAS \u{b7} Se ja possui, equipa sem cobrar&quot;,UDim2.new(1,-32,0,24),UDim2.fromOffset(16,310),11).TextColor3=muted
 for i,c in ipairs(require(RS.Modules.CosmeticCatalog)) do
  button(m,c.name..&quot; \u{b7} &quot;..c.cost..&quot; moedas&quot;,UDim2.new(1,-32,0,36),UDim2.fromOffset(16,342+(i-1)*44),function() RS.Remotes.BuyCosmetic:FireServer(c.id) end)
 end
end
local function settings()
 local m=openModal(&quot;Opcoes&quot;,265)
 button(m,&quot;Reduzir flashes: alternar&quot;,UDim2.new(1,-32,0,40),UDim2.fromOffset(16,65),function() actions.setting(&quot;accessibility&quot;,&quot;reduceFlashes&quot;) end)
 button(m,&quot;Sombras: alternar&quot;,UDim2.new(1,-32,0,40),UDim2.fromOffset(16,115),function() actions.setting(&quot;graphics&quot;,&quot;shadows&quot;) end)
 button(m,&quot;Acenar \u{b7} G&quot;,UDim2.new(1,-32,0,40),UDim2.fromOffset(16,165),function() RS.Remotes.Emote:FireServer(&quot;Emote1&quot;) end)
end
function UI.init(callbacks)
 actions=callbacks or {}
 local gui=Instance.new(&quot;ScreenGui&quot;) gui.Name=&quot;ConstrutorVsCorredores&quot; gui.ResetOnSpawn=false gui.DisplayOrder=10 gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling gui.Parent=Players.LocalPlayer:WaitForChild(&quot;PlayerGui&quot;)
 root=Instance.new(&quot;Frame&quot;) root.BackgroundTransparency=1 root.Size=UDim2.fromScale(1,1) root.Parent=gui
 local top=panel(root,UDim2.new(.65,0,0,50),UDim2.new(.5,0,0,10)) top.AnchorPoint=Vector2.new(.5,0)
 local limit=Instance.new(&quot;UISizeConstraint&quot;) limit.MaxSize=Vector2.new(400,50) limit.Parent=top
 header=text(top,&quot;Carregando...&quot;,UDim2.new(1,-20,1,-4),UDim2.fromOffset(10,0),14)
 local track=Instance.new(&quot;Frame&quot;) track.Size=UDim2.new(1,-20,0,2) track.Position=UDim2.new(0,10,1,-3) track.BorderSizePixel=0 track.BackgroundColor3=Color3.fromRGB(45,59,76) track.Parent=top
 timer=Instance.new(&quot;Frame&quot;) timer.BorderSizePixel=0 timer.Size=UDim2.fromScale(0,1) timer.BackgroundColor3=accent timer.Parent=track
 local status=panel(root,UDim2.new(.42,0,0,58),UDim2.fromOffset(12,72)) local cap=Instance.new(&quot;UISizeConstraint&quot;) cap.MaxSize=Vector2.new(210,58) cap.Parent=status
 role=text(status,&quot;Lobby&quot;,UDim2.new(1,-20,0,26),UDim2.fromOffset(10,2),14) role.TextXAlignment=Enum.TextXAlignment.Left
 detail=text(status,&quot;&quot;,UDim2.new(1,-20,0,22),UDim2.fromOffset(10,27),12) detail.TextColor3=muted detail.TextXAlignment=Enum.TextXAlignment.Left
 energyTrack=Instance.new(&quot;Frame&quot;) energyTrack.Size=UDim2.new(1,-20,0,2) energyTrack.Position=UDim2.new(0,10,1,-4) energyTrack.BackgroundTransparency=1 energyTrack.Parent=status
 energy=Instance.new(&quot;Frame&quot;) energy.Size=UDim2.fromScale(1,1) energy.BackgroundColor3=accent energy.BorderSizePixel=0 energy.Parent=energyTrack
 menu=panel(root,UDim2.fromOffset(184,232),UDim2.new(1,-196,0,64)) menu.Visible=false menu.ZIndex=10
 balance=text(menu,&quot;0 moedas \u{b7} Nivel 1&quot;,UDim2.new(1,-16,0,38),UDim2.fromOffset(8,5),12) balance.TextColor3=muted
 for i,item in ipairs({{&quot;Como jogar&quot;,help},{&quot;Loja&quot;,shop},{&quot;Opcoes&quot;,settings},{&quot;Acenar&quot;,function() RS.Remotes.Emote:FireServer(&quot;Emote1&quot;) end}}) do button(menu,item[1],UDim2.new(1,-16,0,36),UDim2.fromOffset(8,46+(i-1)*44),item[2]) end
 button(root,&quot;\u{2630}&quot;,UDim2.fromOffset(40,40),UDim2.new(1,-52,0,10),function() menu.Visible=not menu.Visible hideModal() end)
 toast=text(root,&quot;&quot;,UDim2.new(.8,0,0,44),UDim2.new(.1,0,0,140),14) toast.Visible=false toast.ZIndex=50
 dock=panel(root,UDim2.new(1,-24,0,134),UDim2.new(0,12,1,-146)) dock.Visible=false
 selectedText=text(dock,&quot;&quot;,UDim2.new(.5,0,0,28),UDim2.fromOffset(10,0),12) selectedText.TextXAlignment=Enum.TextXAlignment.Left
 for i,item in ipairs({{&quot;Girar \u{b7} R&quot;,function() actions.rotate() end},{&quot;Altura \u{b7} T&quot;,function() actions.height() end},{&quot;Desfazer \u{b7} Z&quot;,function() RS.Remotes.UndoPiece:FireServer() end}}) do button(dock,item[1],UDim2.new(.31,0,0,30),UDim2.new(.02+(i-1)*.33,0,0,32),item[2]) end
 cards=Instance.new(&quot;ScrollingFrame&quot;) cards.Size=UDim2.new(1,-20,0,57) cards.Position=UDim2.fromOffset(10,70) cards.BackgroundTransparency=1 cards.BorderSizePixel=0 cards.ScrollBarThickness=3 cards.ScrollingDirection=Enum.ScrollingDirection.X cards.Parent=dock
 dash=button(root,&quot;Dash \u{b7} Q&quot;,UDim2.fromOffset(106,46),UDim2.new(1,-118,1,-70),function() RS.Remotes.UseDash:FireServer() end) dash.Visible=false
 RS.Remotes.StatsUpdate.OnClientEvent:Connect(function(d) UI.coins=d.coins or 0 balance.Text=tostring(UI.coins)..&quot; moedas \u{b7} Nivel &quot;..tostring(d.level or 1) if UI.shopBalance and UI.shopBalance.Parent then UI.shopBalance.Text=&quot;Saldo: &quot;..tostring(UI.coins)..&quot; moedas \u{b7} Apenas cosmeticos&quot; end end)
 return UI
end
return UI
</ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX0000029C">
					<Properties>
						<string name="Name">VFXController</string>
						<ProtectedString name="Source">local RS=game:GetService(&quot;ReplicatedStorage&quot;)
local Tween=game:GetService(&quot;TweenService&quot;)
local Run=game:GetService(&quot;RunService&quot;)
local Debris=game:GetService(&quot;Debris&quot;)
local Settings=require(script.Parent.SettingsController)
local V={} local animated={} local last=0
local function burst(pos,color)
 if (workspace.CurrentCamera.CFrame.Position-pos).Magnitude&gt;Settings.current.graphics.effectDistance then return end
 if Settings.current.graphics.particles==&quot;Desligadas&quot; then return end
 local count=Settings.current.graphics.particles==&quot;Reduzidas&quot; and 5 or 12
 for i=1,count do
  local p=Instance.new(&quot;Part&quot;) p.Size=Vector3.new(.18,.18,.18) p.Anchored=true p.CanCollide=false p.CanTouch=false p.CanQuery=false p.Material=Enum.Material.Neon p.Color=color p.Position=pos p.Parent=workspace
  local a=i*math.pi*2/count
  Tween:Create(p,TweenInfo.new(.55,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Position=pos+Vector3.new(math.cos(a)*3,1+math.random()*2,math.sin(a)*3),Transparency=1,Size=Vector3.new(.03,.03,.03)}):Play() Debris:AddItem(p,.6)
 end
end
local function track(model)
 local parts={}
 for _,p in ipairs(model:GetDescendants()) do
  if p:IsA(&quot;BasePart&quot;) and p.Name~=&quot;Colisao&quot; then
   local size=p.Size p.Size=size*.85 Tween:Create(p,TweenInfo.new(.3,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Size=size}):Play()
   if p.Name==&quot;Helice&quot; or p.Name==&quot;Disco de corte&quot; or p.Name==&quot;Runas&quot; or p.Name==&quot;Faisca&quot; or p.Name==&quot;Lente&quot; then table.insert(parts,{p=p,cf=p.CFrame,color=p.Color}) end
  end
 end
 if #parts&gt;0 then animated[model]=parts end
end
function V.init()
 local folder=workspace:WaitForChild(&quot;PiecesActive&quot;) folder.ChildAdded:Connect(function(m) task.delay(.15,function() if m.Parent then track(m) end end) end)
 folder.ChildRemoved:Connect(function(m) animated[m]=nil end)
 Run.RenderStepped:Connect(function(dt)
  local now=os.clock()
  for model,parts in pairs(animated) do
   if not model.Parent then animated[model]=nil else
    for _,r in ipairs(parts) do if r.p.Parent then
     if r.p.Name==&quot;Helice&quot; then r.p.CFrame=r.cf*CFrame.Angles(0,now*4,0)
     elseif r.p.Name==&quot;Disco de corte&quot; then r.p.CFrame=CFrame.new(r.p.Position)*r.cf.Rotation*CFrame.Angles(0,0,now*3)
     elseif not Settings.current.accessibility.reduceFlashes then r.p.Transparency=.15+.2*math.sin(now*3)^2 end
    end end
   end
  end
 end)
 RS.Remotes.PieceActivated.OnClientEvent:Connect(function(id,pos)
  if os.clock()-last&lt;.12 then return end last=os.clock() burst(pos,Color3.fromRGB(39,224,255))
 end)
 RS.Remotes.ReachedFinish.OnClientEvent:Connect(function(userId)
  local p=game:GetService(&quot;Players&quot;):GetPlayerByUserId(userId) local root=p and p.Character and p.Character:FindFirstChild(&quot;HumanoidRootPart&quot;)
  if root then burst(root.Position,Color3.fromRGB(255,204,69)) end
 end)
 RS.Remotes.ScreenFX.OnClientEvent:Connect(function(kind,intensity)
  if Settings.current.accessibility.reduceFlashes or kind~=&quot;flash&quot; then return end
  local e=Instance.new(&quot;ColorCorrectionEffect&quot;) e.TintColor=Color3.fromRGB(255,195,210) e.Brightness=math.clamp(intensity,0,.1) e.Parent=workspace.CurrentCamera
  Tween:Create(e,TweenInfo.new(.35),{Brightness=0,TintColor=Color3.new(1,1,1)}):Play() Debris:AddItem(e,.4)
 end)
end
return V
</ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="Lighting" referent="RBX0000029F">
		<Properties>
			<Color3 name="Ambient">
				<R>0.25</R>
				<G>0.25</G>
				<B>0.430000007</B>
			</Color3>
			<float name="Brightness">2</float>
			<float name="ClockTime">14</float>
			<float name="FogEnd">900</float>
			<bool name="GlobalShadows">true</bool>
			<string name="Name">Lighting</string>
			<Color3 name="OutdoorAmbient">
				<R>0.219999999</R>
				<G>0.170000002</G>
				<B>0.349999994</B>
			</Color3>
		</Properties>
		<Item class="BloomEffect" referent="RBX000002A0">
			<Properties>
				<float name="Intensity">0.25</float>
				<string name="Name">NeonBloom</string>
				<float name="Size">24</float>
				<float name="Threshold">1.10000002</float>
			</Properties>
		</Item>
	</Item>
	<Item class="SoundService" referent="RBX000002A1">
		<Properties>
			<string name="Name">SoundService</string>
		</Properties>
	</Item>
	<Item class="StarterGui" referent="RBX000002A2">
		<Properties>
			<string name="Name">StarterGui</string>
		</Properties>
	</Item>
</roblox>