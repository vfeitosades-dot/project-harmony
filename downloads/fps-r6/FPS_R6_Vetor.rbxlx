					<ProtectedString name="Source">local system=game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;FPSSystem&quot;)
local modules=system:WaitForChild(&quot;Modules&quot;)
local cleanup=require(modules.LoadoutController).init()
