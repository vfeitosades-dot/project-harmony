	<Item class="ReplicatedStorage" referent="FPS1995">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="FPS1996">
			<Properties>
				<string name="Name">FPSSystem</string>
