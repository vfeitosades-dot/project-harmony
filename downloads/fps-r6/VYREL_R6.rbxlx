le&quot;]={0,0.29,-2.8750000000000004},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.46,-0.6},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;LYRA&quot;]={[&quot;AimPoint&quot;]={0,0.96,0.52},[&quot;Muzzle&quot;]={0,0.29,-2.8750000000000004},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.46,0.6},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;FERAL&quot;]={[&quot;AimPoint&quot;]={0,0.96,0.52},[&quot;Muzzle&quot;]={0,0.29,-2.325},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.59,-0.48},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;PULSAR&quot;]={[&quot;AimPoint&quot;]={0,0.96,0.52},[&quot;Muzzle&quot;]={0,0.29,-2.325},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-1.02,-0.57},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;BASIL&quot;]={[&quot;AimPoint&quot;]={0,1.04,0.5},[&quot;Muzzle&quot;]={0,0.29,-3.575},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.36,-0.6},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;ARGO&quot;]={[&quot;AimPoint&quot;]={0,1.04,0.5},[&quot;Muzzle&quot;]={0,0.29,-3.575},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.36,-0.6},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;TORQ&quot;]={[&quot;AimPoint&quot;]={0,0.96,0.52},[&quot;Muzzle&quot;]={0,0.29,-3.45},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.47,-0.7},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;MAREA&quot;]={[&quot;AimPoint&quot;]={0,0.59,0.52},[&quot;Muzzle&quot;]={0,0.29,-3.575},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.46,-0.65},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;RUPTURA&quot;]={[&quot;AimPoint&quot;]={0,0.59,0.52},[&quot;Muzzle&quot;]={0,0.29,-3.2},[&quot;LeftGrip&quot;]={-0.3,-0.08,-0.95},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.05,-0.3,0.12},[&quot;MagazinePivot&quot;]={0,-0.46,-0.65},[&quot;StockPivot&quot;]={0,0.13,1.16}},[&quot;VESPER&quot;]={[&quot;AimPoint&quot;]={0,0.57,0.48},[&quot;Muzzle&quot;]={0,0.29,-1.225},[&quot;LeftGrip&quot;]={-0.25,-0.18,0.05},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.04,-0.29,0.12},[&quot;MagazinePivot&quot;]={0,-0.65,0.14},[&quot;StockPivot&quot;]={0,0,0}},[&quot;NOMAD&quot;]={[&quot;AimPoint&quot;]={0,0.57,0.48},[&quot;Muzzle&quot;]={0,0.29,-1.029},[&quot;LeftGrip&quot;]={-0.25,-0.18,0.05},[&quot;WorldLeftGrip&quot;]={-0.58,-0.08,-0.24},[&quot;RightGripPoint&quot;]={0.04,-0.29,0.12},[&quot;MagazinePivot&quot;]={0,-0.65,0.14},[&quot;StockPivot&quot;]={0,0,0}}}}
