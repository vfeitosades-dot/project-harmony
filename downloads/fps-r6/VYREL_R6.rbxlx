					<string name="Name">FPSObserver</string>
					<ProtectedString name="Source">local system=game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;FPSSystem&quot;)
local modules=system:WaitForChild(&quot;Modules&quot;)
local cleanup=require(modules.LoadoutController).init()
local matchCleanup=require(modules.MatchHUD).init()
local abilityCleanup=require(modules.AbilityController).init()
local spawnCleanup=require(modules.SpawnGuard).init()
local menuCleanup=require(modules.GameMenu).init()
script.Destroying:Connect(function() cleanup() matchCleanup() abilityCleanup() spawnCleanup() menuCleanup() end)
require(modules.ThirdPersonController).init(false)
</ProtectedString>
				</Properties>
			</Item>
