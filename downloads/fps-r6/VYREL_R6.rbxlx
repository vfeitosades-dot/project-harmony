   text(card,&quot;Votes&quot;,(chosen and &quot;SEU VOTO  /  &quot; or &quot;VOTAR  /  &quot;)..tostring(vote.Counts[id] or 0),UDim2.new(1,-24,0,34),UDim2.new(0,12,1,-44),13,chosen and accent or white)
