		<Item class="Script" referent="FPS2647">
			<Properties>
				<bool name="Disabled">false</bool>
				<string name="Name">GameServer</string>
				<ProtectedString name="Source">local modules=game:GetService(&quot;ReplicatedStorage&quot;):WaitForChild(&quot;FPSSystem&quot;):WaitForChild(&quot;Modules&quot;)
require(modules.SessionService).Init()
require(modules.SkillService).Init()
require(modules.BotService).Init()
</ProtectedString>
