  for i,id in ipairs(vote.Options) do local data=Maps.Maps[id] local chosen=vote.MyVote==id local accent=Color3.fromRGB(table.unpack(data.Color))
   local card=button(pageRoot,&quot;Vote&quot;..id,&quot;&quot;,compact and UDim2.new(1,-48,0,146) or UDim2.new(.3,0,.7,0),compact and UDim2.fromOffset(24,90+(i-1)*154) or UDim2.new(.025+(i-1)*.325,0,0,100),function() send(&quot;VoteMap&quot;,id) end,false)
