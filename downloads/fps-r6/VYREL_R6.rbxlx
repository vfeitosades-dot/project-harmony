 local function play()
  title(&quot;ESCOLHA SEU CAMPO&quot;,&quot;TRES FORMAS DE JOGAR   /   UM UNICO ARSENAL&quot;)
  local choices={{&quot;Casual&quot;,&quot;CASUAL&quot;,&quot;ESQUADRAO VS SENTINELAS&quot;,&quot;Vote no mapa e entre em partidas de 5 minutos contra bots taticos. Ganhe creditos e domine seu operador.&quot;},{&quot;Ranked&quot;,&quot;RANQUEADO&quot;,&quot;DUELO PVP / PRIMEIRO A 5&quot;,&quot;Adversarios humanos neste servidor. Vitorias e derrotas ajustam sua classificacao; bots nao alteram Elo.&quot;},{&quot;Training&quot;,&quot;TREINAMENTO&quot;,&quot;ARSENAL LIVRE&quot;,&quot;Escolha o cenario e pratique contra alvos, sem precisar comprar o equipamento.&quot;}}
  for i,d in ipairs(choices) do
   local size=compact and UDim2.new(1,-48,0,132) or UDim2.new(.3,0,.66,0)
   local pos=compact and UDim2.fromOffset(24,88+(i-1)*140) or UDim2.new(.025+(i-1)*.325,0,0,96)
   local card=frame(pageRoot,&quot;Mode&quot;..i,size,pos,.08,Color3.fromRGB(20,34,52)) line(card,1,UDim2.fromScale(0,0),i==2 and Color3.fromRGB(173,144,245) or coral)
   text(card,&quot;Index&quot;,&quot;0&quot;..i,UDim2.fromOffset(80,40),UDim2.new(1,-94,0,8),32,Color3.fromRGB(72,87,109))
   text(card,&quot;Name&quot;,d[2],UDim2.new(1,-28,0,40),UDim2.fromOffset(14,12),compact and 20 or 25)
   text(card,&quot;Type&quot;,d[3],UDim2.new(1,-28,0,32),UDim2.fromOffset(14,48),10,coral)
   text(card,&quot;Description&quot;,d[4],UDim2.new(1,-28,compact and 0 or .4,compact and 0 or 0),UDim2.fromOffset(14,90),12,muted).Visible=not compact
   if not compact then
    local zone=frame(card,&quot;Emblem&quot;,UDim2.new(1,-28,.24,0),UDim2.new(0,14,.27,0),.65)
    local color=i==1 and coral or i==2 and Color3.fromRGB(178,148,255) or Color3.fromRGB(103,229,224)
    for n=1,3 do local shard=frame(zone,&quot;Shard&quot;..n,UDim2.fromOffset(22,n==2 and 66 or 43),UDim2.new(.5,(n-2)*32-11,.5,n==2 and -33 or -21),.15,color) shard.Rotation=i==2 and 45 or -12 end
    card.Description.Position=UDim2.new(0,14,.55,0) card.Description.Size=UDim2.new(1,-28,.2,0)
   end
   button(card,&quot;Start&quot;,state.Queued and d[1]==&quot;Ranked&quot; and &quot;BUSCANDO...&quot; or d[1]==&quot;Ranked&quot; and &quot;BUSCAR DUELO&quot; or &quot;ESCOLHER MAPA&quot;,UDim2.new(1,-28,0,compact and 32 or 44),UDim2.new(0,14,1,compact and -42 or -58),function() send(&quot;Play&quot;,d[1]) end,i==1)
  end
  if state.Queued then button(pageRoot,&quot;CancelQueue&quot;,&quot;CANCELAR BUSCA&quot;,UDim2.fromOffset(230,34),UDim2.new(.5,-115,1,-42),function() send(&quot;CancelQueue&quot;) end,false) end
 end
 local function mapPreview(parent,id)
  local viewport=Instance.new(&quot;ViewportFrame&quot;) viewport.Name=&quot;Map_&quot;..id viewport.Size=UDim2.new(1,-8,.46,0) viewport.Position=UDim2.new(0,4,0,82) viewport.BackgroundColor3=Color3.fromRGB(24,37,54) viewport.BackgroundTransparency=.15 viewport.Active=false viewport.ZIndex=(parent.ZIndex or 1)+1 viewport.Ambient=Color3.fromRGB(181,186,204) viewport.LightColor=Color3.fromRGB(255,232,208) viewport.LightDirection=Vector3.new(-1,-2,-1) viewport.Parent=parent
  local assets=system:FindFirstChild(&quot;Assets&quot;) local models=assets and assets:FindFirstChild(&quot;MapPreviews&quot;) local source=models and models:FindFirstChild(id)
  if source then local world=Instance.new(&quot;WorldModel&quot;) world.Parent=viewport source:Clone().Parent=world end
  local camera=Instance.new(&quot;Camera&quot;) camera.FieldOfView=48 camera.CFrame=CFrame.lookAt(Vector3.new(145,155,180),Vector3.new(0,5,0)) camera.Parent=viewport viewport.CurrentCamera=camera return viewport
 end
 local function votePage()
  local vote=state.Vote title(&quot;ESCOLHA O PROXIMO MAPA&quot;,&quot;SEU VOTO DEFINE O CAMPO   /   &quot;..(vote.Mode==&quot;Ranked&quot; and &quot;DUELO COMPETITIVO&quot; or vote.Mode==&quot;Casual&quot; and &quot;CASUAL&quot; or &quot;TREINAMENTO&quot;))
