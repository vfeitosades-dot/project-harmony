  local b=button(top,&quot;Nav&quot;..i,name,(compact and UDim2.new(1/7,-10,0,30) or UDim2.fromOffset(99,34)),pos,function() choose(name) end,false,true) b.TextSize=compact and 8 or 12 b.BackgroundTransparency=1 local stroke=b:FindFirstChildOfClass(&quot;UIStroke&quot;) if stroke then stroke.Transparency=1 end local indicator=line(b,1,UDim2.new(0,0,1,-2),coral) indicator.Name=&quot;SelectionLine&quot; indicator.Visible=false currentNav[name]=b
 end
