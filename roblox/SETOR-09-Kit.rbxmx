{Name="SerialEtch",Size=Vector3.new(0.014,0.015,0.22),Offset=CFrame.new(-0.201,0.015,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(31,41,37),Material=Enum.Material.Metal,Shape=Enum.PartType.Block},
{Name="SerialEtch",Size=Vector3.new(0.014,0.015,0.22),Offset=CFrame.new(-0.201,-0.010000000000000002,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(31,41,37),Material=Enum.Material.Metal,Shape=Enum.PartType.Block},
{Name="SerialEtch",Size=Vector3.new(0.014,0.015,0.22),Offset=CFrame.new(-0.201,-0.03500000000000001,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(31,41,37),Material=Enum.Material.Metal,Shape=Enum.PartType.Block},
{Name="GlovePalm",Size=Vector3.new(0.31,0.28,0.32),Offset=CFrame.new(0.03,-0.23,0.09)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(45,42,35),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="Finger",Size=Vector3.new(0.075,0.16,0.13),Offset=CFrame.new(-0.105,-0.11,0.1)*CFrame.Angles(math.rad(-14),math.rad(0),math.rad(0)),Color=Color3.fromRGB(58,54,44),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="KnucklePad",Size=Vector3.new(0.063,0.065,0.08),Offset=CFrame.new(-0.105,-0.035,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(32,34,30),Material=Enum.Material.SmoothPlastic,Shape=Enum.PartType.Block},
{Name="Finger",Size=Vector3.new(0.075,0.16,0.13),Offset=CFrame.new(-0.03,-0.11,0.1)*CFrame.Angles(math.rad(-14),math.rad(0),math.rad(0)),Color=Color3.fromRGB(58,54,44),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="KnucklePad",Size=Vector3.new(0.063,0.065,0.08),Offset=CFrame.new(-0.03,-0.035,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(32,34,30),Material=Enum.Material.SmoothPlastic,Shape=Enum.PartType.Block},
{Name="Finger",Size=Vector3.new(0.075,0.16,0.13),Offset=CFrame.new(0.045,-0.11,0.1)*CFrame.Angles(math.rad(-14),math.rad(0),math.rad(0)),Color=Color3.fromRGB(58,54,44),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="KnucklePad",Size=Vector3.new(0.063,0.065,0.08),Offset=CFrame.new(0.045,-0.035,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(32,34,30),Material=Enum.Material.SmoothPlastic,Shape=Enum.PartType.Block},
{Name="Finger",Size=Vector3.new(0.075,0.16,0.13),Offset=CFrame.new(0.11999999999999998,-0.11,0.1)*CFrame.Angles(math.rad(-14),math.rad(0),math.rad(0)),Color=Color3.fromRGB(58,54,44),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="KnucklePad",Size=Vector3.new(0.063,0.065,0.08),Offset=CFrame.new(0.11999999999999998,-0.035,0.1)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(32,34,30),Material=Enum.Material.SmoothPlastic,Shape=Enum.PartType.Block},
{Name="Thumb",Size=Vector3.new(0.12,0.22,0.14),Offset=CFrame.new(0.2,-0.14,0.0)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(-24)),Color=Color3.fromRGB(55,51,42),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="Wrist",Size=Vector3.new(0.29,0.27,0.24),Offset=CFrame.new(0.03,-0.28,0.37)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(42,43,35),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="Cuff",Size=Vector3.new(0.38,0.34,0.18),Offset=CFrame.new(0.06,-0.3,0.53)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(28,34,31),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="Sleeve",Size=Vector3.new(0.39,0.37,0.83),Offset=CFrame.new(0.17,-0.35,1.0)*CFrame.Angles(math.rad(0),math.rad(12),math.rad(0)),Color=Color3.fromRGB(62,70,58),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="CuffStitch",Size=Vector3.new(0.32,0.016,0.02),Offset=CFrame.new(0.06,-0.118,0.48)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(119,118,91),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="CuffStitch",Size=Vector3.new(0.32,0.016,0.02),Offset=CFrame.new(0.06,-0.118,0.535)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(119,118,91),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block},
{Name="CuffStitch",Size=Vector3.new(0.32,0.016,0.02),Offset=CFrame.new(0.06,-0.118,0.59)*CFrame.Angles(math.rad(0),math.rad(0),math.rad(0)),Color=Color3.fromRGB(119,118,91),Material=Enum.Material.Fabric,Shape=Enum.PartType.Block}}
function V.Flashlight(parent)
    local model=Instance.new("Model") model.Name="Setor09_Flashlight_V2" model.Parent=parent
    local parts={}
    for _,d in ipairs(design) do
        local p=V.Part(model,d.Name,d.Size,d.Offset,d.Color,d.Material)
        p.Shape=d.Shape
        if d.Name=="Lens" then p.Transparency=0.6 end
        table.insert(parts,{p=p,cf=d.Offset})
    end
    local emitter=V.Part(model,"Emitter",Vector3.new(.02,.02,.02),CFrame.new(0,0,-1.25),Color3.new()) emitter.Transparency=1
    table.insert(parts,{p=emitter,cf=CFrame.new(0,0,-1.25)})
    local function beam(name,brightness,angle,range,shadows)
        local l=Instance.new("SpotLight") l.Name=name l.Face=Enum.NormalId.Front l.Color=Color3.fromRGB(255,242,214)
        l.Brightness=brightness l.Angle=angle l.Range=range l.Shadows=shadows l.Parent=emitter return l
    end
    local core=beam("Hotspot",7.2,48,60,true)
    local spill=beam("Spill",1.6,94,38,true)
    local fill=Instance.new("PointLight") fill.Name="NearFill" fill.Color=Color3.fromRGB(236,226,202) fill.Brightness=.22 fill.Range=7 fill.Shadows=true fill.Parent=emitter
    return model,parts,core,{spill,fill}
end
function V.Pose(parts,cf)
    for _,v in ipairs(parts) do v.p.CFrame=cf*v.cf end
end
return V
</ProtectedString>
