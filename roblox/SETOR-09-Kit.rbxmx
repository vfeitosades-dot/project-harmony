    <string name="Name">Visuals</string>
    <ProtectedString name="Source">local V={}
function V.Part(parent,name,size,offset,color,material)
    local p=Instance.new("Part") p.Name=name p.Size=size p.CFrame=offset
    p.Color=color p.Material=material or Enum.Material.Metal
    p.Anchored=true p.CanCollide=false p.CanTouch=false p.CanQuery=false p.CastShadow=false
    p.TopSurface=Enum.SurfaceType.Smooth p.BottomSurface=Enum.SurfaceType.Smooth p.Parent=parent
    return p
end

