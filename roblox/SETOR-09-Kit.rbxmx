  <Item class="Script" referent="RBX4">
   <Properties>
    <string name="Name">Server</string>
    <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Tween=game:GetService("TweenService")
local kit=script.Parent
if RS:FindFirstChild("Setor09") then warn("SETOR 09 duplicado: remova uma copia.") return end
local C=require(kit.Config)
local map=kit:WaitForChild("Labirinto")
local net=Instance.new("Folder") net.Name="Setor09" net.Parent=RS
kit.Config:Clone().Parent=net kit.Visuals:Clone().Parent=net
local action=Instance.new("RemoteEvent") action.Name="Action" action.Parent=net
local event=Instance.new("RemoteEvent") event.Name="Event" event.Parent=net
local rng=Random.new()
local code=C.FixedCode
if type(code)~="string" or not code:match("^%d%d%d$") then code=string.format("%03d",rng:NextInteger(0,999)) end
local exit=map.Exit
local state={}
local boards=3
local codeOpen,keyOpen,doorOpen=false,false,false
local doorParts={}
for _,v in ipairs(exit.Door:GetDescendants()) do
    if v:IsA("BasePart") then
        v.Anchored=false v.Massless=true
        local w=Instance.new("WeldConstraint") w.Part0=exit.Door w.Part1=v w.Parent=v
        table.insert(doorParts,v)
    end
end
local function living(p)
    local char=p.Character
    local h=char and char:FindFirstChildOfClass("Humanoid")
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if h and root and h.Health&gt;0 then return char,h,root end
end
local function near(p,part)
    local _,_,root=living(p)
    return root and (root.Position-part.Position).Magnitude&lt;=C.InteractDistance+2
end
local function send(p,kind,payload) event:FireClient(p,kind,payload) end
local function sync(p)
    local s=state[p] if not s then return end
    send(p,"State",{key=s.key,crowbar=s.crowbar,clue=s.clue,code=s.clue and code or "",
        boards=boards,keyOpen=keyOpen,codeOpen=codeOpen,doorOpen=doorOpen,escaped=s.escaped})
end
local function syncAll() for p in pairs(state) do sync(p) end end
local function message(p,t) send(p,"Message",t) end
local function tryDoor()
    if doorOpen or not keyOpen or not codeOpen or boards&gt;0 then return end
    doorOpen=true
    event:FireAllClients("DoorOpened",true)
    task.delay(1.8,function() exit.Door.CanCollide=false end)
    Tween:Create(exit.Door,TweenInfo.new(1.8,Enum.EasingStyle.Sine),{CFrame=exit.Door.CFrame*CFrame.new(0,11,0)}):Play()
    exit.ExitLamp.Color=Color3.fromRGB(125,224,171)
    local exitLight=exit.ExitLamp:FindFirstChildOfClass("PointLight")
    if exitLight then exitLight.Color=exit.ExitLamp.Color end
    for p in pairs(state) do message(p,"A saída abriu. Vá até o fim do corredor.") end
    syncAll()
end
local function prompt(part,label,object,hold,callback)
    local pr=Instance.new("ProximityPrompt") pr.ActionText=label pr.ObjectText=object
    pr.HoldDuration=hold or 0 pr.MaxActivationDistance=C.InteractDistance
    pr.Style=Enum.ProximityPromptStyle.Custom
    pr.RequiresLineOfSight=true pr.KeyboardKeyCode=Enum.KeyCode.E pr.Parent=part
    pr.Triggered:Connect(function(p) if state[p] and near(p,part) then callback(p,pr) end end)
    return pr
end
prompt(map.Key.PickupPoint,"Pegar chave","CHAVE DE SERVIÇO",0.4,function(p)
    if state[p].key then return end state[p].key=true sync(p) send(p,"Pickup","Key") message(p,"Chave encontrada. Procure a fechadura da saída.")
end)
prompt(map.Crowbar.PickupPoint,"Pegar pé de cabra","FERRAMENTA",0.4,function(p)
    if state[p].crowbar then return end state[p].crowbar=true sync(p) send(p,"Pickup","Crowbar") message(p,"Pé de cabra encontrado. Agora você pode remover as tábuas.")
end)
prompt(map.Note.PickupPoint,"Ler bilhete","REGISTRO DE MANUTENÇÃO",0.2,function(p)
    state[p].clue=true sync(p) send(p,"Note",code)
end)
prompt(exit.Keypad,"Usar teclado","TRAVA ELETRÔNICA",0,function(p)
    if codeOpen then message(p,"Trava eletrônica já liberada.") return end
    send(p,"Keypad",true)
end)
prompt(exit.Lock,"Usar chave","FECHADURA",0.8,function(p,pr)
    if keyOpen then message(p,"Fechadura já aberta.") return end
    if not state[p].key then message(p,"Você precisa encontrar a chave de serviço.") return end
    keyOpen=true pr.Enabled=false message(p,"Fechadura aberta.") syncAll() tryDoor()
end)
local boardList=exit.Boards:GetChildren()
table.sort(boardList,function(a,b) return a.Name&lt;b.Name end)
for _,b in ipairs(boardList) do
    prompt(b,"Arrancar tábua","TÁBUAS PREGADAS",1.1,function(p,pr)
        if not state[p].crowbar then message(p,"As tábuas estão pregadas. Encontre um pé de cabra.") return end
        if b:GetAttribute("Removed") then return end
        b:SetAttribute("Removed",true) pr.Enabled=false b.CanCollide=false
        boards=boards-1
        local final=b.CFrame*CFrame.new(0,-4,-2)*CFrame.Angles(0,0,0.7)
        for _,v in ipairs(b:GetDescendants()) do
            if v:IsA("BasePart") then
                local relative=b.CFrame:ToObjectSpace(v.CFrame)
                v.CanCollide=false v.CanQuery=false
                Tween:Create(v,TweenInfo.new(.55),{CFrame=final*relative,Transparency=1}):Play()
            end
        end
        Tween:Create(b,TweenInfo.new(0.55),{CFrame=b.CFrame*CFrame.new(0,-4,-2)*CFrame.Angles(0,0,0.7),Transparency=1}):Play()
        send(p,"Pry",true) message(p,"Tábua removida. Restam "..boards..".") syncAll() tryDoor()
    end)
end
local function install(p)
    local pg=p:WaitForChild("PlayerGui",15)
    if pg and not pg:FindFirstChild("Setor09Controller") then
        local holder=Instance.new("ScreenGui") holder.Name="Setor09Controller" holder.ResetOnSpawn=false
        kit.HorrorClient:Clone().Parent=holder holder.Parent=pg
    end
end
local function onChar(p,char)
    local h=char:WaitForChild("Humanoid",10)
    if h then h.MaxHealth=C.Health h.Health=C.Health h.WalkSpeed=C.WalkSpeed h.JumpPower=0 h.JumpHeight=0 end
    sync(p)
end
local function added(p)
    if state[p] then return end
    state[p]={key=false,crowbar=false,clue=false,escaped=false,scared=false,last=0,codeLast=0}
    p.CharacterAdded:Connect(function(char) onChar(p,char) end)
    if p.Character then task.spawn(onChar,p,p.Character) end
    task.spawn(install,p)
end
Players.PlayerAdded:Connect(added)
Players.PlayerRemoving:Connect(function(p) state[p]=nil end)
for _,p in ipairs(Players:GetPlayers()) do added(p) end
local function worldFlashlight(p,enabled)
    local char=p.Character local head=char and char:FindFirstChild("Head") if not head then return end
    local l=head:FindFirstChild("Setor09WorldLight")
    if not l then l=Instance.new("SpotLight") l.Name="Setor09WorldLight" l.Face=Enum.NormalId.Front l.Range=40 l.Angle=70 l.Brightness=2.4 l.Shadows=true l.Parent=head end
    l.Enabled=enabled
end
action.OnServerEvent:Connect(function(p,kind,data)
    local s=state[p] if not s or type(kind)~="string" then return end
    local now=os.clock() if now-s.last&lt;0.08 then return end s.last=now
    if kind=="Sync" then sync(p) return end
    local _,h=living(p) if not h then return end
    if kind=="Code" then
        if now-s.codeLast&lt;1 or not near(p,exit.Keypad) then return end s.codeLast=now
        if codeOpen then return end
        if type(data)~="string" or not data:match("^%d%d%d$") then return end
        if not s.clue then message(p,"Encontre e leia o bilhete antes de tentar a combinação.") return end
        if data~=code then send(p,"WrongCode",true) message(p,"Código incorreto.") return end
        codeOpen=true
        local display=exit:FindFirstChild("Display") if display then display.Color=Color3.fromRGB(83,218,134) end
        send(p,"ClosePanel",true) message(p,"Código aceito. Trava eletrônica liberada.") syncAll() tryDoor()
    elseif kind=="Sprint" then h.WalkSpeed=data==true and C.SprintSpeed or C.WalkSpeed
    elseif kind=="Light" then worldFlashlight(p,data==true) end
end)
local lighting=game:GetService("Lighting")
lighting.ClockTime=0 lighting.Brightness=0 lighting.Ambient=Color3.fromRGB(23,27,29)
lighting.OutdoorAmbient=Color3.fromRGB(8,10,13) lighting.EnvironmentDiffuseScale=0.35 lighting.EnvironmentSpecularScale=0.65
lighting.FogColor=Color3.fromRGB(9,13,15) lighting.FogStart=35 lighting.FogEnd=120
local color=Instance.new("ColorCorrectionEffect") color.Name="Setor09Grade" color.Brightness=0 color.Contrast=0.1 color.Saturation=-0.18 color.TintColor=Color3.fromRGB(230,239,228) color.Parent=lighting
local bloom=Instance.new("BloomEffect") bloom.Name="Setor09Bloom" bloom.Intensity=.12 bloom.Size=12 bloom.Threshold=1.7 bloom.Parent=lighting
local accumulator=0
-- Estado compartilhado das travas; inventario individual preservado ao reaparecer.
game:GetService("RunService").Heartbeat:Connect(function(dt)
    accumulator=accumulator+dt if accumulator&lt;0.35 then return end accumulator=0
    for p,s in pairs(state) do
        local _,_,root=living(p)
        if root then
            if not s.escaped and doorOpen and (root.Position-map.EscapeZone.Position).Magnitude&lt;7 then
                s.escaped=true sync(p) send(p,"Win",true)
            end
            if C.EnableScare and not s.scared and (root.Position-map.ScarePoint.Position).Magnitude&lt;9 then
                s.scared=true send(p,"Scare",map.ScarePoint.Position)
            end
        end
    end
end)
print("SETOR 09 pronto. F5 para jogar. F lanterna, E interagir, Shift correr.")
</ProtectedString>
    <bool name="Disabled">false</bool>
   </Properties>
  </Item>
  <Item class="LocalScript" referent="RBX5">
   <Properties>
    <string name="Name">HorrorClient</string>
    <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local Run=game:GetService("RunService")
local Input=game:GetService("UserInputService")
local Tween=game:GetService("TweenService")
local Debris=game:GetService("Debris")
local p=Players.LocalPlayer
local net=RS:WaitForChild("Setor09")
local C=require(net.Config) local V=require(net.Visuals)
local action=net.Action local event=net.Event
local kit=workspace:WaitForChild("Setor09_Kit") local map=kit:WaitForChild("Labirinto")
local s={key=false,crowbar=false,clue=false,boards=3,keyOpen=false,codeOpen=false}
local on=true local modal=false local busyUntil=0 local messageUntil=0 local codeInput=""
local CAS=game:GetService("ContextActionService")
CAS:BindActionAtPriority("Setor09ModalMovement",function()
    return modal and Enum.ContextActionResult.Sink or Enum.ContextActionResult.Pass
end,false,3000,Enum.KeyCode.W,Enum.KeyCode.A,Enum.KeyCode.S,Enum.KeyCode.D,Enum.KeyCode.Space,Enum.KeyCode.LeftShift)
local vm,parts,light,extraLights local focused=false local swayX,swayY=0,0 local scareUntil=0 local pryAt=-10
local gui=Instance.new("ScreenGui") gui.Name="Setor09HUD" gui.IgnoreGuiInset=true gui.ResetOnSpawn=false gui.Parent=p:WaitForChild("PlayerGui")
local ivory=Color3.fromRGB(218,219,195) local amber=Color3.fromRGB(195,151,74)
local function box(parent,size,pos,color,trans)
    local f=Instance.new("Frame") f.Size=size f.Position=pos f.BackgroundColor3=color or Color3.fromRGB(14,19,18)
    f.BackgroundTransparency=trans or 0 f.BorderSizePixel=0 f.Parent=parent return f
end
local function label(parent,value,size,pos,textSize,color)
    local l=Instance.new("TextLabel") l.Text=value l.Size=size l.Position=pos l.BackgroundTransparency=1
    l.Font=Enum.Font.Gotham l.TextSize=textSize or 16 l.TextColor3=color or ivory
    l.TextXAlignment=Enum.TextXAlignment.Left l.TextWrapped=true l.Parent=parent return l
end
local title=label(gui,"S E T O R   0 9   /   II",UDim2.fromOffset(280,35),UDim2.fromOffset(30,24),24)
label(gui,"ALA DE MANUTENÇÃO / SUBSOLO",UDim2.fromOffset(330,20),UDim2.fromOffset(30,61),11,amber)
local tasks=label(gui,"",UDim2.fromOffset(340,118),UDim2.fromOffset(30,100),14)
tasks.TextYAlignment=Enum.TextYAlignment.Top
local inventory=label(gui,"",UDim2.new(1,-60,0,32),UDim2.new(0,30,1,-85),14,amber)
label(gui,"WASD  MOVER      SHIFT  CORRER      F  LANTERNA      BOTÃO DIREITO  FOCAR      E  INTERAGIR      TAB  BILHETE",UDim2.new(1,-60,0,28),UDim2.new(0,30,1,-43),11)
local dot=box(gui,UDim2.fromOffset(3,3),UDim2.new(0.5,-1,0.5,-1),ivory,0.1)
local msg=label(gui,"Encontre uma forma de abrir a saída.",UDim2.new(0.7,0,0,65),UDim2.fromScale(0.15,0.73),18)
msg.TextXAlignment=Enum.TextXAlignment.Center messageUntil=os.clock()+7
local shade=box(gui,UDim2.fromScale(1,1),UDim2.fromScale(0,0),Color3.new(),1) shade.ZIndex=8
-- Bordas graduadas para uma vinheta leve, sem imagem externa.
for _,side in ipairs({"Top","Bottom","Left","Right"}) do
    local horizontal=side=="Top" or side=="Bottom"
    local b=box(gui,horizontal and UDim2.fromScale(1,0.12) or UDim2.fromScale(0.10,1),UDim2.fromScale(side=="Right" and 0.9 or 0,side=="Bottom" and 0.88 or 0),Color3.new(),0.35)
    local gr=Instance.new("UIGradient") gr.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.15),NumberSequenceKeypoint.new(1,1)})
    gr.Rotation=side=="Top" and 90 or (side=="Bottom" and -90 or (side=="Left" and 0 or 180)) gr.Parent=b
end
local overlay=box(gui,UDim2.fromScale(1,1),UDim2.fromScale(0,0),Color3.new(),0.28) overlay.ZIndex=20 overlay.Visible=false
local blocker=Instance.new("TextButton") blocker.Size=UDim2.fromScale(1,1) blocker.BackgroundTransparency=1 blocker.Text="" blocker.Modal=true blocker.ZIndex=20 blocker.Parent=overlay
local panel=box(overlay,UDim2.fromOffset(430,510),UDim2.new(0.5,-215,0.5,-255),Color3.fromRGB(20,26,24)) panel.ZIndex=21
local scale=Instance.new("UIScale") scale.Parent=panel
local heading=label(panel,"TRAVA / ACESSO",UDim2.new(1,-40,0,40),UDim2.fromOffset(20,18),23,amber) heading.ZIndex=22
local display=label(panel,"_ _ _",UDim2.new(1,-40,0,90),UDim2.fromOffset(20,65),42) display.TextXAlignment=Enum.TextXAlignment.Center display.ZIndex=22
local note=label(panel,"",UDim2.new(1,-56,0,270),UDim2.fromOffset(28,90),22) note.TextSize=19 note.Size=UDim2.new(1,-56,0,310) note.TextYAlignment=Enum.TextYAlignment.Top note.ZIndex=22 note.Visible=false
local buttons={}
local function button(value,x,y,callback)
    local b=Instance.new("TextButton") b.Size=UDim2.fromOffset(106,54) b.Position=UDim2.fromOffset(x,y)
    b.BackgroundColor3=Color3.fromRGB(39,46,41) b.BorderSizePixel=0 b.Text=value b.Font=Enum.Font.GothamBold b.TextSize=22 b.TextColor3=ivory b.ZIndex=22 b.Parent=panel
    b.Activated:Connect(callback) table.insert(buttons,b) return b
end
local function refreshDisplay() display.Text=codeInput..string.rep("_",3-#codeInput) end
local function enterDigit(d) if #codeInput&lt;3 then codeInput=codeInput..d refreshDisplay() end end
for i=1,9 do local d=tostring(i) button(d,41+((i-1)%3)*121,171+math.floor((i-1)/3)*64,function() enterDigit(d) end) end
button("LIMPAR",41,363,function() codeInput="" refreshDisplay() end).TextSize=14
button("0",162,363,function() enterDigit("0") end)
button("OK",283,363,function() if #codeInput==3 then action:FireServer("Code",codeInput) end end)
local function close() modal=false overlay.Visible=false end
local closeButton=button("FECHAR",41,440,close) closeButton.Size=UDim2.fromOffset(348,44) closeButton.TextSize=14
local interaction=box(gui,UDim2.fromOffset(360,64),UDim2.new(.5,-180,.64,0),Color3.fromRGB(13,20,18),.12)
interaction.Visible=false
local interactionLabel=label(interaction,"",UDim2.new(1,-28,0,38),UDim2.fromOffset(14,4),14)
interactionLabel.TextXAlignment=Enum.TextXAlignment.Center
local track=box(interaction,UDim2.new(1,-28,0,3),UDim2.fromOffset(14,49),Color3.fromRGB(45,56,48))
local fill=box(track,UDim2.fromScale(0,1),UDim2.fromScale(0,0),amber)
local currentPrompt=nil local holdStarted=nil
local introSeen=false
local fixtureLights={}
for _,v in ipairs(map.Fixtures:GetDescendants()) do
    if v:IsA("PointLight") and v.Parent.Name=="LampLens" then
        table.insert(fixtureLights,{light=v,brightness=v.Brightness,phase=#fixtureLights*1.71})
    end
end
local PPS=game:GetService("ProximityPromptService")
PPS.PromptShown:Connect(function(pr)
    currentPrompt=pr holdStarted=nil interaction.Visible=not modal
    interactionLabel.Text="[ E ]  "..pr.ActionText.."  /  "..pr.ObjectText
end)
PPS.PromptHidden:Connect(function(pr) if currentPrompt==pr then currentPrompt=nil holdStarted=nil interaction.Visible=false end end)
PPS.PromptButtonHoldBegan:Connect(function(pr) if pr==currentPrompt then holdStarted=os.clock() end end)
PPS.PromptButtonHoldEnded:Connect(function(pr) if pr==currentPrompt then holdStarted=nil end end)
local panelMode=""
local function open(mode)
    modal=true panelMode=mode overlay.Visible=true codeInput="" refreshDisplay()
    for _,b in ipairs(buttons) do b.Visible=mode=="Keypad" or b==closeButton end
    display.Visible=mode=="Keypad" note.Visible=mode~="Keypad"
    heading.Text=mode=="Keypad" and "TRAVA / 3 DÍGITOS" or (mode=="Win" and "VOCÊ SAIU" or (mode=="Intro" and "SETOR 09 / SUBSOLO" or "REGISTRO / 09"))
    closeButton.Text=mode=="Intro" and "ENTRAR NO SETOR" or "FECHAR"
    focused=false
    action:FireServer("Sprint",false)
    if mode=="Note" then
        note.Text="Se alguém encontrar isto:\n\nA combinação do portão é\n\n"..(s.code or "???").."\n\nA chave e a ferramenta ficaram em outros corredores. Não fique aqui."
    elseif mode=="Intro" then note.Text="A manutenção abandonou este lugar.\n\nO portão ainda tem três travas.\n\nAche o registro, a chave de serviço e uma ferramenta para as tábuas.\n\nF: lanterna   /   E: interagir\nBotão direito: concentrar o feixe"
    elseif mode=="Win" then note.Text="As três travas cederam.\n\nVocê escapou do Setor 09.\n\nMas o que estava lá embaixo continua lá."
    end
end
local function audio(id,loop)
    if not id or id=="" then return end
    local a=Instance.new("Sound") a.SoundId=id a.Volume=0.35 a.Looped=loop or false a.Parent=game:GetService("SoundService") a:Play()
    if not loop then Debris:AddItem(a,6) end
end
local function build()
    if vm then vm:Destroy() end
    vm,parts,light,extraLights=V.Flashlight(workspace.CurrentCamera)
    light.Range=C.FlashlightRange light.Angle=C.FlashlightAngle light.Brightness=C.FlashlightBrightness light.Enabled=on
    extraLights[1].Range=C.FlashlightSpillRange extraLights[1].Angle=C.FlashlightSpillAngle extraLights[1].Brightness=C.FlashlightSpillBrightness
end
local function toggle()
    on=not on if light then light.Enabled=on end action:FireServer("Light",on) audio(C.FlashlightSound)
end
local function hidePickup(name)
    local m=map:FindFirstChild(name) if not m then return end
    for _,v in ipairs(m:GetDescendants()) do
        if v:IsA("BasePart") and not v.Name:match("^Table") and not v.Name:match("^Bench") then v.LocalTransparencyModifier=1 end
        if v:IsA("ProximityPrompt") then v.Enabled=false end
    end
end
event.OnClientEvent:Connect(function(kind,data)
    if kind=="State" then s=data if s.key then hidePickup("Key") end if s.crowbar then hidePickup("Crowbar") end
    elseif kind=="Message" then msg.Text=data messageUntil=os.clock()+4
    elseif kind=="Pickup" then hidePickup(data) audio(C.PickupSound)
    elseif kind=="Note" then s.code=data open("Note")
    elseif kind=="Keypad" then open("Keypad")
    elseif kind=="ClosePanel" then close()
    elseif kind=="WrongCode" then codeInput="" refreshDisplay() display.TextColor3=Color3.fromRGB(222,92,76) task.delay(0.5,function() display.TextColor3=ivory end)
    elseif kind=="DoorOpened" then audio(C.DoorSound)
    elseif kind=="Pry" then pryAt=os.clock() audio(C.PrySound)
    elseif kind=="Win" then open("Win")
    elseif kind=="Scare" then
        scareUntil=os.clock()+1.15 audio(C.ScareSound)
        msg.Text="... você ouviu isso?" messageUntil=os.clock()+4
    end
end)
Input.InputBegan:Connect(function(i,processed)
    if processed then return end
    if modal then
        if i.KeyCode==Enum.KeyCode.Escape or i.KeyCode==Enum.KeyCode.Tab then close() return end
        if panelMode=="Keypad" then
            local names={Zero="0",One="1",Two="2",Three="3",Four="4",Five="5",Six="6",Seven="7",Eight="8",Nine="9",KeypadZero="0",KeypadOne="1",KeypadTwo="2",KeypadThree="3",KeypadFour="4",KeypadFive="5",KeypadSix="6",KeypadSeven="7",KeypadEight="8",KeypadNine="9"}
            if names[i.KeyCode.Name] then enterDigit(names[i.KeyCode.Name]) end
            if i.KeyCode==Enum.KeyCode.Backspace then codeInput=codeInput:sub(1,-2) refreshDisplay() end
            if i.KeyCode==Enum.KeyCode.Return and #codeInput==3 then action:FireServer("Code",codeInput) end
        end
        return
    end
    if i.UserInputType==Enum.UserInputType.MouseButton2 then focused=true
    elseif i.KeyCode==Enum.KeyCode.F then toggle()
    elseif i.KeyCode==Enum.KeyCode.Tab and s.clue then open("Note")
    elseif i.KeyCode==Enum.KeyCode.LeftShift then action:FireServer("Sprint",true) end
end)
Input.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton2 then focused=false end if i.KeyCode==Enum.KeyCode.LeftShift then action:FireServer("Sprint",false) end end)
Input.WindowFocusReleased:Connect(function() focused=false action:FireServer("Sprint",false) end)
local function character(char)
    close() p.CameraMode=Enum.CameraMode.LockFirstPerson
    local h=char:WaitForChild("Humanoid",10)
    if h then workspace.CurrentCamera.CameraSubject=h end
    task.wait(0.3) action:FireServer("Sync") task.wait(0.12) action:FireServer("Light",on)
    if not introSeen then introSeen=true open("Intro") end
end
p.CharacterAdded:Connect(character)
if p.Character then task.spawn(character,p.Character) end
p.CameraMode=Enum.CameraMode.LockFirstPerson
build() audio(C.AmbientSound,true)
action:FireServer("Sync")
-- O feixe segue a camera; braco e lanterna oscilam de forma sutil.
Run:BindToRenderStep("Setor09",Enum.RenderPriority.Camera.Value+3,function(dt)
    dt=math.min(dt,0.05)
    local cam=workspace.CurrentCamera if not cam then return end
    if not vm or vm.Parent~=cam then build() end
    local char=p.Character local h=char and char:FindFirstChildOfClass("Humanoid")
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local alive=h~=nil and h.Health&gt;0
    Input.MouseBehavior=(modal or not alive) and Enum.MouseBehavior.Default or Enum.MouseBehavior.LockCenter
    Input.MouseIconEnabled=modal or not alive dot.Visible=not modal and alive
    local moving=root and Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude or 0
    local now=os.clock() local md=Input:GetMouseDelta() local a=1-math.exp(-dt*9)
    swayX=swayX+(math.clamp(md.X,-20,20)*0.0015*(C.CameraSway or 1)-swayX)*a
    swayY=swayY+(math.clamp(md.Y,-20,20)*0.0015*(C.CameraSway or 1)-swayY)*a
    local bob=math.sin(now*7)*0.025*(C.CameraBob or 1)*math.min(1,moving/11)*(focused and .3 or 1)
    local pry=math.max(0,1-(now-pryAt)/0.7)
    local cf=cam.CFrame*CFrame.new(focused and .38 or .46,-0.40+bob,focused and -.90 or -.75)*CFrame.Angles(-swayY,-swayX,math.rad(pry*18))
    if modal or not alive then cf=cf*CFrame.new(0,-100,0) end
    V.Pose(parts,cf)
    -- Luz nasce junto a camera para nao atravessar a parede com a ponta do modelo.
    local emitter=light.Parent
    emitter.CFrame=cam.CFrame*CFrame.new(0,-.04,-.14)
    local scare=now&lt;scareUntil
    light.Enabled=on and alive and not modal and not (scare and math.floor(now*9)%2==0)
    for _,l in ipairs(extraLights or {}) do l.Enabled=light.Enabled end
    light.Brightness=focused and 10 or C.FlashlightBrightness
    light.Angle=focused and 30 or C.FlashlightAngle
    if extraLights then extraLights[1].Brightness=focused and .8 or C.FlashlightSpillBrightness end
    -- Evita uma segunda luz local emitida pela cabeca.
    local head=char and char:FindFirstChild("Head") local worldLight=head and head:FindFirstChild("Setor09WorldLight")
    if worldLight then worldLight.Enabled=false end
    shade.BackgroundTransparency=scare and 0.30 or 1
    for _,v in ipairs(fixtureLights) do
        v.light.Brightness=v.brightness*(scare and .35 or (.94+.06*math.sin(now*3.8+v.phase)))
    end
    local wantedFov=focused and 67 or ((moving&gt;12 and not modal) and 74 or 70)
    cam.FieldOfView=cam.FieldOfView+(wantedFov-cam.FieldOfView)*a
    local function check(v) return v and "[OK] " or "[  ] " end
    tasks.Text=check(s.clue).."Encontrar código de 3 números\n"..check(s.codeOpen).."Liberar teclado\n"..check(s.keyOpen).."Destrancar com a chave\n"..check(s.boards==0).."Remover tábuas ("..(3-(s.boards or 3)).."/3)"
    if s.doorOpen then tasks.Text="[OK] SISTEMAS LIBERADOS\nATRAVESSE A SAÍDA" end
    inventory.Text="LANTERNA "..(on and (focused and "FOCO" or "LIGADA") or "DESLIGADA").."    |    CHAVE "..(s.key and "SIM" or "—").."    |    PÉ DE CABRA "..(s.crowbar and "SIM" or "—")
    msg.Visible=now&lt;messageUntil and not modal
    interaction.Visible=currentPrompt~=nil and not modal and alive
    local fraction=holdStarted and currentPrompt and math.clamp((now-holdStarted)/math.max(.01,currentPrompt.HoldDuration),0,1) or 0
    fill.Size=UDim2.fromScale(fraction,1)
    if currentPrompt and not alive then currentPrompt=nil end
    scale.Scale=math.min(1,(cam.ViewportSize.X-30)/430,(cam.ViewportSize.Y-30)/510)
    panel.Position=UDim2.new(0.5,-215*scale.Scale,0.5,-255*scale.Scale)
end)
